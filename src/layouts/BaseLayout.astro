---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'profile' | 'article';
  publishedTime?: string;
  noindex?: boolean;
}

// Square, 460px. Fine as a fallback, wrong for a 1.91:1 banner slot.
const DEFAULT_IMAGE = 'https://avatars.githubusercontent.com/u/17067044?v=4';

const {
  title,
  description,
  image = DEFAULT_IMAGE,
  imageAlt,
  type = 'website',
  publishedTime,
  noindex = false,
} = Astro.props;

/* Every page claimed summary_large_image, including the ones falling back to
   the avatar, which puts a small square portrait in a slot built for a wide
   banner. Twitter and Slack letterbox or crop it and the result looks broken.
   The card type follows the image instead. Anything passed explicitly is one
   of the lab OG screenshots, which are 1200x630 by convention. */
const hasWideCard = image !== DEFAULT_IMAGE;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<meta name="author" content="Zeeshan Anjum Junaidi">
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'}>
<link rel="canonical" href={canonicalURL}>

<link rel="icon" type="image/svg+xml" href="/favicon.svg">

<meta name="theme-color" content="#0c0908" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#eae6dc" media="(prefers-color-scheme: light)">

<meta property="og:type" content={type}>
<meta property="og:site_name" content="Zeeshan Anjum Junaidi">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonicalURL}>
<meta property="og:image" content={image}>
{hasWideCard && <meta property="og:image:width" content="1200">}
{hasWideCard && <meta property="og:image:height" content="630">}
{imageAlt && <meta property="og:image:alt" content={imageAlt}>}
<meta property="og:locale" content="en_US">
{publishedTime && <meta property="article:published_time" content={publishedTime}>}
{type === 'article' && <meta property="article:author" content="Zeeshan Anjum Junaidi">}

<meta name="twitter:card" content={hasWideCard ? 'summary_large_image' : 'summary'}>
<meta name="twitter:title" content={title}>
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={image}>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=Spectral:ital,wght@0,300;0,400;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&family=Pinyon+Script&display=swap" rel="stylesheet">

<script is:inline>
(function () {
  try {
    var stored = localStorage.getItem("theme");
    var theme = stored || (window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark");
    document.documentElement.setAttribute("data-theme", theme);
  } catch (e) {}
})();
</script>
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-LPHSGGX5GG"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-LPHSGGX5GG');
</script>
</head>
<body>
<div class="wrap">
  <slot />
</div>

<script>
  import "../scripts/main.js";
</script>
</body>
</html>
