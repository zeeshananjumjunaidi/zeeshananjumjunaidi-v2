---
import { existsSync } from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { interactiveWriting } from '../../data/writing';
import TsiolkovskyEquation from '../../components/writing/TsiolkovskyEquation.astro';
import OutboxPattern from '../../components/writing/OutboxPattern.astro';
import LandingABooster from '../../components/writing/LandingABooster.astro';

const ARTICLE_COMPONENTS: Record<string, any> = {
  'tsiolkovsky-rocket-equation': TsiolkovskyEquation,
  'transactional-outbox': OutboxPattern,
  'landing-a-booster': LandingABooster,
};

export function getStaticPaths() {
  return interactiveWriting
    // `href` entries are pieces that already live elsewhere on the site, so
    // there is no component to render and no page to build for them.
    .filter((a) => !a.draft && !a.href)
    .map((a) => ({ params: { slug: a.slug }, props: { meta: a } }));
}

const { meta } = Astro.props;
const ArticleComponent = ARTICLE_COMPONENTS[Astro.params.slug as string];

const published = meta.publishDate
  ? meta.publishDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })
  : null;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: meta.title,
  description: meta.description,
  datePublished: meta.publishDate ? meta.publishDate.toISOString() : undefined,
  author: { '@type': 'Person', name: 'Zeeshan Anjum Junaidi', url: 'https://zeeshananjum.com' },
  keywords: meta.topics.join(', '),
};

// Same filesystem lookup the lab route uses: an article with a card in
// public/writing gets a wide preview, one without falls back to the avatar
// and a small card. Nothing to register when the next article lands.
const slug = Astro.params.slug as string;
const ogImageURL = existsSync(new URL(`../../../public/writing/${slug}-og.png`, import.meta.url))
  ? new URL(`/writing/${slug}-og.png`, Astro.site).toString()
  : undefined;
---
<BaseLayout
  title={`${meta.title} - Zeeshan Anjum Junaidi`}
  description={meta.metaDescription || meta.description}
  type="article"
  image={ogImageURL}
  imageAlt={ogImageURL ? `Figure from "${meta.title}"` : undefined}
  publishedTime={meta.publishDate ? meta.publishDate.toISOString() : undefined}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
  <div class:list={['writing-page', { wide: meta.wide }]}>
    <Nav />

    <a class="back-link" href="/#writing">&larr; Back to writing</a>

    <header class="writing-head">
      <h1>{meta.title}</h1>
      <p class="writing-standfirst">{meta.description}</p>
      {(published || meta.topics.length > 0) && (
        <div class="writing-meta">
          {published && <span class="writing-date">{published}</span>}
          {meta.topics.length > 0 && (
            <div class="tag-row">
              {meta.topics.map((topic: string) => <span class="tag">{topic}</span>)}
            </div>
          )}
        </div>
      )}
    </header>

    <article class:list={meta.wide ? 'writing-self' : 'writing-block writing-prose'}>
      {ArticleComponent && <ArticleComponent />}
    </article>
  </div>

  <SiteFooter />
</BaseLayout>

<style>
  /* --measure is px-based, not ch: the masthead and the body use different
     fonts, and ch would put their left edges in different places. */
  .writing-page { --measure: 34rem; padding: 28px 4px 0; max-width: 880px; margin: 0 auto; }
  /* An article that lays itself out gets the room to do it, and its masthead
     widens to match rather than staying pinned to the reading measure. */
  .writing-page.wide { max-width: 1100px; --measure: 46rem; }
  .writing-self { margin-bottom: 72px; }
  .back-link {
    font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--card-desc); transition: color .4s ease;
    display: block; max-width: var(--measure); margin: 24px auto 8px;
  }
  .back-link:hover, .back-link:focus-visible { color: var(--card-label); }

  .writing-head {
    max-width: var(--measure); margin: 18px auto 30px;
    padding-bottom: 24px; border-bottom: 1px solid var(--card-border);
  }
  .writing-head h1 {
    font-family: var(--font-head); font-weight: 400; font-size: clamp(28px, 7vw, 38px); line-height: 1.15;
    color: var(--headline-color); margin: 0 0 14px; text-wrap: balance; max-width: 20ch;
  }
  .writing-standfirst {
    font-family: var(--font-body); font-weight: 300; font-size: 17.5px; line-height: 1.7;
    color: var(--subhead-color); margin: 0 0 18px; max-width: 62ch;
  }
  .writing-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .writing-date {
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--section-meta);
  }

  .writing-prose { margin-bottom: 72px; }
</style>
