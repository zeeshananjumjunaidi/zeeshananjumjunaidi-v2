---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import WorkSection from '../components/WorkSection.astro';
import LabSection from '../components/LabSection.astro';
import WritingSection from '../components/WritingSection.astro';
import SiteFooter from '../components/SiteFooter.astro';

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Zeeshan Anjum Junaidi',
  url: 'https://zeeshananjum.com',
  image: 'https://avatars.githubusercontent.com/u/17067044?v=4',
  jobTitle: 'Senior Software Engineer',
  worksFor: {
    '@type': 'Organization',
    name: 'IDWise',
  },
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Karachi',
    addressCountry: 'PK',
  },
  sameAs: [
    'https://github.com/zeeshananjumjunaidi',
    'https://www.linkedin.com/in/zeeshananjum/',
  ],
};
---
<BaseLayout
  title="Zeeshan Anjum Junaidi | Senior Software Engineer"
  description="I'm a senior software engineer in Karachi, working remotely for IDWise on infrastructure and platform engineering."
  type="profile"
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(personSchema)} />
  <div class="plate">
    <span class="ember one"></span>
    <span class="ember two"></span>

    <div class="panel">
      <Nav />
      <Hero />
      <WorkSection />
      <LabSection />
    </div>
  </div>

  <WritingSection />
  <SiteFooter />
</BaseLayout>
