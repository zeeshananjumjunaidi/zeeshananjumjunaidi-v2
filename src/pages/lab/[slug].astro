---
import { existsSync } from 'node:fs';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SlamPlaygroundSim from '../../components/labs/SlamPlaygroundSim.astro';
import HybridAstarParkingSim from '../../components/labs/HybridAstarParkingSim.astro';
import BackOfTheEnvelopeCalc from '../../components/labs/BackOfTheEnvelopeCalc.astro';
import { labs } from '../../data/labs';
import RocketLandingSim from '../../components/labs/physics/RocketLandingSim.astro';

const SIM_COMPONENTS: Record<string, any> = {
  'slam-playground': SlamPlaygroundSim,
  'hybrid-astar-parking': HybridAstarParkingSim,
  'back-of-the-envelope': BackOfTheEnvelopeCalc,
  'rocket-landing': RocketLandingSim,  // <- new

};

export function getStaticPaths() {
  return labs.map((lab) => ({ params: { slug: lab.slug }, props: { lab } }));
}

const { lab } = Astro.props;
const SimComponent = SIM_COMPONENTS[lab.slug];

const pageURL = new URL(`/lab/${lab.slug}`, Astro.site).toString();
// Checked against the filesystem rather than assumed: rocket-landing shipped
// without one and the page advertised an og:image that 404s, so every share
// of it rendered with a broken preview. Labs added later get picked up the
// moment their PNG lands in public/lab, with no list here to keep in sync.
const ogFile = new URL(`../../../public/lab/${lab.slug}-og.png`, import.meta.url);
const ogImageURL = existsSync(ogFile)
  ? new URL(`/lab/${lab.slug}-og.png`, Astro.site).toString()
  : undefined;

const toolSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: lab.title,
  description: lab.metaDescription || lab.tagline,
  url: pageURL,
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Any (runs in the browser)',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Zeeshan Anjum Junaidi', url: 'https://zeeshananjum.com' },
  keywords: lab.tags.join(', '),
};
---
<BaseLayout title={`${lab.title} - Zeeshan Anjum Junaidi`} description={lab.metaDescription || lab.tagline} image={ogImageURL} imageAlt={ogImageURL ? `Screenshot of the ${lab.title} tool` : undefined}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(toolSchema)} />
  <div class="lab-page">
    <Nav />

    <a class="back-link" href="/#lab">← Back to The Lab</a>

    <div class="lab-page-head">
      <h1 class="section-label">{lab.title}</h1>
      <p class="subhead" style="max-width:60ch;">{lab.tagline}</p>
      <div class="tag-row">
        {lab.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>

    {lab.collapsibleWriteup ? (
      <details class="writing-collapse" style="margin-top:24px;">
        <summary>About this tool</summary>
        <div class="writing-block">
          {lab.writeup.map((para) => <p set:html={para} />)}
        </div>
      </details>
    ) : (
      <div class="writing-block" style="margin-top:24px;">
        {lab.writeup.map((para) => <p set:html={para} />)}
      </div>
    )}

    <div class="sim-frame">
      {SimComponent && <SimComponent />}
    </div>
  </div>

  <SiteFooter />
</BaseLayout>

<style>
  .lab-page { padding: 28px 4px 0; }
  .back-link {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--card-desc);
    transition: color .4s ease;
    display: inline-block;
    margin: 24px 0 8px;
  }
  .back-link:hover, .back-link:focus-visible { color: var(--card-label); }
  .lab-page-head { display: flex; flex-direction: column; gap: 14px; margin-bottom: 8px; }
  /* The lab title is the page's h1, not decoration: these pages had no h1 at
     all, so their outline started at the sim's own h2. .section-label carries
     the whole look, so this only has to undo the UA heading defaults. */
  h1.section-label { margin: 0; font-weight: 400; }

  .writing-collapse summary {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--card-desc);
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color .3s ease;
  }
  .writing-collapse summary::-webkit-details-marker { display: none; }
  .writing-collapse summary::before {
    content: "+";
    display: inline-block;
    width: 1em;
    text-align: center;
  }
  .writing-collapse[open] summary::before { content: "−"; }
  .writing-collapse summary:hover { color: var(--card-label); }
  .writing-collapse .writing-block { margin-top: 14px; }

  .sim-frame { margin: 32px 0 64px; }
</style>
