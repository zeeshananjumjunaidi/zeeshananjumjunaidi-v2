---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SlamPlaygroundSim from '../../components/labs/SlamPlaygroundSim.astro';
import HybridAstarParkingSim from '../../components/labs/HybridAstarParkingSim.astro';
import BackOfTheEnvelopeCalc from '../../components/labs/BackOfTheEnvelopeCalc.astro';
import { labs } from '../../data/labs';

const SIM_COMPONENTS: Record<string, any> = {
  'slam-playground': SlamPlaygroundSim,
  'hybrid-astar-parking': HybridAstarParkingSim,
  'back-of-the-envelope': BackOfTheEnvelopeCalc,
};

export function getStaticPaths() {
  return labs.map((lab) => ({ params: { slug: lab.slug }, props: { lab } }));
}

const { lab } = Astro.props;
const SimComponent = SIM_COMPONENTS[lab.slug];
---
<BaseLayout title={`${lab.title} - Zeeshan Anjum Junaidi`} description={lab.tagline}>
  <div class="lab-page">
    <Nav />

    <a class="back-link" href="/#lab">← Back to The Lab</a>

    <div class="lab-page-head">
      <span class="section-label">{lab.title}</span>
      <p class="subhead" style="max-width:60ch;">{lab.tagline}</p>
      <div class="tag-row">
        {lab.tags.map((tag) => <span class="tag">{tag}</span>)}
      </div>
    </div>

    {lab.collapsibleWriteup ? (
      <details class="writing-collapse" style="margin-top:24px;">
        <summary>About this tool</summary>
        <div class="writing-block">
          {lab.writeup.map((para) => <p set:html={para} />)}
        </div>
      </details>
    ) : (
      <div class="writing-block" style="margin-top:24px;">
        {lab.writeup.map((para) => <p set:html={para} />)}
      </div>
    )}

    <div class="sim-frame">
      {SimComponent && <SimComponent />}
    </div>
  </div>

  <SiteFooter />
</BaseLayout>

<style>
  .lab-page { padding: 28px 4px 0; }
  .back-link {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--card-desc);
    transition: color .4s ease;
    display: inline-block;
    margin: 24px 0 8px;
  }
  .back-link:hover, .back-link:focus-visible { color: var(--card-label); }
  .lab-page-head { display: flex; flex-direction: column; gap: 14px; margin-bottom: 8px; }

  .writing-collapse summary {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--card-desc);
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: color .3s ease;
  }
  .writing-collapse summary::-webkit-details-marker { display: none; }
  .writing-collapse summary::before {
    content: "+";
    display: inline-block;
    width: 1em;
    text-align: center;
  }
  .writing-collapse[open] summary::before { content: "−"; }
  .writing-collapse summary:hover { color: var(--card-label); }
  .writing-collapse .writing-block { margin-top: 14px; }

  .sim-frame { margin: 32px 0 64px; }
</style>
