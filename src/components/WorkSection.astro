---
import { experience } from '../data/experience';
import { certifications } from '../data/certifications';
---
<section id="work" aria-labelledby="work-label">
  <div class="section-label-row">
    <span class="section-label" id="work-label">Work</span>
    <span class="section-meta">IDWISE · SINCE 2022</span>
    <span class="line"></span>
  </div>
  <p class="subhead" style="max-width:64ch; margin-bottom:18px;">My day-to-day there is mostly Kubernetes, cloud infrastructure, CI/CD, and firewalls across AWS, GCP, and Terraform, for the identity verification and anti-money-laundering side of the business. I've also done ISO 27001 internal auditing.</p>
  <div class="tag-row" role="list" aria-label="Career timeline">
    {experience.map((entry) => (
      <span class="tag" role="listitem">{entry.role} · {entry.org} · {entry.dates}</span>
    ))}
  </div>

  <div class="repo-list-header" style="margin-top:22px;">
    <span class="section-meta">CERTIFICATIONS</span>
  </div>
  <div class="tag-row" role="list" aria-label="Certifications">
    {certifications.map((cert) => (
      <span class="tag" role="listitem">{cert.name} · {cert.issuer} · {cert.year}</span>
    ))}
  </div>
</section>
