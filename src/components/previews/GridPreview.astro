---
// Same 7x5 pathfinder-style grid as the original static page: a fixed set of
// "wall" cells and per-cell animation delays so the scan/visit animation
// sweeps the grid in a stable, non-random pattern.
const wallIndexes = new Set([3, 7, 10, 12, 18, 21]);
const delays = [
  0, 0.18, 0.36, null, 1.5, 1.68, 1.86, null, 0.54, 0.72, null, 1.32, null,
  2.04, 2.4, 0.9, 1.08, 1.2, null, 2.22, 2.58, null, 3.1, 3.3, 3.5, 3.7, 3.9,
  4.1, 4.3, 4.5, 4.7, 4.9, 5.1, 5.3, 5.5,
];
const cells = delays.map((delay, i) => ({
  wall: wallIndexes.has(i),
  delay,
}));
---
<div class="ruled-bg"></div>
<div class="scan-line"></div>
<div class="preview-grid">
  {cells.map((cell) => (
    cell.wall
      ? <span class="cell wall"></span>
      : <span class="cell visit" style={`animation-delay:${cell.delay}s`}></span>
  ))}
</div>
