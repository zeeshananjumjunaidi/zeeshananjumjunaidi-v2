---
// Ported from a standalone React/Tailwind prototype (back-of-the-envelope.jsx).
// This project doesn't use React or Tailwind, so the port is a rewrite onto
// plain Astro markup + vanilla JS + this site's own CSS tokens, following the
// same "retheme the chrome, keep the math untouched" approach used for the
// SLAM and Hybrid A* Parking sims. Traffic and Diagram are the two tabs built
// so far. The source calculator has 13 sections total (Storage, Bandwidth,
// Cache, Compute, Database, Queue, Latency, Availability, Cost, Toolbox,
// Cheat sheet, Summary); more get added a couple at a time as their own tabs.
// The Diagram tab is a small original addition, not from the source file: a
// vanilla-JS canvas for sketching an architecture (drag boxes, connect them,
// label, pan/zoom), autosaved to localStorage with a JSON export. No preset
// scenarios anywhere in this tool, by request.
---

<div class="boe-root">
  <div class="boe-head">
    <div>
      <p class="boe-blurb">Capacity math for system design. Change one assumption and watch it move through the numbers below.</p>
    </div>
    <button type="button" id="boeReset" class="boe-reset">Reset</button>
  </div>

  <div class="boe-tabs">
    <button type="button" class="boe-tabbtn active" data-tab="traffic">Traffic</button>
    <button type="button" class="boe-tabbtn" data-tab="diagram">Diagram</button>
  </div>

  <div class="boe-tab" data-tab="traffic">
    <div class="boe-grid">
      <div>
        <div class="boe-panel">
          <h3 class="boe-panel-title">Inputs</h3>
          <label class="boe-field">
            <span class="boe-label">Daily active users<span class="boe-unit">DAU</span></span>
            <input class="boe-inp" type="number" min="0" step="any" id="dau" value="10000000">
            <span class="boe-hint">People who hit the system in a day.</span>
          </label>
          <label class="boe-field">
            <span class="boe-label">Requests per user per day<span class="boe-unit">req</span></span>
            <input class="boe-inp" type="number" min="0" step="any" id="rpu" value="20">
            <span class="boe-hint">Count API calls, not screens.</span>
          </label>
          <label class="boe-field">
            <span class="boe-label-row">
              <span class="boe-label-text">Peak-to-average factor</span>
              <span class="boe-slide-val"><span id="peakVal">3</span>×</span>
            </span>
            <input class="boe-range" type="range" min="1" max="20" step="0.5" id="peak" value="3">
            <span class="boe-hint">Traffic is never flat. 2–4× for global apps, 10×+ for sales and live events.</span>
          </label>
          <label class="boe-field">
            <span class="boe-label">Reads per write<span class="boe-unit">: 1</span></span>
            <input class="boe-inp" type="number" min="0" step="any" id="rw" value="100">
            <span class="boe-hint">100 means 100 reads for every write.</span>
          </label>
        </div>

        <div class="boe-learn">
          <div class="boe-learn-label">Why it works</div>
          <p>Everything downstream hangs off peak RPS, so get it first. The only constant you need is <strong>86,400 seconds in a day</strong>, round it to 100,000 and your numbers land within 15%, which is well inside the error bars of every other guess you are making.</p>
          <p>Size for <strong>peak</strong>, not average. A system sized for the mean is down every evening.</p>
        </div>
      </div>

      <div>
        <div class="boe-panel">
          <h3 class="boe-panel-title">Derived load</h3>
          <div class="boe-out boe-out-big">
            <div class="boe-out-row"><span>Peak requests per second</span><span class="boe-out-val" id="out-peakRps">—<span class="boe-out-unit">RPS</span></span></div>
            <div class="boe-formula">peak = DAU × req/user ÷ 86,400 × peak factor</div>
          </div>
          <div class="boe-out">
            <div class="boe-out-row"><span>Average RPS</span><span class="boe-out-val" id="out-rps">—<span class="boe-out-unit">RPS</span></span></div>
            <div class="boe-formula">DAU × req/user ÷ 86,400</div>
          </div>
          <div class="boe-out">
            <div class="boe-out-row"><span>Requests per day</span><span class="boe-out-val" id="out-reqDay">—</span></div>
            <div class="boe-formula">DAU × req/user</div>
          </div>
          <div class="boe-out">
            <div class="boe-out-row"><span>Requests per month</span><span class="boe-out-val" id="out-reqMonth">—</span></div>
            <div class="boe-formula">× 30</div>
          </div>
        </div>

        <div class="boe-panel">
          <h3 class="boe-panel-title">Read / write split</h3>
          <div class="boe-out">
            <div class="boe-out-row"><span>Peak read RPS</span><span class="boe-out-val" id="out-peakReadRps">—<span class="boe-out-unit">RPS</span></span></div>
            <div class="boe-formula" id="out-rShare">—</div>
          </div>
          <div class="boe-out">
            <div class="boe-out-row"><span>Peak write RPS</span><span class="boe-out-val" id="out-peakWriteRps">—<span class="boe-out-unit">RPS</span></span></div>
            <div class="boe-formula" id="out-wShare">—</div>
          </div>
          <div class="boe-out">
            <div class="boe-out-row"><span>Writes per day</span><span class="boe-out-val" id="out-writesDay">—</span></div>
            <div class="boe-sub">Feeds the storage tab, once it's built</div>
          </div>
          <div class="boe-out">
            <div class="boe-out-row"><span>Reads per day</span><span class="boe-out-val" id="out-readsDay">—</span></div>
          </div>
        </div>

        <div class="boe-flag" id="flag-scale">
          Above ~100k RPS you are past what a single region and a single primary database will do comfortably. Expect sharding, regional partitioning and an edge tier in your design.
        </div>
        <div class="boe-flag boe-flag-ok" id="flag-readheavy">
          Read-heavy. This is a caching and read-replica problem. Writes are almost a rounding error, so spend your design budget on the read path.
        </div>
        <div class="boe-flag" id="flag-writeheavy">
          Write-heavy. Caching will not save you. Look at LSM-tree stores, batching, and a log in front of the database.
        </div>
      </div>
    </div>
  </div>

  <div class="boe-tab" data-tab="diagram" hidden>
    <div class="dg-root">
      <div class="dg-toolbar">
        <div class="dg-chip" id="dgAddBox" draggable="true" title="Drag onto the canvas, or click to add">+ Box</div>
        <div class="dg-chip" id="dgAddContainer" draggable="true" title="Drag onto the canvas, or click to add">+ Container</div>
        <div class="dg-tool-group">
          <button type="button" class="dg-btn" id="dgZoomOut" aria-label="Zoom out">−</button>
          <span class="dg-zoom-val" id="dgZoomVal">100%</span>
          <button type="button" class="dg-btn" id="dgZoomIn" aria-label="Zoom in">+</button>
        </div>
        <button type="button" class="dg-btn" id="dgZoomReset">Reset view</button>
        <button type="button" class="dg-btn" id="dgGroup" disabled>Group</button>
        <button type="button" class="dg-btn" id="dgUngroup" disabled>Ungroup</button>
        <button type="button" class="dg-btn" id="dgToFront" disabled>To Front</button>
        <button type="button" class="dg-btn" id="dgToBack" disabled>To Back</button>
        <button type="button" class="dg-btn" id="dgDuplicate" disabled>Duplicate</button>
        <button type="button" class="dg-btn" id="dgUndo" disabled>Undo</button>
        <span class="dg-toolbar-spacer"></span>
        <button type="button" class="dg-btn" id="dgFullscreen">Fullscreen</button>
        <button type="button" class="dg-btn" id="dgExport">Export JSON</button>
        <button type="button" class="dg-btn dg-btn-danger" id="dgClear">Clear</button>
      </div>

      <div class="dg-canvas-wrap" id="dgCanvasWrap">
        <div class="dg-viewport" id="dgViewport">
          <svg class="dg-svg" id="dgSvg">
            <defs>
              <marker id="dgArrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path d="M0,0 L10,5 L0,10 z"></path>
              </marker>
            </defs>
            <g id="dgEdgeLayer"></g>
          </svg>
          <div id="dgNodeLayer"></div>
        </div>
        <input type="text" id="dgEdgeLabelInput" class="dg-edge-input" autocomplete="off" hidden>
        <div id="dgContextMenu" class="dg-context-menu" hidden></div>
      </div>

      <p class="boe-hint dg-hint">Drag "+ Box" or "+ Container" onto the canvas, or click either to add. A container is a large frame: drop boxes inside it and it carries them when it moves. Drag from a box's edge dot to connect it to another box. Double-click a box or a connection to rename it. Click to select, then press Delete to remove, Ctrl/Cmd+D to duplicate, Ctrl/Cmd+Z to undo. Right-click a box for more actions, including a color. Right-click a connection to set its line style, arrow direction, or an animated flow. Shift-click to select several boxes, then Group to move them as one, Ungroup to split them apart again. To Front and To Back change which box sits on top when they overlap. Scroll to zoom, drag empty space to pan. Saved to this browser automatically.</p>
    </div>
  </div>
</div>

<style>
.boe-root { font-family: var(--font-mono); color: var(--headline-color); font-size: 14px; }

.boe-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 20px; }
.boe-blurb { font-family: var(--font-body); font-weight: 300; font-size: 15px; line-height: 1.7; color: var(--card-desc); max-width: 52ch; margin: 0; }
.boe-reset {
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--tone-bad); background: transparent; border: 1px solid var(--card-border);
  padding: 6px 12px; cursor: pointer; flex-shrink: 0; transition: border-color .4s ease;
}
.boe-reset:hover { border-color: var(--tone-bad); }

.boe-tabs { display: flex; gap: 4px; margin-bottom: 20px; border-bottom: 1px solid var(--card-border); }
.boe-tabbtn {
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--card-desc); background: transparent; border: 0; border-bottom: 2px solid transparent;
  padding: 8px 4px; margin-bottom: -1px; cursor: pointer; transition: color .3s ease, border-color .3s ease;
}
.boe-tabbtn + .boe-tabbtn { margin-left: 18px; }
.boe-tabbtn:hover { color: var(--headline-color); }
.boe-tabbtn.active { color: var(--card-label); border-bottom-color: var(--card-label); }

.boe-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
@media (min-width: 860px) { .boe-grid { grid-template-columns: 1fr 1fr; align-items: start; } }

.boe-panel {
  background: var(--card-bg); border: 1px solid var(--card-border);
  padding: 16px 18px; margin-bottom: 14px;
}
.boe-panel-title {
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--card-desc); margin: 0 0 14px;
}

.boe-field { display: block; margin-bottom: 14px; }
.boe-label, .boe-label-row {
  display: flex; justify-content: space-between; align-items: baseline;
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--card-desc); margin-bottom: 5px;
}
.boe-unit { color: var(--card-desc); opacity: 0.8; }
.boe-slide-val { font-family: var(--font-mono); font-size: 13px; color: var(--card-label); text-transform: none; letter-spacing: 0; }
.boe-inp {
  width: 100%; background: transparent; border: 0; border-bottom: 1px solid var(--card-border);
  padding: 5px 2px; color: var(--card-label); font-family: var(--font-mono); font-size: 14px;
  outline: none; border-radius: 0;
}
.boe-inp:focus { border-bottom-color: var(--card-label); }
.boe-range { width: 100%; accent-color: var(--card-label); }
.boe-hint { display: block; margin-top: 5px; font-family: var(--font-body); font-size: 12px; font-style: italic; color: var(--card-desc); }

.boe-out { padding: 8px 0; border-bottom: 1px solid var(--card-border); }
.boe-out:last-child { border-bottom: 0; }
.boe-out-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-family: var(--font-body); font-size: 13px; }
.boe-out-val { font-family: var(--font-mono); font-size: 15px; font-weight: 500; color: var(--card-label); white-space: nowrap; font-variant-numeric: tabular-nums; }
.boe-out-unit { font-size: 11px; color: var(--card-desc); margin-left: 3px; }
.boe-out-big .boe-out-row { font-size: 14px; }
.boe-out-big .boe-out-val { font-size: 24px; font-weight: 600; padding-bottom: 2px; border-bottom: 3px double var(--card-label); }
.boe-formula { font-family: var(--font-mono); font-size: 11px; color: var(--card-desc); opacity: 0.85; margin-top: 4px; }
.boe-sub { font-family: var(--font-body); font-size: 11.5px; color: var(--card-desc); margin-top: 2px; }

.boe-learn {
  border-left: 3px solid var(--tone-bad); background: color-mix(in srgb, var(--tone-bad) 6%, transparent);
  padding: 14px 16px; margin-bottom: 14px;
}
.boe-learn-label { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--tone-bad); margin-bottom: 8px; }
.boe-learn p { font-family: var(--font-body); font-weight: 300; font-size: 13.5px; line-height: 1.7; color: var(--headline-color); margin: 0 0 10px; }
.boe-learn p:last-child { margin-bottom: 0; }

.boe-flag {
  font-family: var(--font-body); font-size: 12.5px; line-height: 1.6; color: var(--tone-bad);
  border: 1px dashed var(--tone-bad); padding: 10px 14px; margin: 8px 0; display: none;
}
.boe-flag.on { display: block; }
.boe-flag-ok { color: var(--tone-ok); border-color: var(--tone-ok); }
</style>

<!--
  Diagram tab styling lives in a separate `is:global` block on purpose.
  Astro scopes component <style> blocks by rewriting selectors to
  `.foo[data-astro-cid-xxxx]` and stamping that attribute onto elements
  the template renders. Every node/port/handle/edge below is created at
  runtime via document.createElement/createElementNS, so it never gets
  that attribute — under a scoped block, none of these rules would ever
  match, which is why nothing was actually positioned or visible.
-->
<style is:global>
.dg-root { margin-top: 4px; }
.dg-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 12px; }
.dg-chip {
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--card-label); border: 1px dashed var(--card-label); padding: 7px 12px;
  cursor: grab; user-select: none; background: transparent;
}
.dg-chip:active { cursor: grabbing; }
.dg-tool-group { display: flex; align-items: center; gap: 6px; }
.dg-zoom-val { font-family: var(--font-mono); font-size: 11px; color: var(--card-desc); min-width: 34px; text-align: center; }
.dg-btn {
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--card-desc); background: transparent; border: 1px solid var(--card-border);
  padding: 6px 10px; cursor: pointer; transition: border-color .3s ease, color .3s ease;
}
.dg-btn:hover { border-color: var(--card-label); color: var(--headline-color); }
.dg-btn:disabled { opacity: 0.35; cursor: default; pointer-events: none; }
.dg-btn-danger { color: var(--tone-bad); }
.dg-btn-danger:hover { border-color: var(--tone-bad); color: var(--tone-bad); }
.dg-toolbar-spacer { flex: 1 1 auto; }

.dg-canvas-wrap {
  position: relative; height: 460px; border: 1px solid var(--card-border); background: var(--card-bg);
  overflow: hidden; cursor: grab; touch-action: none;
  background-image: radial-gradient(color-mix(in srgb, var(--card-border) 70%, transparent) 1px, transparent 1px);
  background-size: 22px 22px;
}
.dg-canvas-wrap.panning { cursor: grabbing; }
.dg-viewport { position: absolute; left: 0; top: 0; transform-origin: 0 0; }
.dg-svg { position: absolute; left: 0; top: 0; width: 1px; height: 1px; overflow: visible; pointer-events: none; }
.dg-svg #dgArrow path { fill: var(--card-desc); }

.dg-node {
  position: absolute; display: flex; align-items: center; justify-content: center; text-align: center;
  background: var(--card-bg); border: 1px solid var(--card-border); padding: 6px 10px; box-sizing: border-box;
  font-family: var(--font-body); font-size: 13px; color: var(--headline-color); cursor: grab; user-select: none;
  touch-action: none;
}
.dg-node:active { cursor: grabbing; }

/* Each color is a single cool, muted hue blended into the theme's own card
   tokens via color-mix, so the tint stays soft and adapts to dark/light
   automatically instead of needing separate hardcoded values per theme.
   Placed before .selected/.drop-target below so those still win the border. */
.dg-node[data-color="slate"] { background: color-mix(in srgb, #7c8aa5 16%, var(--card-bg)); border-color: color-mix(in srgb, #7c8aa5 55%, var(--card-border)); }
.dg-node[data-color="blue"] { background: color-mix(in srgb, #5b8def 16%, var(--card-bg)); border-color: color-mix(in srgb, #5b8def 55%, var(--card-border)); }
.dg-node[data-color="teal"] { background: color-mix(in srgb, #2fb8a6 16%, var(--card-bg)); border-color: color-mix(in srgb, #2fb8a6 55%, var(--card-border)); }
.dg-node[data-color="green"] { background: color-mix(in srgb, #5fae6a 16%, var(--card-bg)); border-color: color-mix(in srgb, #5fae6a 55%, var(--card-border)); }
.dg-node[data-color="purple"] { background: color-mix(in srgb, #9b7cd6 16%, var(--card-bg)); border-color: color-mix(in srgb, #9b7cd6 55%, var(--card-border)); }
.dg-node[data-color="rose"] { background: color-mix(in srgb, #d97b93 16%, var(--card-bg)); border-color: color-mix(in srgb, #d97b93 55%, var(--card-border)); }
.dg-node[data-color="aws"] { background: color-mix(in srgb, #FF9900 16%, var(--card-bg)); border-color: color-mix(in srgb, #FF9900 55%, var(--card-border)); }
.dg-node[data-color="gcp"] { background: color-mix(in srgb, #4285F4 16%, var(--card-bg)); border-color: color-mix(in srgb, #4285F4 55%, var(--card-border)); }
.dg-node[data-color="azure"] { background: color-mix(in srgb, #0078D4 16%, var(--card-bg)); border-color: color-mix(in srgb, #0078D4 55%, var(--card-border)); }

.dg-node.selected { border-color: var(--card-label); border-width: 2px; }
.dg-node.drop-target { border-color: var(--card-label); box-shadow: 0 0 0 3px color-mix(in srgb, var(--card-label) 30%, transparent); }
.dg-node-label { outline: none; width: 100%; overflow-wrap: break-word; }
.dg-node-label[contenteditable="true"] { cursor: text; background: color-mix(in srgb, var(--card-label) 8%, transparent); }

.dg-node.container {
  background: color-mix(in srgb, var(--card-bg) 35%, transparent);
  border-style: dashed;
  align-items: flex-start;
  justify-content: flex-start;
  padding: 8px 10px;
}
.dg-node.container .dg-node-label {
  width: auto;
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--card-desc);
}

.dg-port {
  position: absolute; width: 8px; height: 8px; border-radius: 50%;
  background: var(--card-bg); border: 1px solid var(--card-desc); opacity: 0;
  transform: scale(1); transition: opacity .2s ease, background .2s ease, transform .15s ease;
  cursor: crosshair; touch-action: none;
}
.dg-node:hover .dg-port, .dg-node.selected .dg-port { opacity: 1; }
.dg-port:hover { background: var(--card-label); border-color: var(--card-label); transform: scale(1.6); }
.dg-port-n { top: -4px; left: 50%; margin-left: -4px; }
.dg-port-s { bottom: -4px; left: 50%; margin-left: -4px; }
.dg-port-e { right: -4px; top: 50%; margin-top: -4px; }
.dg-port-w { left: -4px; top: 50%; margin-top: -4px; }

.dg-resize-handle {
  position: absolute; right: -6px; bottom: -6px; width: 11px; height: 11px;
  background: var(--card-bg); border: 1px solid var(--card-desc); opacity: 0; transition: opacity .2s ease, background .2s ease;
  cursor: nwse-resize; touch-action: none;
}
.dg-node:hover .dg-resize-handle, .dg-node.selected .dg-resize-handle { opacity: 1; }
.dg-resize-handle:hover { background: var(--card-label); border-color: var(--card-label); }

.dg-group-box { fill: none; stroke: var(--card-desc); stroke-width: 1; stroke-dasharray: 5 4; pointer-events: none; }

.dg-edge-hit { stroke: transparent; stroke-width: 14; fill: none; pointer-events: stroke; cursor: pointer; }
.dg-edge-line { stroke: var(--card-desc); stroke-width: 1.5; fill: none; pointer-events: none; }
.dg-edge.selected .dg-edge-line { stroke: var(--card-label); stroke-width: 2; }
.dg-edge-temp { stroke: var(--card-label); stroke-width: 1.5; stroke-dasharray: 4 3; fill: none; pointer-events: none; }
.dg-edge-label-bg { fill: var(--card-bg); pointer-events: none; }
.dg-edge-label { font-family: var(--font-mono); font-size: 10px; fill: var(--card-desc); pointer-events: none; }

@keyframes dg-marching-ants { to { stroke-dashoffset: -20; } }
.dg-edge-line.dg-flow-dash { animation: dg-marching-ants 0.6s linear infinite; }
/* Same keyframes, just replayed forward-then-backward each cycle for a back-and-forth feel. */
.dg-edge-line.dg-flow-dash.dg-flow-alt { animation-direction: alternate; }

@keyframes dg-flow-move { from { offset-distance: 0%; } to { offset-distance: 100%; } }
.dg-edge-flow-dot { fill: var(--card-label); pointer-events: none; animation: dg-flow-move 1.6s linear infinite; }
.dg-edge-flow-dot.dg-flow-alt { animation-direction: alternate; }

@media (prefers-reduced-motion: reduce) {
  .dg-edge-line.dg-flow-dash, .dg-edge-flow-dot { animation: none; }
}

.dg-edge-input {
  position: absolute; transform: translate(-50%, -50%); z-index: 5;
  font-family: var(--font-mono); font-size: 11px; color: var(--card-label);
  background: var(--card-bg); border: 1px solid var(--card-label); padding: 3px 6px; outline: none; width: 120px;
}

.dg-context-menu {
  position: absolute; z-index: 10; min-width: 140px;
  background: var(--card-bg); border: 1px solid var(--card-border); box-shadow: 0 4px 16px color-mix(in srgb, #000 30%, transparent);
  padding: 4px; flex-direction: column;
}
/* [hidden] and .dg-context-menu are equal specificity, so the plain class rule above
   must not set display itself (it would win the cascade tie and stay visible even
   when the hidden attribute is set). Gate display on :not([hidden]) instead. */
.dg-context-menu:not([hidden]) { display: flex; }
.dg-context-menu button {
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase;
  color: var(--headline-color); background: transparent; border: 0; text-align: left;
  padding: 7px 10px; cursor: pointer;
}
.dg-context-menu button:hover { background: color-mix(in srgb, var(--card-label) 12%, transparent); color: var(--card-label); }
.dg-context-menu button.danger { color: var(--tone-bad); }
.dg-context-menu button.danger:hover { background: color-mix(in srgb, var(--tone-bad) 12%, transparent); }
.dg-context-menu hr { width: 100%; border: 0; border-top: 1px solid var(--card-border); margin: 4px 0; }

.dg-color-row { display: flex; gap: 6px; padding: 6px 10px; flex-wrap: wrap; }
.dg-context-menu .dg-swatch {
  width: 18px; height: 18px; padding: 0; border-radius: 50%; border: 1px solid var(--card-border);
  cursor: pointer; background: transparent; transition: transform .12s ease;
}
.dg-context-menu .dg-swatch:hover { transform: scale(1.2); }
.dg-context-menu .dg-swatch-none { position: relative; background: var(--card-bg); }
.dg-context-menu .dg-swatch-none::after {
  content: ""; position: absolute; left: 3px; right: 3px; top: 50%; height: 1px;
  background: var(--tone-bad); transform: rotate(45deg);
}

.dg-style-label { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--card-desc); opacity: 0.7; padding: 6px 10px 0; }
.dg-style-row { display: flex; gap: 4px; padding: 4px 10px 6px; flex-wrap: wrap; }
.dg-context-menu .dg-style-btn {
  font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.04em; text-transform: uppercase;
  color: var(--card-desc); background: transparent; border: 1px solid var(--card-border);
  padding: 4px 8px; cursor: pointer;
}
.dg-context-menu .dg-style-btn:hover { border-color: var(--card-label); color: var(--headline-color); }
.dg-context-menu .dg-style-btn.active { border-color: var(--card-label); color: var(--card-label); }

.dg-root:fullscreen { background: var(--page-bg); padding: 18px 22px; }
.dg-root:fullscreen .dg-canvas-wrap { height: calc(100vh - 130px); }
.dg-root:-webkit-full-screen { background: var(--page-bg); padding: 18px 22px; }
.dg-root:-webkit-full-screen .dg-canvas-wrap { height: calc(100vh - 130px); }

.dg-hint { margin-top: 10px; }
</style>

<script is:inline>
(function () {
  var tabs = document.querySelectorAll(".boe-tabbtn");
  var panels = document.querySelectorAll(".boe-tab");
  var resetBtn = document.getElementById("boeReset");
  tabs.forEach(function (btn) {
    btn.addEventListener("click", function () {
      var target = btn.dataset.tab;
      tabs.forEach(function (b) { b.classList.toggle("active", b === btn); });
      panels.forEach(function (p) { p.hidden = p.dataset.tab !== target; });
      if (resetBtn) resetBtn.hidden = target !== "traffic";
    });
  });
})();
</script>

<script is:inline>
(function () {
  function n(v) { var x = parseFloat(v); return isFinite(x) ? x : 0; }
  function fmt(x, d) {
    d = d === undefined ? 2 : d;
    if (!isFinite(x)) return "—";
    var a = Math.abs(x);
    if (a === 0) return "0";
    if (a >= 1e15) return x.toExponential(2);
    if (a >= 1e12) return (x / 1e12).toFixed(d) + "T";
    if (a >= 1e9) return (x / 1e9).toFixed(d) + "B";
    if (a >= 1e6) return (x / 1e6).toFixed(d) + "M";
    if (a >= 1e3) return (x / 1e3).toFixed(d) + "K";
    if (a >= 100) return x.toFixed(0);
    if (a >= 1) return x.toFixed(d);
    if (a >= 0.001) return x.toFixed(4);
    return x.toExponential(2);
  }
  function int(x) {
    if (!isFinite(x)) return "—";
    return Math.round(x).toLocaleString("en-US");
  }

  function derive(s) {
    var d = {};
    d.dau = n(s.dau);
    d.reqDay = d.dau * n(s.rpu);
    d.rps = d.reqDay / 86400;
    d.peakF = Math.max(n(s.peak), 1);
    d.peakRps = d.rps * d.peakF;
    var rw = Math.max(n(s.rw), 0);
    d.rShare = rw / (rw + 1);
    d.wShare = 1 - d.rShare;
    d.peakReadRps = d.peakRps * d.rShare;
    d.peakWriteRps = d.peakRps * d.wShare;
    d.writesDay = d.reqDay * d.wShare;
    d.readsDay = d.reqDay * d.rShare;
    d.reqMonth = d.reqDay * 30;
    return d;
  }

  var DEFAULTS = { dau: "10000000", rpu: "20", peak: "3", rw: "100" };
  var ids = ["dau", "rpu", "peak", "rw"];
  var els = {};
  ids.forEach(function (id) { els[id] = document.getElementById(id); });

  function state() {
    var s = {};
    ids.forEach(function (id) { s[id] = els[id].value; });
    return s;
  }

  function render() {
    var s = state();
    var d = derive(s);

    document.getElementById("peakVal").textContent = s.peak;

    document.getElementById("out-peakRps").firstChild.textContent = int(d.peakRps);
    document.getElementById("out-rps").firstChild.textContent = int(d.rps);
    document.getElementById("out-reqDay").textContent = fmt(d.reqDay);
    document.getElementById("out-reqMonth").textContent = fmt(d.reqMonth);

    document.getElementById("out-peakReadRps").firstChild.textContent = int(d.peakReadRps);
    document.getElementById("out-peakWriteRps").firstChild.textContent = int(d.peakWriteRps);
    document.getElementById("out-writesDay").textContent = fmt(d.writesDay);
    document.getElementById("out-readsDay").textContent = fmt(d.readsDay);
    document.getElementById("out-rShare").textContent = (d.rShare * 100).toFixed(1) + "% of traffic";
    document.getElementById("out-wShare").textContent = (d.wShare * 100).toFixed(1) + "% of traffic";

    var rw = n(s.rw);
    toggle("flag-scale", d.peakRps > 100000);
    toggle("flag-readheavy", rw >= 50);
    toggle("flag-writeheavy", rw < 1 && rw >= 0);
  }

  function toggle(id, on) {
    var el = document.getElementById(id);
    el.classList.toggle("on", on);
  }

  ids.forEach(function (id) {
    var evt = els[id].type === "range" ? "input" : "input";
    els[id].addEventListener(evt, render);
  });

  document.getElementById("boeReset").addEventListener("click", function () {
    ids.forEach(function (id) { els[id].value = DEFAULTS[id]; });
    render();
  });

  render();
})();
</script>

<script is:inline>
(function () {
  var wrap = document.getElementById("dgCanvasWrap");
  if (!wrap) return;

  var SVGNS = "http://www.w3.org/2000/svg";
  var STORAGE_KEY = "boe-diagram-v1";

  var viewport = document.getElementById("dgViewport");
  var svg = document.getElementById("dgSvg");
  var edgeLayer = document.getElementById("dgEdgeLayer");
  var nodeLayer = document.getElementById("dgNodeLayer");
  var addChip = document.getElementById("dgAddBox");
  var addContainerChip = document.getElementById("dgAddContainer");
  var zoomInBtn = document.getElementById("dgZoomIn");
  var zoomOutBtn = document.getElementById("dgZoomOut");
  var zoomResetBtn = document.getElementById("dgZoomReset");
  var zoomVal = document.getElementById("dgZoomVal");
  var exportBtn = document.getElementById("dgExport");
  var clearBtn = document.getElementById("dgClear");
  var edgeInput = document.getElementById("dgEdgeLabelInput");
  var groupBtn = document.getElementById("dgGroup");
  var ungroupBtn = document.getElementById("dgUngroup");
  var toFrontBtn = document.getElementById("dgToFront");
  var toBackBtn = document.getElementById("dgToBack");
  var duplicateBtn = document.getElementById("dgDuplicate");
  var undoBtn = document.getElementById("dgUndo");
  var fullscreenBtn = document.getElementById("dgFullscreen");
  var contextMenu = document.getElementById("dgContextMenu");
  var dgRoot = wrap.closest(".dg-root");

  var view = { panX: 40, panY: 40, zoom: 1 };
  var nodes = [];
  var edges = [];
  var nextId = 1;
  var selectedNodeIds = new Set();
  var selectedEdgeId = null;
  var undoStack = [];
  var UNDO_LIMIT = 50;

  function uid(prefix) { return (prefix || "b") + (nextId++); }
  function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

  var GRID = 22; // matches .dg-canvas-wrap's dotted background-size, so snapped positions land on visible dots
  function snap(v) { return Math.round(v / GRID) * GRID; }

  var NODE_COLORS = [
    { key: "slate", label: "Slate", hex: "#7c8aa5" },
    { key: "blue", label: "Blue", hex: "#5b8def" },
    { key: "teal", label: "Teal", hex: "#2fb8a6" },
    { key: "green", label: "Green", hex: "#5fae6a" },
    { key: "purple", label: "Purple", hex: "#9b7cd6" },
    { key: "rose", label: "Rose", hex: "#d97b93" },
    { key: "aws", label: "AWS", hex: "#FF9900" },
    { key: "gcp", label: "GCP", hex: "#4285F4" },
    { key: "azure", label: "Azure", hex: "#0078D4" }
  ];

  function snapshotState() {
    return JSON.parse(JSON.stringify({ nodes: nodes, edges: edges }));
  }
  function commitUndo(preSnapshot) {
    undoStack.push(preSnapshot);
    if (undoStack.length > UNDO_LIMIT) undoStack.shift();
    undoBtn.disabled = false;
  }
  function pushUndo() {
    commitUndo(snapshotState());
  }
  function undo() {
    if (!undoStack.length) return;
    var prev = undoStack.pop();
    nodes = prev.nodes;
    edges = prev.edges;
    clearSelection();
    renderNodes();
    renderEdges();
    save();
    undoBtn.disabled = undoStack.length === 0;
  }

  function nearestPort(node, px, py) {
    var candidates = [
      { x: node.x + node.w / 2, y: node.y },
      { x: node.x + node.w / 2, y: node.y + node.h },
      { x: node.x + node.w, y: node.y + node.h / 2 },
      { x: node.x, y: node.y + node.h / 2 }
    ];
    var best = candidates[0], bestDist = Infinity;
    candidates.forEach(function (p) {
      var d = (p.x - px) * (p.x - px) + (p.y - py) * (p.y - py);
      if (d < bestDist) { bestDist = d; best = p; }
    });
    return best;
  }

  function load() {
    try {
      var raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      var data = JSON.parse(raw);
      nodes = Array.isArray(data.nodes) ? data.nodes : [];
      edges = Array.isArray(data.edges) ? data.edges : [];
      nextId = data.nextId || nodes.length + edges.length + 1;
      if (data.view) view = data.view;
    } catch (e) {}
  }

  function save() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ nodes: nodes, edges: edges, nextId: nextId, view: view }));
    } catch (e) {}
  }

  function applyView() {
    viewport.style.transform = "translate(" + view.panX + "px," + view.panY + "px) scale(" + view.zoom + ")";
    zoomVal.textContent = Math.round(view.zoom * 100) + "%";
  }

  function nodeById(id) {
    for (var i = 0; i < nodes.length; i++) if (nodes[i].id === id) return nodes[i];
    return null;
  }

  function edgeById(id) {
    for (var i = 0; i < edges.length; i++) if (edges[i].id === id) return edges[i];
    return null;
  }

  function setEdgeProp(id, key, value) {
    var edge = edgeById(id);
    if (!edge) return;
    pushUndo();
    edge[key] = value;
    renderEdges();
    save();
  }

  function groupMembers(groupId) {
    return nodes.filter(function (n) { return n.groupId === groupId; }).map(function (n) { return n.id; });
  }

  function containerChildren(containerId) {
    return nodes.filter(function (n) { return n.parentId === containerId; }).map(function (n) { return n.id; });
  }

  // Topmost container (by array/paint order) whose bounds contain the given canvas-space point.
  function containerAt(x, y, excludeId) {
    var found = null;
    nodes.forEach(function (n) {
      if (n.type !== "container" || n.id === excludeId) return;
      if (x >= n.x && x <= n.x + n.w && y >= n.y && y <= n.y + n.h) found = n;
    });
    return found;
  }

  function applyNodeSelectionClasses() {
    nodeLayer.querySelectorAll(".dg-node").forEach(function (el) {
      el.classList.toggle("selected", selectedNodeIds.has(el.dataset.id));
    });
  }

  function applyEdgeSelectionClasses() {
    edgeLayer.querySelectorAll(".dg-edge").forEach(function (el) {
      el.classList.toggle("selected", el.dataset.id === selectedEdgeId);
    });
  }

  function updateGroupButtons() {
    var ids = Array.from(selectedNodeIds);
    groupBtn.disabled = ids.length < 2;
    ungroupBtn.disabled = !ids.some(function (id) {
      var n = nodeById(id);
      return n && n.groupId;
    });
    toFrontBtn.disabled = ids.length === 0;
    toBackBtn.disabled = ids.length === 0;
    duplicateBtn.disabled = ids.length === 0;
  }

  function renderGroupOverlay() {
    var existing = edgeLayer.querySelector(".dg-group-box");
    if (existing) existing.remove();
    if (selectedNodeIds.size < 2) return;
    var minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;
    selectedNodeIds.forEach(function (id) {
      var n = nodeById(id);
      if (!n) return;
      minX = Math.min(minX, n.x); minY = Math.min(minY, n.y);
      maxX = Math.max(maxX, n.x + n.w); maxY = Math.max(maxY, n.y + n.h);
    });
    if (!isFinite(minX)) return;
    var pad = 12;
    var rect = document.createElementNS(SVGNS, "rect");
    rect.setAttribute("class", "dg-group-box");
    rect.setAttribute("x", minX - pad);
    rect.setAttribute("y", minY - pad);
    rect.setAttribute("width", (maxX - minX) + pad * 2);
    rect.setAttribute("height", (maxY - minY) + pad * 2);
    edgeLayer.insertBefore(rect, edgeLayer.firstChild);
  }

  function refreshSelectionUI() {
    applyNodeSelectionClasses();
    applyEdgeSelectionClasses();
    renderGroupOverlay();
    updateGroupButtons();
  }

  function clearSelection() {
    selectedNodeIds = new Set();
    selectedEdgeId = null;
    refreshSelectionUI();
  }

  function selectNodesOnly(ids) {
    selectedNodeIds = new Set(ids);
    selectedEdgeId = null;
    refreshSelectionUI();
  }

  function selectEdgeOnly(id) {
    selectedNodeIds = new Set();
    selectedEdgeId = id;
    refreshSelectionUI();
  }

  function toggleNodeInSelection(id) {
    var node = nodeById(id);
    var ids = node && node.groupId ? groupMembers(node.groupId) : [id];
    var allIn = ids.every(function (i) { return selectedNodeIds.has(i); });
    ids.forEach(function (i) {
      if (allIn) selectedNodeIds.delete(i); else selectedNodeIds.add(i);
    });
    selectedEdgeId = null;
    refreshSelectionUI();
  }

  function startEditLabel(label, node) {
    label.setAttribute("contenteditable", "true");
    label.focus();
    var range = document.createRange();
    range.selectNodeContents(label);
    var sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);

    var committed = false;
    var labelBefore = node.label;
    function commit() {
      if (committed) return;
      committed = true;
      label.removeAttribute("contenteditable");
      var text = label.textContent.trim();
      var newLabel = text || "Component";
      if (newLabel !== labelBefore) {
        pushUndo();
        node.label = newLabel;
      }
      label.textContent = node.label;
      label.removeEventListener("blur", commit);
      label.removeEventListener("keydown", onKeydown);
      save();
    }
    function onKeydown(e) {
      if (e.key === "Enter") {
        e.preventDefault();
        label.blur();
      } else if (e.key === "Escape") {
        committed = true;
        label.textContent = node.label;
        label.removeAttribute("contenteditable");
        label.removeEventListener("blur", commit);
        label.removeEventListener("keydown", onKeydown);
      }
    }
    label.addEventListener("blur", commit);
    label.addEventListener("keydown", onKeydown);
  }

  function screenToCanvas(clientX, clientY) {
    var rect = wrap.getBoundingClientRect();
    return {
      x: (clientX - rect.left - view.panX) / view.zoom,
      y: (clientY - rect.top - view.panY) / view.zoom
    };
  }

  function startConnectDrag(fromNode, e) {
    var tempLine = document.createElementNS(SVGNS, "line");
    tempLine.setAttribute("class", "dg-edge-temp");
    edgeLayer.appendChild(tempLine);

    var port = e.target;
    port.setPointerCapture(e.pointerId);
    var acx = fromNode.x + fromNode.w / 2, acy = fromNode.y + fromNode.h / 2;
    var hoverTargetId = null;

    function setHoverTarget(id) {
      if (id === hoverTargetId) return;
      if (hoverTargetId) {
        var prevEl = nodeLayer.querySelector('[data-id="' + hoverTargetId + '"]');
        if (prevEl) prevEl.classList.remove("drop-target");
      }
      if (id) {
        var nextEl = nodeLayer.querySelector('[data-id="' + id + '"]');
        if (nextEl) nextEl.classList.add("drop-target");
      }
      hoverTargetId = id;
    }

    function targetNodeIdAt(clientX, clientY) {
      var targetEl = document.elementFromPoint(clientX, clientY);
      var targetNodeEl = targetEl && targetEl.closest && targetEl.closest(".dg-node");
      if (!targetNodeEl) return null;
      var id = targetNodeEl.dataset.id;
      return id !== fromNode.id ? id : null;
    }

    function onMove(ev) {
      var pt = screenToCanvas(ev.clientX, ev.clientY);
      var targetId = targetNodeIdAt(ev.clientX, ev.clientY);
      setHoverTarget(targetId);

      var endX = pt.x, endY = pt.y;
      if (targetId) {
        var targetNode = nodeById(targetId);
        if (targetNode) {
          var snapped = nearestPort(targetNode, pt.x, pt.y);
          endX = snapped.x;
          endY = snapped.y;
        }
      }
      tempLine.setAttribute("x1", acx);
      tempLine.setAttribute("y1", acy);
      tempLine.setAttribute("x2", endX);
      tempLine.setAttribute("y2", endY);
    }
    function onUp(ev) {
      port.removeEventListener("pointermove", onMove);
      port.removeEventListener("pointerup", onUp);
      tempLine.remove();
      setHoverTarget(null);
      var targetId = targetNodeIdAt(ev.clientX, ev.clientY);
      if (targetId) {
        pushUndo();
        edges.push({ id: uid(), from: fromNode.id, to: targetId, label: "", lineStyle: "solid", arrowStyle: "one", flow: "none", flowDirection: "forward" });
        renderEdges();
        save();
      }
    }
    port.addEventListener("pointermove", onMove);
    port.addEventListener("pointerup", onUp);
  }

  function isHandle(target) {
    return target.classList.contains("dg-port") || target.classList.contains("dg-resize-handle");
  }

  function wireNodeEvents(el, node, label, handle) {
    // Note: pointerdown handlers below deliberately never call preventDefault().
    // Doing so suppresses the browser's derived mouse events (click, dblclick) for
    // the whole interaction, which silently broke double-click-to-rename before.
    // touch-action: none (in CSS) handles touch-scroll suppression instead.
    el.addEventListener("dblclick", function (e) {
      if (isHandle(e.target)) return;
      e.stopPropagation();
      if (!label.isContentEditable) startEditLabel(label, node);
    });

    el.addEventListener("pointerdown", function (e) {
      if (e.button !== 0) return;
      if (isHandle(e.target)) return;
      if (label.isContentEditable) return;
      e.stopPropagation();

      if (e.shiftKey) {
        toggleNodeInSelection(node.id);
        return;
      }

      var dragIds;
      var isContainer = node.type === "container";
      var isGroup = !!node.groupId;
      if (isContainer) {
        var kids = containerChildren(node.id);
        if (!(selectedNodeIds.size === 1 && selectedNodeIds.has(node.id))) selectNodesOnly([node.id]);
        dragIds = [node.id].concat(kids);
      } else if (isGroup) {
        var members = groupMembers(node.groupId);
        var alreadyExact = members.length === selectedNodeIds.size && members.every(function (id) { return selectedNodeIds.has(id); });
        if (!alreadyExact) selectNodesOnly(members);
        dragIds = members;
      } else if (selectedNodeIds.has(node.id) && selectedNodeIds.size > 1) {
        dragIds = Array.from(selectedNodeIds);
      } else {
        selectNodesOnly([node.id]);
        dragIds = [node.id];
      }

      var startX = e.clientX, startY = e.clientY;
      var origins = dragIds.map(function (id) {
        var n = nodeById(id);
        return { id: id, x: n.x, y: n.y };
      });
      var preDrag = snapshotState();
      var moved = false;
      el.setPointerCapture(e.pointerId);

      function onMove(ev) {
        var dx = (ev.clientX - startX) / view.zoom;
        var dy = (ev.clientY - startY) / view.zoom;
        if (!moved && (Math.abs(ev.clientX - startX) > 3 || Math.abs(ev.clientY - startY) > 3)) moved = true;
        origins.forEach(function (o) {
          var n = nodeById(o.id);
          if (!n) return;
          n.x = snap(o.x + dx);
          n.y = snap(o.y + dy);
          var elN = nodeLayer.querySelector('[data-id="' + o.id + '"]');
          if (elN) { elN.style.left = n.x + "px"; elN.style.top = n.y + "px"; }
        });
        renderEdges();
      }
      function onUp() {
        el.removeEventListener("pointermove", onMove);
        el.removeEventListener("pointerup", onUp);
        if (!moved) {
          if (dragIds.length > 1 && !isGroup && !isContainer) selectNodesOnly([node.id]);
        } else {
          if (!isContainer && !isGroup && dragIds.length === 1) {
            var cx = node.x + node.w / 2, cy = node.y + node.h / 2;
            var container = containerAt(cx, cy, node.id);
            node.parentId = container ? container.id : null;
          }
          commitUndo(preDrag);
          save();
        }
      }
      el.addEventListener("pointermove", onMove);
      el.addEventListener("pointerup", onUp);
    });

    ["n", "e", "s", "w"].forEach(function (side) {
      var port = el.querySelector(".dg-port-" + side);
      port.addEventListener("pointerdown", function (e) {
        if (e.button !== 0) return;
        e.stopPropagation();
        startConnectDrag(node, e);
      });
    });

    handle.addEventListener("pointerdown", function (e) {
      if (e.button !== 0) return;
      e.stopPropagation();
      var startX = e.clientX, startY = e.clientY;
      var origW = node.w, origH = node.h;
      var preResize = snapshotState();
      handle.setPointerCapture(e.pointerId);

      function onMove(ev) {
        var dx = (ev.clientX - startX) / view.zoom;
        var dy = (ev.clientY - startY) / view.zoom;
        var maxW = node.type === "container" ? 2000 : 480;
        var maxH = node.type === "container" ? 2000 : 320;
        node.w = clamp(snap(origW + dx), 60, maxW);
        node.h = clamp(snap(origH + dy), 36, maxH);
        el.style.width = node.w + "px";
        el.style.height = node.h + "px";
        renderEdges();
      }
      function onUp() {
        handle.removeEventListener("pointermove", onMove);
        handle.removeEventListener("pointerup", onUp);
        commitUndo(preResize);
        save();
      }
      handle.addEventListener("pointermove", onMove);
      handle.addEventListener("pointerup", onUp);
    });
  }

  function createNodeEl(node) {
    var el = document.createElement("div");
    el.className = "dg-node" + (node.type === "container" ? " container" : "");
    el.dataset.id = node.id;
    if (node.color) el.dataset.color = node.color;
    el.style.left = node.x + "px";
    el.style.top = node.y + "px";
    el.style.width = node.w + "px";
    el.style.height = node.h + "px";

    var label = document.createElement("div");
    label.className = "dg-node-label";
    label.textContent = node.label;
    label.spellcheck = false;
    el.appendChild(label);

    ["n", "e", "s", "w"].forEach(function (side) {
      var port = document.createElement("div");
      port.className = "dg-port dg-port-" + side;
      el.appendChild(port);
    });

    var handle = document.createElement("div");
    handle.className = "dg-resize-handle";
    el.appendChild(handle);

    nodeLayer.appendChild(el);
    wireNodeEvents(el, node, label, handle);
    return el;
  }

  function renderNodes() {
    nodeLayer.innerHTML = "";
    nodes.forEach(createNodeEl);
    applyNodeSelectionClasses();
  }

  function clipPoint(cx, cy, w, h, dx, dy) {
    if (dx === 0 && dy === 0) return { x: cx, y: cy };
    var halfW = w / 2, halfH = h / 2;
    var scaleX = dx !== 0 ? halfW / Math.abs(dx) : Infinity;
    var scaleY = dy !== 0 ? halfH / Math.abs(dy) : Infinity;
    var s = Math.min(scaleX, scaleY);
    return { x: cx + dx * s, y: cy + dy * s };
  }

  function wireEdgeEvents(g, edge) {
    g.addEventListener("pointerdown", function (e) {
      if (e.button !== 0) return;
      e.stopPropagation();
      selectEdgeOnly(edge.id);
    });
    g.addEventListener("dblclick", function (e) {
      e.stopPropagation();
      openEdgeLabelEditor(edge);
    });
  }

  function renderEdges() {
    edgeLayer.innerHTML = "";
    edges.forEach(function (edge) {
      var a = nodeById(edge.from), b = nodeById(edge.to);
      if (!a || !b) return;
      var acx = a.x + a.w / 2, acy = a.y + a.h / 2;
      var bcx = b.x + b.w / 2, bcy = b.y + b.h / 2;
      var dx = bcx - acx, dy = bcy - acy;
      var p1 = clipPoint(acx, acy, a.w, a.h, dx, dy);
      var p2 = clipPoint(bcx, bcy, b.w, b.h, -dx, -dy);
      edge._mid = { x: (p1.x + p2.x) / 2, y: (p1.y + p2.y) / 2 };

      var g = document.createElementNS(SVGNS, "g");
      g.setAttribute("data-id", edge.id);
      g.setAttribute("class", "dg-edge" + (edge.id === selectedEdgeId ? " selected" : ""));

      var hit = document.createElementNS(SVGNS, "line");
      hit.setAttribute("class", "dg-edge-hit");
      hit.setAttribute("x1", p1.x); hit.setAttribute("y1", p1.y);
      hit.setAttribute("x2", p2.x); hit.setAttribute("y2", p2.y);

      var line = document.createElementNS(SVGNS, "line");
      line.setAttribute("x1", p1.x); line.setAttribute("y1", p1.y);
      line.setAttribute("x2", p2.x); line.setAttribute("y2", p2.y);

      var arrowStyle = edge.arrowStyle || "one";
      if (arrowStyle !== "none") line.setAttribute("marker-end", "url(#dgArrow)");
      if (arrowStyle === "both") line.setAttribute("marker-start", "url(#dgArrow)");

      // "dashed" is a static line style; "dash" flow reuses the same dash
      // pattern but animates its offset (marching ants) to read as motion.
      var flowAlt = edge.flowDirection === "alternate";
      var lineClass = "dg-edge-line";
      var dash = edge.lineStyle === "dashed" ? "6 4" : null;
      if (edge.flow === "dash") {
        dash = dash || "6 4";
        lineClass += " dg-flow-dash" + (flowAlt ? " dg-flow-alt" : "");
      }
      if (dash) line.setAttribute("stroke-dasharray", dash);
      line.setAttribute("class", lineClass);

      g.appendChild(hit);
      g.appendChild(line);

      if (edge.flow === "dot") {
        var dot = document.createElementNS(SVGNS, "circle");
        dot.setAttribute("r", "3");
        dot.setAttribute("class", "dg-edge-flow-dot" + (flowAlt ? " dg-flow-alt" : ""));
        dot.style.offsetPath = "path('M " + p1.x + " " + p1.y + " L " + p2.x + " " + p2.y + "')";
        g.appendChild(dot);
      }

      if (edge.label) {
        var w = Math.max(20, edge.label.length * 6 + 10);
        var rect = document.createElementNS(SVGNS, "rect");
        rect.setAttribute("class", "dg-edge-label-bg");
        rect.setAttribute("x", edge._mid.x - w / 2);
        rect.setAttribute("y", edge._mid.y - 8);
        rect.setAttribute("width", w);
        rect.setAttribute("height", 16);

        var text = document.createElementNS(SVGNS, "text");
        text.setAttribute("class", "dg-edge-label");
        text.setAttribute("x", edge._mid.x);
        text.setAttribute("y", edge._mid.y + 3.5);
        text.setAttribute("text-anchor", "middle");
        text.textContent = edge.label;

        g.appendChild(rect);
        g.appendChild(text);
      }

      wireEdgeEvents(g, edge);
      edgeLayer.appendChild(g);
    });
    renderGroupOverlay();
  }

  function openEdgeLabelEditor(edge) {
    var mid = edge._mid || { x: 0, y: 0 };
    edgeInput.style.left = (view.panX + view.zoom * mid.x) + "px";
    edgeInput.style.top = (view.panY + view.zoom * mid.y) + "px";
    edgeInput.value = edge.label || "";
    edgeInput.hidden = false;
    edgeInput.focus();
    edgeInput.select();

    function commit() {
      var newLabel = edgeInput.value.trim();
      if (newLabel !== (edge.label || "")) {
        pushUndo();
        edge.label = newLabel;
      }
      edgeInput.hidden = true;
      edgeInput.removeEventListener("blur", commit);
      edgeInput.removeEventListener("keydown", onKeydown);
      renderEdges();
      save();
    }
    function onKeydown(e) {
      if (e.key === "Enter") {
        e.preventDefault();
        edgeInput.blur();
      } else if (e.key === "Escape") {
        edgeInput.hidden = true;
        edgeInput.removeEventListener("blur", commit);
        edgeInput.removeEventListener("keydown", onKeydown);
      }
    }
    edgeInput.addEventListener("blur", commit);
    edgeInput.addEventListener("keydown", onKeydown);
  }

  function addNode(x, y, type) {
    var isContainer = type === "container";
    var node = {
      id: uid(),
      x: x, y: y,
      w: isContainer ? 320 : 140,
      h: isContainer ? 220 : 56,
      label: isContainer ? "Container" : "Component",
      type: isContainer ? "container" : "box",
      parentId: null,
      color: null
    };
    if (!isContainer) {
      var c = containerAt(x + node.w / 2, y + node.h / 2, null);
      if (c) node.parentId = c.id;
    }
    pushUndo();
    // New containers go behind everything already on the canvas, since a
    // frame that paints on top of existing boxes would hide them.
    if (isContainer) nodes.unshift(node); else nodes.push(node);
    renderNodes();
    renderEdges();
    save();
    selectNodesOnly([node.id]);
    var el = nodeLayer.querySelector('[data-id="' + node.id + '"]');
    var label = el.querySelector(".dg-node-label");
    startEditLabel(label, node);
  }

  wrap.addEventListener("pointerdown", function (e) {
    if (e.button !== 0) return;
    if (e.target.closest(".dg-node") || e.target.closest(".dg-edge")) return;
    hideContextMenu();
    var startX = e.clientX, startY = e.clientY;
    var origPanX = view.panX, origPanY = view.panY;
    wrap.setPointerCapture(e.pointerId);
    wrap.classList.add("panning");
    clearSelection();

    function onMove(ev) {
      view.panX = origPanX + (ev.clientX - startX);
      view.panY = origPanY + (ev.clientY - startY);
      applyView();
    }
    function onUp() {
      wrap.removeEventListener("pointermove", onMove);
      wrap.removeEventListener("pointerup", onUp);
      wrap.classList.remove("panning");
      save();
    }
    wrap.addEventListener("pointermove", onMove);
    wrap.addEventListener("pointerup", onUp);
  });

  wrap.addEventListener("wheel", function (e) {
    e.preventDefault();
    var rect = wrap.getBoundingClientRect();
    var mx = e.clientX - rect.left, my = e.clientY - rect.top;
    var canvasX = (mx - view.panX) / view.zoom;
    var canvasY = (my - view.panY) / view.zoom;
    var factor = e.deltaY < 0 ? 1.1 : 0.9;
    var newZoom = clamp(view.zoom * factor, 0.4, 2.5);
    view.panX = mx - canvasX * newZoom;
    view.panY = my - canvasY * newZoom;
    view.zoom = newZoom;
    applyView();
    save();
  }, { passive: false });

  wrap.addEventListener("dragover", function (e) {
    e.preventDefault();
    e.dataTransfer.dropEffect = "copy";
  });
  wrap.addEventListener("drop", function (e) {
    e.preventDefault();
    var kind = e.dataTransfer.getData("text/plain") === "container" ? "container" : "box";
    var w = kind === "container" ? 320 : 140, h = kind === "container" ? 220 : 56;
    var rect = wrap.getBoundingClientRect();
    var mx = e.clientX - rect.left, my = e.clientY - rect.top;
    var canvasX = (mx - view.panX) / view.zoom;
    var canvasY = (my - view.panY) / view.zoom;
    addNode(canvasX - w / 2, canvasY - h / 2, kind);
  });

  addChip.addEventListener("dragstart", function (e) {
    e.dataTransfer.setData("text/plain", "box");
    e.dataTransfer.effectAllowed = "copy";
  });
  addChip.addEventListener("click", function () {
    var rect = wrap.getBoundingClientRect();
    var cx = (rect.width / 2 - view.panX) / view.zoom;
    var cy = (rect.height / 2 - view.panY) / view.zoom;
    addNode(cx - 70, cy - 28, "box");
  });

  addContainerChip.addEventListener("dragstart", function (e) {
    e.dataTransfer.setData("text/plain", "container");
    e.dataTransfer.effectAllowed = "copy";
  });
  addContainerChip.addEventListener("click", function () {
    var rect = wrap.getBoundingClientRect();
    var cx = (rect.width / 2 - view.panX) / view.zoom;
    var cy = (rect.height / 2 - view.panY) / view.zoom;
    addNode(cx - 160, cy - 110, "container");
  });

  function zoomBy(factor) {
    var rect = wrap.getBoundingClientRect();
    var cx = rect.width / 2, cy = rect.height / 2;
    var canvasX = (cx - view.panX) / view.zoom;
    var canvasY = (cy - view.panY) / view.zoom;
    var newZoom = clamp(view.zoom * factor, 0.4, 2.5);
    view.panX = cx - canvasX * newZoom;
    view.panY = cy - canvasY * newZoom;
    view.zoom = newZoom;
    applyView();
    save();
  }
  zoomInBtn.addEventListener("click", function () { zoomBy(1.2); });
  zoomOutBtn.addEventListener("click", function () { zoomBy(1 / 1.2); });
  zoomResetBtn.addEventListener("click", function () {
    view = { panX: 40, panY: 40, zoom: 1 };
    applyView();
    save();
  });

  exportBtn.addEventListener("click", function () {
    var data = JSON.stringify({ nodes: nodes, edges: edges }, null, 2);
    var blob = new Blob([data], { type: "application/json" });
    var url = URL.createObjectURL(blob);
    var a = document.createElement("a");
    a.href = url;
    a.download = "system-diagram.json";
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  });

  clearBtn.addEventListener("click", function () {
    if (!nodes.length && !edges.length) return;
    if (!confirm("Clear the diagram? This can't be undone.")) return;
    pushUndo();
    nodes = [];
    edges = [];
    clearSelection();
    renderNodes();
    renderEdges();
    save();
  });

  groupBtn.addEventListener("click", function () {
    if (selectedNodeIds.size < 2) return;
    pushUndo();
    var gid = uid("g");
    selectedNodeIds.forEach(function (id) {
      var n = nodeById(id);
      if (n) n.groupId = gid;
    });
    updateGroupButtons();
    save();
  });

  ungroupBtn.addEventListener("click", function () {
    pushUndo();
    selectedNodeIds.forEach(function (id) {
      var n = nodeById(id);
      if (n) n.groupId = null;
    });
    updateGroupButtons();
    save();
  });

  function reorderSelected(toFront) {
    if (selectedNodeIds.size === 0) return;
    pushUndo();
    var picked = nodes.filter(function (n) { return selectedNodeIds.has(n.id); });
    var rest = nodes.filter(function (n) { return !selectedNodeIds.has(n.id); });
    nodes = toFront ? rest.concat(picked) : picked.concat(rest);
    renderNodes();
    renderEdges();
    save();
  }
  toFrontBtn.addEventListener("click", function () { reorderSelected(true); });
  toBackBtn.addEventListener("click", function () { reorderSelected(false); });

  function duplicateSelection() {
    if (selectedNodeIds.size === 0) return;
    pushUndo();
    var offset = GRID * 2;
    var idMap = {};
    var groupIdMap = {};
    var selectedArr = nodes.filter(function (n) { return selectedNodeIds.has(n.id); });
    var newNodes = selectedArr.map(function (n) {
      var newId = uid();
      idMap[n.id] = newId;
      var newGroupId = null;
      if (n.groupId) {
        if (!groupIdMap[n.groupId]) groupIdMap[n.groupId] = uid("g");
        newGroupId = groupIdMap[n.groupId];
      }
      return {
        id: newId, x: snap(n.x + offset), y: snap(n.y + offset), w: n.w, h: n.h,
        label: n.label, type: n.type, groupId: newGroupId, parentId: null, color: n.color || null
      };
    });
    newNodes.forEach(function (nn, i) {
      var origParent = selectedArr[i].parentId;
      if (origParent) nn.parentId = idMap[origParent] || origParent;
    });
    var newEdges = [];
    edges.forEach(function (ed) {
      if (idMap[ed.from] && idMap[ed.to]) {
        newEdges.push({ id: uid(), from: idMap[ed.from], to: idMap[ed.to], label: ed.label, lineStyle: ed.lineStyle, arrowStyle: ed.arrowStyle, flow: ed.flow, flowDirection: ed.flowDirection });
      }
    });
    newNodes.forEach(function (nn) {
      if (nn.type === "container") nodes.unshift(nn); else nodes.push(nn);
    });
    edges = edges.concat(newEdges);
    renderNodes();
    renderEdges();
    selectNodesOnly(newNodes.map(function (n) { return n.id; }));
    save();
  }
  duplicateBtn.addEventListener("click", duplicateSelection);
  undoBtn.addEventListener("click", undo);

  function deleteSelection() {
    if (selectedNodeIds.size === 0 && !selectedEdgeId) return;
    pushUndo();
    if (selectedNodeIds.size > 0) {
      var removedIds = selectedNodeIds;
      // Deleting a container releases its children rather than taking them with it.
      nodes.forEach(function (n) {
        if (n.parentId && removedIds.has(n.parentId)) n.parentId = null;
      });
      nodes = nodes.filter(function (nd) { return !removedIds.has(nd.id); });
      edges = edges.filter(function (ed) { return !removedIds.has(ed.from) && !removedIds.has(ed.to); });
    } else if (selectedEdgeId) {
      var removedEdgeId = selectedEdgeId;
      edges = edges.filter(function (ed) { return ed.id !== removedEdgeId; });
    }
    clearSelection();
    renderNodes();
    renderEdges();
    save();
  }

  document.addEventListener("keydown", function (e) {
    var panel = wrap.closest(".boe-tab");
    if (panel && panel.hidden) return;
    var active = document.activeElement;
    if (active && (active.isContentEditable || active.tagName === "INPUT" || active.tagName === "TEXTAREA")) return;

    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "z") {
      e.preventDefault();
      undo();
      return;
    }
    if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "d") {
      e.preventDefault();
      duplicateSelection();
      return;
    }

    if (selectedNodeIds.size === 0 && !selectedEdgeId) return;
    if (e.key === "Delete" || e.key === "Backspace") {
      e.preventDefault();
      deleteSelection();
    }
  });

  // Stop pointerdown from bubbling to wrap's pan/deselect handler, which would
  // clear the selection and hide the menu before a menu button's own click fires.
  contextMenu.addEventListener("pointerdown", function (e) { e.stopPropagation(); });

  function hideContextMenu() {
    contextMenu.hidden = true;
    contextMenu.innerHTML = "";
  }

  function setSelectionColor(colorKey) {
    if (selectedNodeIds.size === 0) return;
    pushUndo();
    selectedNodeIds.forEach(function (id) {
      var n = nodeById(id);
      if (n && n.type !== "container") n.color = colorKey;
    });
    renderNodes();
    save();
  }

  function showContextMenu(items, clientX, clientY) {
    contextMenu.innerHTML = "";
    items.forEach(function (item) {
      if (item === "separator") {
        contextMenu.appendChild(document.createElement("hr"));
        return;
      }
      if (item.swatches) {
        var row = document.createElement("div");
        row.className = "dg-color-row";
        var noneBtn = document.createElement("button");
        noneBtn.type = "button";
        noneBtn.className = "dg-swatch dg-swatch-none";
        noneBtn.title = "No color";
        noneBtn.addEventListener("click", function () { hideContextMenu(); item.onPick(null); });
        row.appendChild(noneBtn);
        NODE_COLORS.forEach(function (c) {
          var sw = document.createElement("button");
          sw.type = "button";
          sw.className = "dg-swatch";
          sw.style.background = c.hex;
          sw.title = c.label;
          sw.addEventListener("click", function () { hideContextMenu(); item.onPick(c.key); });
          row.appendChild(sw);
        });
        contextMenu.appendChild(row);
        return;
      }
      if (item.optionRow) {
        if (item.rowLabel) {
          var lbl = document.createElement("div");
          lbl.className = "dg-style-label";
          lbl.textContent = item.rowLabel;
          contextMenu.appendChild(lbl);
        }
        var row2 = document.createElement("div");
        row2.className = "dg-style-row";
        item.options.forEach(function (opt) {
          var ob = document.createElement("button");
          ob.type = "button";
          ob.className = "dg-style-btn" + (opt.key === item.current ? " active" : "");
          ob.textContent = opt.label;
          ob.addEventListener("click", function () { hideContextMenu(); item.onPick(opt.key); });
          row2.appendChild(ob);
        });
        contextMenu.appendChild(row2);
        return;
      }
      var btn = document.createElement("button");
      btn.type = "button";
      btn.textContent = item.label;
      if (item.danger) btn.className = "danger";
      btn.addEventListener("click", function () {
        hideContextMenu();
        item.action();
      });
      contextMenu.appendChild(btn);
    });
    var rect = wrap.getBoundingClientRect();
    contextMenu.style.left = (clientX - rect.left) + "px";
    contextMenu.style.top = (clientY - rect.top) + "px";
    contextMenu.hidden = false;
  }

  wrap.addEventListener("contextmenu", function (e) {
    e.preventDefault();
    var nodeEl = e.target.closest(".dg-node");
    var edgeEl = !nodeEl && e.target.closest(".dg-edge");
    if (nodeEl) {
      var id = nodeEl.dataset.id;
      var node = nodeById(id);
      if (!node) { hideContextMenu(); return; }
      if (!selectedNodeIds.has(id)) selectNodesOnly([id]);
      var items = [
        { label: "Duplicate", action: duplicateSelection },
        { label: "To Front", action: function () { reorderSelected(true); } },
        { label: "To Back", action: function () { reorderSelected(false); } }
      ];
      if (node.type !== "container") {
        items.push("separator");
        items.push({ swatches: true, onPick: setSelectionColor });
      }
      if (selectedNodeIds.size >= 2) items.push({ label: "Group", action: function () { groupBtn.click(); } });
      if (node.groupId) items.push({ label: "Ungroup", action: function () { ungroupBtn.click(); } });
      items.push("separator");
      items.push({ label: "Delete", danger: true, action: deleteSelection });
      showContextMenu(items, e.clientX, e.clientY);
    } else if (edgeEl) {
      var eid = edgeEl.dataset.id;
      selectEdgeOnly(eid);
      var edge = edgeById(eid);
      if (!edge) { hideContextMenu(); return; }
      var edgeItems = [
        {
          optionRow: true, rowLabel: "Line", current: edge.lineStyle || "solid",
          options: [{ key: "solid", label: "Solid" }, { key: "dashed", label: "Dashed" }],
          onPick: function (key) { setEdgeProp(eid, "lineStyle", key); }
        },
        {
          optionRow: true, rowLabel: "Arrow", current: edge.arrowStyle || "one",
          options: [{ key: "one", label: "One-way" }, { key: "both", label: "Both ways" }, { key: "none", label: "No arrow" }],
          onPick: function (key) { setEdgeProp(eid, "arrowStyle", key); }
        },
        {
          optionRow: true, rowLabel: "Flow", current: edge.flow || "none",
          options: [{ key: "none", label: "Off" }, { key: "dot", label: "Dot" }, { key: "dash", label: "Dash" }],
          onPick: function (key) { setEdgeProp(eid, "flow", key); }
        }
      ];
      if ((edge.flow || "none") !== "none") {
        edgeItems.push({
          optionRow: true, rowLabel: "Direction", current: edge.flowDirection || "forward",
          options: [{ key: "forward", label: "Forward" }, { key: "alternate", label: "Back and forth" }],
          onPick: function (key) { setEdgeProp(eid, "flowDirection", key); }
        });
      }
      edgeItems.push("separator");
      edgeItems.push({ label: "Delete", danger: true, action: deleteSelection });
      showContextMenu(edgeItems, e.clientX, e.clientY);
    } else {
      hideContextMenu();
    }
  });
  document.addEventListener("pointerdown", function (e) {
    if (!contextMenu.hidden && !contextMenu.contains(e.target)) hideContextMenu();
  });
  wrap.addEventListener("wheel", hideContextMenu, { passive: true });

  function isFullscreen() {
    return !!(document.fullscreenElement || document.webkitFullscreenElement);
  }
  function updateFullscreenLabel() {
    fullscreenBtn.textContent = isFullscreen() ? "Exit Fullscreen" : "Fullscreen";
  }
  fullscreenBtn.addEventListener("click", function () {
    if (isFullscreen()) {
      if (document.exitFullscreen) document.exitFullscreen();
      else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
    } else if (dgRoot.requestFullscreen) {
      dgRoot.requestFullscreen();
    } else if (dgRoot.webkitRequestFullscreen) {
      dgRoot.webkitRequestFullscreen();
    }
  });
  document.addEventListener("fullscreenchange", updateFullscreenLabel);
  document.addEventListener("webkitfullscreenchange", updateFullscreenLabel);

  load();
  renderNodes();
  renderEdges();
  applyView();
  updateGroupButtons();
})();
</script>
