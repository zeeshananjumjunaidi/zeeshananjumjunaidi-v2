---
// Each tab is a markup partial in back-of-the-envelope/ plus a same-named .js
// module. index.js wires the render chain; modules only import earlier tabs'
// derive functions, never later ones, so there are no circular imports.
import TrafficTab from "./back-of-the-envelope/TrafficTab.astro";
import StorageTab from "./back-of-the-envelope/StorageTab.astro";
import CacheTab from "./back-of-the-envelope/CacheTab.astro";
import BandwidthTab from "./back-of-the-envelope/BandwidthTab.astro";
import ComputeTab from "./back-of-the-envelope/ComputeTab.astro";
import DatabaseTab from "./back-of-the-envelope/DatabaseTab.astro";
import QueueTab from "./back-of-the-envelope/QueueTab.astro";
import LatencyTab from "./back-of-the-envelope/LatencyTab.astro";
import AvailabilityTab from "./back-of-the-envelope/AvailabilityTab.astro";
import CostTab from "./back-of-the-envelope/CostTab.astro";
import DiagramTab from "./back-of-the-envelope/DiagramTab.astro";
import ExportDialog from "./back-of-the-envelope/ExportDialog.astro";
import ScenarioDialog from "./back-of-the-envelope/ScenarioDialog.astro";
import MetricDialog from "./back-of-the-envelope/MetricDialog.astro";
---

<div class="boe-root">
  <div class="boe-head">
    <div>
      <p class="boe-blurb" id="boeBlurb">Capacity math for system design. Change one assumption and watch it move through the numbers below.</p>
    </div>
    <div class="boe-head-actions">
      <button type="button" id="boeScenarioBtn" class="boe-export-btn">Slots</button>
      <button type="button" id="boeExportBtn" class="boe-export-btn">Export</button>
      <button type="button" id="boeReset" class="boe-reset">Reset</button>
    </div>
  </div>

  <div class="boe-tabs">
    <button type="button" class="boe-tabbtn active" data-tab="traffic">Traffic</button>
    <button type="button" class="boe-tabbtn" data-tab="storage">Storage</button>
    <button type="button" class="boe-tabbtn" data-tab="cache">Cache</button>
    <button type="button" class="boe-tabbtn" data-tab="bandwidth">Bandwidth</button>
    <button type="button" class="boe-tabbtn" data-tab="compute">Compute</button>
    <button type="button" class="boe-tabbtn" data-tab="database">Database</button>
    <button type="button" class="boe-tabbtn" data-tab="queue">Queue</button>
    <button type="button" class="boe-tabbtn" data-tab="latency">Latency</button>
    <button type="button" class="boe-tabbtn" data-tab="availability">Availability</button>
    <button type="button" class="boe-tabbtn" data-tab="cost">Cost</button>
    <button type="button" class="boe-tabbtn" data-tab="diagram">Diagram</button>
  </div>

  <TrafficTab />
  <StorageTab />
  <CacheTab />
  <BandwidthTab />
  <ComputeTab />
  <DatabaseTab />
  <QueueTab />
  <LatencyTab />
  <AvailabilityTab />
  <CostTab />
  <DiagramTab />
  <ExportDialog />
  <ScenarioDialog />
  <MetricDialog />
</div>

<!--
  Global, not scoped: each tab above is now its own Astro component, so it
  renders with its own data-astro-cid-xxxx. A scoped block here would only
  match elements stamped with *this* file's cid, i.e. none of them. See the
  Diagram tab's own style block for why its rules were already global before
  this split (its elements are created at runtime, so they never get a cid
  either).
-->
<style is:global>
.boe-root { font-family: var(--font-mono); color: var(--headline-color); font-size: 14px; }

.boe-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; margin-bottom: 20px; }
.boe-blurb { font-family: var(--font-body); font-weight: 300; font-size: 15px; line-height: 1.7; color: var(--card-desc); max-width: 52ch; margin: 0; }
.boe-head-actions { display: flex; gap: 8px; flex-shrink: 0; }
.boe-reset, .boe-export-btn {
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
  background: transparent; border: 1px solid var(--card-border);
  padding: 6px 12px; cursor: pointer; flex-shrink: 0; transition: border-color .4s ease, color .4s ease;
}
.boe-reset { color: var(--tone-bad); }
.boe-reset:hover { border-color: var(--tone-bad); }
.boe-export-btn { color: var(--card-label); }
.boe-export-btn:hover { border-color: var(--card-label); }

.boe-tabs { display: flex; gap: 4px; margin-bottom: 20px; border-bottom: 1px solid var(--card-border); }
.boe-tabbtn {
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase;
  color: var(--card-desc); background: transparent; border: 0; border-bottom: 2px solid transparent;
  padding: 8px 4px; margin-bottom: -1px; cursor: pointer; transition: color .3s ease, border-color .3s ease;
}
.boe-tabbtn + .boe-tabbtn { margin-left: 18px; }
.boe-tabbtn:hover { color: var(--headline-color); }
.boe-tabbtn.active { color: var(--card-label); border-bottom-color: var(--card-label); }
/* Diagram is a different kind of tool from the numeric calculators before
   it (a canvas, not a form), set apart with a divider rather than blending
   into the same run of tabs. */
.boe-tabbtn[data-tab="diagram"] { margin-left: 30px; position: relative; }
.boe-tabbtn[data-tab="diagram"]::before {
  content: ""; position: absolute; left: -16px; top: 4px; bottom: 6px; width: 1px; background: var(--card-border);
}

/* Eleven tabs never fit a phone, and a flex item cannot shrink past its
   min-content, so this row used to widen the whole page instead. Below the
   width where they stop fitting it becomes a strip you swipe.
   margin-bottom goes to 0 because overflow-x also makes overflow-y a
   scroll container, and the -1px pull onto the hairline would otherwise
   register as vertical overflow and add a second scrollbar. The active
   underline then sits directly on the hairline rather than over it. */
@media (max-width: 940px) {
  .boe-tabs { overflow-x: auto; overflow-y: hidden; scrollbar-width: none; }
  .boe-tabs::-webkit-scrollbar { display: none; }
  .boe-tabbtn { flex: 0 0 auto; margin-bottom: 0; }
  .boe-tabbtn + .boe-tabbtn { margin-left: 14px; }
  .boe-tabbtn[data-tab="diagram"] { margin-left: 26px; }
}

.boe-grid { display: grid; grid-template-columns: 1fr; gap: 16px; }
@media (min-width: 860px) { .boe-grid { grid-template-columns: 1fr 1fr; align-items: start; } }

.boe-panel {
  background: var(--card-bg); border: 1px solid var(--card-border);
  padding: 16px 18px; margin-bottom: 14px;
}
.boe-panel-title {
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--card-desc); margin: 0 0 14px;
}

/* [hidden] and .boe-field tie on specificity, and author styles beat the UA
   stylesheet in that tie -- same class of bug as the diagram context menu
   below. Gate display on :not([hidden]) so the "linked" toggle's manual
   field actually disappears instead of always rendering. */
.boe-field { margin-bottom: 14px; }
.boe-field:not([hidden]) { display: block; }
.boe-label, .boe-label-row {
  display: flex; justify-content: space-between; align-items: baseline;
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--card-desc); margin-bottom: 5px;
}
.boe-unit { color: var(--card-desc); opacity: 0.8; }
.boe-slide-val { font-family: var(--font-mono); font-size: 13px; color: var(--card-label); text-transform: none; letter-spacing: 0; }
.boe-inp {
  width: 100%; background: transparent; border: 0; border-bottom: 1px solid var(--card-border);
  padding: 5px 2px; color: var(--card-label); font-family: var(--font-mono); font-size: 14px;
  outline: none; border-radius: 0;
}
.boe-inp:focus { border-bottom-color: var(--card-label); }
.boe-range { width: 100%; accent-color: var(--card-label); }
.boe-hint { display: block; margin-top: 5px; font-family: var(--font-body); font-size: 12px; font-style: italic; color: var(--card-desc); }
.boe-num-preview {
  display: block; margin-top: 4px; font-family: var(--font-mono); font-size: 11.5px;
  color: var(--card-label); opacity: 0.85; font-variant-numeric: tabular-nums;
}
.boe-num-preview:empty { display: none; }

.boe-out { padding: 8px 0; border-bottom: 1px solid var(--card-border); }
.boe-out:last-child { border-bottom: 0; }
.boe-out-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; font-family: var(--font-body); font-size: 13px; }
.boe-out-val { font-family: var(--font-mono); font-size: 15px; font-weight: 500; color: var(--card-label); white-space: nowrap; font-variant-numeric: tabular-nums; }
.boe-out-unit { font-size: 11px; color: var(--card-desc); margin-left: 3px; }
.boe-out-big .boe-out-row { font-size: 14px; }
.boe-out-big .boe-out-val { font-size: 24px; font-weight: 600; padding-bottom: 2px; border-bottom: 3px double var(--card-label); }
.boe-out-val.tone-bad { color: var(--tone-bad); }
.boe-out-big .boe-out-val.tone-bad { border-bottom-color: var(--tone-bad); }
.boe-out-val.tone-ok { color: var(--tone-ok); }
.boe-out-big .boe-out-val.tone-ok { border-bottom-color: var(--tone-ok); }
.boe-formula { font-family: var(--font-mono); font-size: 11px; color: var(--card-desc); opacity: 0.85; margin-top: 4px; }
.boe-sub { font-family: var(--font-body); font-size: 11.5px; color: var(--card-desc); margin-top: 2px; }
.boe-sub:empty { display: none; }

.boe-table-wrap { overflow-x: auto; }
.boe-table { width: 100%; border-collapse: collapse; font-family: var(--font-mono); font-size: 12px; }
.boe-table th {
  text-align: left; padding: 6px 8px; font-size: 10px; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--card-desc); border-bottom: 1px solid var(--card-border); white-space: nowrap;
}
.boe-table td { padding: 6px 8px; border-bottom: 1px solid var(--card-border); color: var(--headline-color); font-variant-numeric: tabular-nums; }
.boe-table tr:last-child td { border-bottom: 0; }

.boe-learn {
  border-left: 3px solid var(--tone-bad); background: color-mix(in srgb, var(--tone-bad) 6%, transparent);
  padding: 14px 16px; margin-bottom: 14px;
}
.boe-learn-label { font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--tone-bad); margin-bottom: 8px; }
.boe-learn p { font-family: var(--font-body); font-weight: 300; font-size: 13.5px; line-height: 1.7; color: var(--headline-color); margin: 0 0 10px; }
.boe-learn p:last-child { margin-bottom: 0; }

.boe-flag {
  font-family: var(--font-body); font-size: 12.5px; line-height: 1.6; color: var(--tone-bad);
  border: 1px dashed var(--tone-bad); padding: 10px 14px; margin: 8px 0; display: none;
}
.boe-flag.on { display: block; }
.boe-flag-ok { color: var(--tone-ok); border-color: var(--tone-ok); }

.boe-toggle { display: flex; align-items: center; gap: 8px; margin-bottom: 14px; cursor: pointer; width: fit-content; }
.boe-toggle input { position: absolute; opacity: 0; width: 0; height: 0; }
.boe-toggle-track {
  width: 30px; height: 16px; border: 1px solid var(--card-border); border-radius: 8px;
  position: relative; flex-shrink: 0; transition: background .15s ease, border-color .15s ease;
}
.boe-toggle-thumb {
  position: absolute; top: 2px; left: 2px; width: 10px; height: 10px; border-radius: 50%;
  background: var(--card-desc); transition: transform .15s ease, background .15s ease;
}
.boe-toggle input:checked + .boe-toggle-track { border-color: var(--card-label); background: color-mix(in srgb, var(--card-label) 15%, transparent); }
.boe-toggle input:checked + .boe-toggle-track .boe-toggle-thumb { transform: translateX(12px); background: var(--card-label); }
.boe-toggle-label {
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--card-desc);
}
.boe-toggle input:checked ~ .boe-toggle-label { color: var(--headline-color); }

.boe-linked-note {
  font-family: var(--font-mono); font-size: 12px; color: var(--card-label);
  background: color-mix(in srgb, var(--card-label) 8%, transparent); border-left: 2px solid var(--card-label);
  padding: 8px 10px; margin-bottom: 14px;
}

/* Latency tab's hop list -- the only tab with a dynamic (add/remove) row
   set rather than fixed fields. */
.boe-hop-row { display: flex; align-items: center; gap: 8px; padding: 7px 0; border-bottom: 1px solid var(--card-border); transition: opacity .2s ease; }
.boe-hop-row.off { opacity: 0.4; }
.boe-hop-check { accent-color: var(--card-label); flex-shrink: 0; }
.boe-hop-name, .boe-hop-num {
  background: transparent; border: 0; border-bottom: 1px solid var(--card-border); color: var(--card-label);
  padding: 3px 2px; outline: none; border-radius: 0;
}
.boe-hop-name:focus, .boe-hop-num:focus { border-bottom-color: var(--card-label); }
.boe-hop-name { flex: 1 1 auto; min-width: 0; font-family: var(--font-body); font-size: 12.5px; }
.boe-hop-num { width: 48px; flex-shrink: 0; font-family: var(--font-mono); font-size: 12px; text-align: right; }
.boe-hop-x, .boe-hop-unit { font-family: var(--font-mono); font-size: 10.5px; color: var(--card-desc); flex-shrink: 0; }
.boe-hop-del {
  flex-shrink: 0; background: transparent; border: 0; color: var(--tone-bad);
  font-family: var(--font-mono); font-size: 16px; line-height: 1; cursor: pointer; padding: 2px 4px;
}
.boe-hop-del:hover { opacity: 0.7; }
.boe-hop-add {
  display: block; width: 100%; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--card-label); background: transparent; border: 1px dashed var(--card-border);
  padding: 7px 10px; margin: 10px 0 14px; cursor: pointer; transition: border-color .2s ease;
}
.boe-hop-add:hover { border-color: var(--card-label); }
</style>

<script>
  import "./back-of-the-envelope/index.js";
</script>
