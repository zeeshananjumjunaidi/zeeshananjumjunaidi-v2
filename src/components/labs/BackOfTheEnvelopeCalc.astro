    toggle("flag-cache-lowhit", d.peakReadRps > 0 && d.hitRatio < 0.5);
    toggle("flag-cache-fleet", d.nodes > 20);

    renderBandwidth(); // Bandwidth's linked peak RPS depends on Traffic, independent of Cache/Storage.
  }

  var BANDWIDTH_DEFAULTS = { bwReads: "6000", bwWrites: "60", respBytes: "5120", reqBytes: "1024", cdnPct: "60", bwOverhead: "1.15" };
  var bandwidthIds = ["bwReads", "bwWrites", "respBytes", "reqBytes", "cdnPct", "bwOverhead"];
