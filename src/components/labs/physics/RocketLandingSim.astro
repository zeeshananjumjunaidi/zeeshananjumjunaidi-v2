    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--card-desc); margin-bottom: 5px;
  }
  .rl-field-label b { font-family: var(--font-mono); font-size: 12px; color: var(--card-label); font-weight: 500; text-transform: none; letter-spacing: 0; }

  .rl-hint {
    margin: 8px 0 0;
    font-size: 11px;
    line-height: 1.5;
    color: var(--card-desc);
  }

  input[type="range"] { width: 100%; accent-color: var(--card-label); }
  input[type="range"]:disabled { opacity: 0.35; cursor: not-allowed; }
  select {
    width: 100%;
    background: transparent;
    color: var(--headline-color);
    border: 1px solid var(--card-border);
    border-radius: 6px;
    padding: 6px 8px;
    font: inherit;
    font-size: 13px;
  }
  .rl-cbtn {
    display: block;
