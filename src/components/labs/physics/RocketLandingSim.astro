<div class="sim-root">
  <div class="sim-main">
    <div class="panel">
      <h2>Descent camera</h2>
      <canvas id="scene"></canvas>
    </div>

    <div class="controls">
      <div class="group">
        <span class="tag">throttle</span>
        <div class="ctl">
          <input id="throttle" type="range" min="0" max="100" value="0" />
          <span class="val" id="throttleV">0%</span>
        </div>
      </div>
      <button id="reset">Reset run</button>
    </div>

    <div class="hud">
      <span>altitude <b id="alt">0</b> m</span>
      <span>vertical speed <b id="vspeed">0</b> m/s</span>
      <span>fuel <b id="fuel">100</b>%</span>
    </div>
  </div>
</div>

<script>
  import * as THREE from "three";

  var canvas = document.getElementById("scene");
  var scene = new THREE.Scene();
  var camera = new THREE.PerspectiveCamera(50, 1, 0.1, 2000);
  var renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true });

  // -- your rocket, your gravity/thrust/drag integration, your camera rig --
  // this is the part you're building yourself

  function tick() {
    requestAnimationFrame(tick);
    // step physics, update rocket.position, render
    renderer.render(scene, camera);
  }
  tick();
</script>

<style>
  .sim-root {
    margin: 0;
    background: transparent;
    color: var(--headline-color);
    font-family: var(--font-mono);
    font-size: 15px;
    line-height: 1.6;
  }
  .sim-main {
    max-width: 1240px;
    margin: 0 auto;
  }

  .panel {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 10px;
    padding: 12px;
  }
  .panel h2 {
    font-size: 12px;
    font-weight: 600;
    margin: 0 0 8px;
    color: var(--card-desc);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  /* the instrument screen itself -- constant, not themed */
  canvas {
    width: 100%;
    aspect-ratio: 16/10;
    display: block;
    border-radius: 6px;
    background: #05070c;
  }

  .controls {
    display: flex;
    gap: 14px 26px;
    flex-wrap: wrap;
    align-items: center;
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 10px;
    padding: 14px 18px;
    margin-top: 16px;
    font-size: 13px;
  }
  input[type="range"] {
    accent-color: var(--card-label);
  }
  button {
    background: transparent;
    color: var(--headline-color);
    border: 1px solid var(--card-border);
    border-radius: 6px;
    padding: 6px 14px;
    font: inherit;
    cursor: pointer;
  }
  button:hover {
    border-color: var(--card-label);
  }
  .hud {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    margin-top: 12px;
    font-size: 13px;
    color: var(--card-desc);
  }
  .hud b {
    color: var(--headline-color);
  }
</style>
