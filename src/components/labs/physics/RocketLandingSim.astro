     comes to ~273px of panel against a 288px canvas on a 360px phone: they
     touch. Dropping to 10px text with a tighter row gap and 6px corner
     offsets brings the pair to ~246px, which clears even a 320px screen. */
  @media (max-width: 420px) {
    .rl-hudpanel { font-size: 10px; padding: 5px 8px; }
    .rl-hud-k { font-size: 9px; }
    .rl-hud-v { font-size: 15px; }
    .rl-hud-row { gap: 8px; margin-top: 4px; font-size: 10px; }
    .rl-hud-tl { top: 6px; left: 6px; }
    .rl-hud-tr { top: 6px; right: 6px; }
    .rl-hud-bl { bottom: 6px; left: 6px; }
    .rl-instruments { right: 6px; bottom: 6px; }
  }

  .rl-verdict {
    position: absolute; inset: auto 0 0 0;
    background: color-mix(in srgb, var(--card-bg) 92%, transparent);
    border-top: 1px solid var(--card-border);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    padding: 14px 16px;
  }
  .rl-verdict-title {
    display: block; font-size: 15px; font-weight: 600; margin-bottom: 8px; color: var(--headline-color);
  }
  .rl-verdict-title.tone-ok { color: var(--tone-ok); }
  .rl-verdict-title.tone-bad { color: var(--tone-bad); }
  .rl-verdict-row {
    display: flex; justify-content: space-between; gap: 12px; font-size: 12.5px;
    padding: 3px 0; color: var(--card-desc); font-family: var(--font-mono);
  }
  .rl-verdict-row b { font-variant-numeric: tabular-nums; }
  .rl-verdict-row b.tone-ok { color: var(--tone-ok); }
  .rl-verdict-row b.tone-bad { color: var(--tone-bad); }

  /* ---- control panels below the viewport ---- */
  .rl-cpanels {
