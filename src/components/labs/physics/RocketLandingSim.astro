---
// Each cell is a quantity the physics computes, shown with its formula.
const CELLS = [
  { id: "mass", k: "Vehicle mass", f: "m_dry + propellant" },
  { id: "twr", k: "Thrust-to-weight", f: "T / (m·g)" },
  { id: "amax", k: "Available accel", f: "T_max / m" },
  { id: "dv", k: "Δv remaining", f: "I_sp·g₀·ln(m₀/m_dry)" },
  { id: "q", k: "Dynamic pressure", f: "½·ρ(h)·v²" },
  { id: "acmd", k: "Commanded accel", f: "|a_cmd| from the guidance law" },
  { id: "kappa", k: "Burn trigger κ", f: "(v² − v_t²) / (2·a·h) — light at 1.00" },
  { id: "zem", k: "Zero-effort miss", f: "r_f − (r + v·t_go + ½g·t_go²)" },
  { id: "vref", k: "Reference rate", f: "−√(v_t² + 2·a_dec·h)" },
  { id: "peak", k: "Peak load", f: "max T/(m·g₀) so far" },
  { id: "fin", k: "Grid fin δ", f: "commanded deflection, ±20° limit" },
  { id: "finq", k: "Fin authority", f: "q·S·C_L,α·L_fin / I — zero without air" }
];

// Planned outline for the Concepts tab. Numbered because it is genuinely
// a sequence: each rung assumes the one before it and nothing after it.
// A topic is plain text until something exists behind it, at which point it
// carries an href. The ladder is written a rung at a time, so most stay text.
type Topic = string | { t: string; href: string };
const CONCEPTS: { level: string; blurb: string; topics: Topic[] }[] = [
  {
    level: "Foundations",
    blurb: "The vocabulary, from a standing start. No control theory assumed.",
    topics: [
      "Reference frames, and why mixing them causes most flight-software bugs",
      "State vectors: choosing what to track",
      "Newton's laws in three axes",
      { t: "Mass as a state, not a constant", href: "/writing/tsiolkovsky-rocket-equation" },
      "Reading a free-body diagram"
    ]
  },
  {
    level: "Working knowledge",
    blurb: "Enough to build something that flies, and to work out why it misbehaves.",
    topics: [
      "Rigid-body rotation and moment of inertia",
      "Drag, dynamic pressure, and an atmosphere that changes by orders of magnitude",
      "PID, and why a lander leaves out the I",
      "Actuator limits: position, rate, and saturation",
      "Numerical integration: Euler, RK4, and fixed versus adaptive steps"
    ]
  },
  {
    level: "Going deeper",
    blurb: "Where the real decisions are, and the standard answers to them.",
    topics: [
      "Cascade control and timescale separation",
      "Control allocation across two actuators",
      "Terminal guidance: deriving ZEM/ZEV rather than quoting it",
      "The throttle floor, and why it makes the problem non-convex",
      "Lossless convexification",
      "Running trajectory optimisation onboard, in real time"
    ]
  }
];
---

<div class="sim-root">
  <div class="sim-main">
    <div class="rl-tabs">
      <button type="button" class="rl-tabbtn active" data-tab="simulator">Simulator</button>
      <button type="button" class="rl-tabbtn" data-tab="concepts">Concepts</button>
      <a class="rl-articlelink" href="/writing/landing-a-booster">Read the article</a>
    </div>

    <div class="rl-tab" data-tab="simulator" id="rlStage">
      <div class="panel">
        <div class="rl-panelhead">
          <h2>Descent camera</h2>
          <button type="button" class="rl-cbtn rl-fullbtn" id="rlFull" title="Maximize" aria-label="Maximize">
            <svg class="rl-fullicon" id="rlFullEnter" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M3 7.5V3h4.5M12.5 3H17v4.5M17 12.5V17h-4.5M7.5 17H3v-4.5" />
            </svg>
            <svg class="rl-fullicon" id="rlFullExit" viewBox="0 0 20 20" aria-hidden="true" hidden>
              <path d="M7.5 3v4.5H3M17 7.5h-4.5V3M12.5 17v-4.5H17M3 12.5h4.5V17" />
            </svg>
          </button>
        </div>
        <div class="rl-viewport">
          <canvas id="scene"></canvas>

          <div class="rl-phasechip" id="phaseChip">Coasting</div>

          <div class="rl-hudpanel rl-hud-tl">
            <span class="rl-hud-k">Altitude</span>
            <span class="rl-hud-v" id="alt">900</span>
            <div class="rl-hud-row"><span>Vertical</span><b id="vspeed">-85.0</b></div>
            <div class="rl-hud-row"><span>Lateral</span><b id="lateral">190</b></div>
          </div>

          <div class="rl-hudpanel rl-hud-tr">
            <span class="rl-hud-k">Propellant</span>
            <span class="rl-hud-v" id="fuel">100%</span>
            <div class="rl-hud-row"><span>Gimbal</span><b id="gimbalHud">0.0&deg; / 0.0&deg;</b></div>
            <div class="rl-hud-row"><span>Fins</span><b id="finHud">0.0&deg; / 0.0&deg;</b></div>
            <div class="rl-hud-row"><span>RCS</span><b id="rcsHud">off</b></div>
          </div>

          <div class="rl-hudpanel rl-hud-bl">
            <div class="rl-hud-row"><span>T+</span><b id="tplus">0.0 s</b></div>
            <div class="rl-hud-row"><span>Time to go</span><b id="tgoHud">&ndash;&ndash;</b></div>
            <div class="rl-hud-row" id="rateRow" hidden><span>Rate</span><b id="rateHud">1&times;</b></div>
          </div>

          <div class="rl-hudpanel rl-hud-br" id="camNameHud">Orbit</div>

          <!-- Flight instruments. The two things you actually fly with:
               where the vehicle is pointing, and how hard it is pushing. -->
          <div class="rl-instruments" id="instruments">
            <div class="rl-inst">
              <svg class="rl-att" viewBox="0 0 100 100" aria-hidden="true">
                <circle class="rl-att-safe-fill" id="attSafeFill" cx="50" cy="50" r="14" />
                <circle class="rl-att-max" cx="50" cy="50" r="44" />
                <circle class="rl-att-lim" id="attLimRing" cx="50" cy="50" r="44" />
                <circle class="rl-att-safe" id="attSafeRing" cx="50" cy="50" r="14" />
                <path class="rl-att-tick" d="M50 6 V12 M50 88 V94 M6 50 H12 M88 50 H94" />
                <line class="rl-att-err" id="attErr" x1="50" y1="50" x2="50" y2="50" />
                <g class="rl-att-cmd" id="attCmd" transform="translate(50 50)">
                  <circle r="9" />
                  <path d="M-13 0 H-6 M6 0 H13 M0 -13 V-6 M0 6 V13" />
                </g>
                <circle class="rl-att-dot" id="attDot" cx="50" cy="50" r="4.6" />
              </svg>
              <span class="rl-inst-v" id="tiltHud">0.0&deg;</span>
              <span class="rl-inst-k">Tilt</span>
            </div>

            <div class="rl-inst">
              <svg class="rl-thr" viewBox="0 0 26 100" aria-hidden="true">
                <defs>
                  <pattern id="rlHatch" width="4" height="4" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                    <line class="rl-thr-hatchline" x1="0" y1="0" x2="0" y2="4" />
                  </pattern>
                </defs>
                <rect class="rl-thr-track" x="7" y="6" width="12" height="88" rx="2" />
                <rect class="rl-thr-dead" id="thrDead" x="7" width="12" fill="url(#rlHatch)" />
                <rect class="rl-thr-fill" id="thrFill" x="7" width="12" rx="2" />
                <line class="rl-thr-min" id="thrMin" x1="3" x2="23" />
                <line class="rl-thr-hover" id="thrHover" x1="1" x2="25" />
                <rect class="rl-thr-frame" x="7" y="6" width="12" height="88" rx="2" />
              </svg>
              <span class="rl-inst-v" id="throttleV">0%</span>
              <span class="rl-inst-k">Throttle</span>
            </div>

            <div class="rl-keys" id="keyLegend">
              <div class="rl-keyrow"><kbd>W</kbd><kbd>S</kbd><span>thrust</span></div>
              <div class="rl-keyrow"><kbd>A</kbd><kbd>D</kbd><span>lean X</span></div>
              <div class="rl-keyrow"><kbd>Q</kbd><kbd>E</kbd><span>lean Z</span></div>
            </div>
          </div>

          <div class="rl-verdict" id="verdict" hidden>
            <span class="rl-verdict-title" id="verdictTitle">Landed</span>
            <div class="rl-verdict-row"><span>Vertical speed</span><b id="vVy">--</b></div>
            <div class="rl-verdict-row"><span>Lateral speed</span><b id="vVh">--</b></div>
            <div class="rl-verdict-row"><span>Tilt at touchdown</span><b id="vTilt">--</b></div>
            <div class="rl-verdict-row"><span>Miss distance</span><b id="vMiss">--</b></div>
          </div>
        </div>
      </div>

      <div class="rl-drawer-wrap" id="rlDrawerWrap">
        <button type="button" class="rl-drawer-handle" id="rlStatsToggle" aria-expanded="false" aria-controls="rlDrawer">Stats &amp; controls</button>
        <div class="rl-drawer" id="rlDrawer">
      <div class="rl-cpanels">
        <div class="rl-cpanel">
          <h3>Flight</h3>
          <button id="autopilot" class="rl-cbtn active">Autopilot: On</button>
          <div class="rl-field">
            <span class="rl-field-label">Manual throttle</span>
            <input id="throttle" type="range" min="0" max="100" value="0" disabled />
          </div>
          <p class="rl-hint">Manual: <kbd>W</kbd>/<kbd>S</kbd> throttle &middot; <kbd>A</kbd>/<kbd>D</kbd> steer X &middot; <kbd>Q</kbd>/<kbd>E</kbd> steer Z</p>
          <div class="rl-field">
            <span class="rl-field-label">Guidance law</span>
            <select id="guidance">
              <option value="zemzev">ZEM/ZEV</option>
              <option value="profile">Decel. profile + PD</option>
            </select>
          </div>
          <div class="rl-field">
            <span class="rl-field-label">Sim rate <b id="rateV">1&times;</b></span>
            <div class="rl-camrow">
              <button type="button" class="rl-ratebtn" data-rate="0.1">0.1&times;</button>
              <button type="button" class="rl-ratebtn" data-rate="0.25">&frac14;&times;</button>
              <button type="button" class="rl-ratebtn" data-rate="0.5">&frac12;&times;</button>
              <button type="button" class="rl-ratebtn active" data-rate="1">1&times;</button>
              <button type="button" class="rl-ratebtn" data-rate="2">2&times;</button>
              <button type="button" class="rl-ratebtn" data-rate="4">4&times;</button>
            </div>
          </div>
          <button id="reset" class="rl-cbtn">Reset run</button>
        </div>

        <div class="rl-cpanel">
          <h3>Conditions</h3>
          <div class="rl-field">
            <span class="rl-field-label">World</span>
            <select id="world">
              <option value="earth">Earth</option>
              <option value="mars">Mars</option>
              <option value="moon">Moon</option>
            </select>
          </div>
          <div class="rl-field">
            <span class="rl-field-label">Entry state</span>
            <select id="scenario">
              <option value="nominal">Nominal return</option>
              <option value="hifast">High and fast</option>
              <option value="offset">Off-target divert</option>
              <option value="late">Late start</option>
              <option value="upset">Upset attitude</option>
            </select>
          </div>
          <div class="rl-field">
            <span class="rl-field-label">Wind <b id="windV">0 m/s</b></span>
            <input id="wind" type="range" min="0" max="25" step="1" value="0" />
          </div>
        </div>

        <div class="rl-cpanel">
          <h3>View</h3>
          <div class="rl-camrow">
            <button type="button" class="rl-cambtn" data-cam="chase">Chase</button>
            <button type="button" class="rl-cambtn" data-cam="pad">Pad</button>
            <button type="button" class="rl-cambtn active" data-cam="orbit">Orbit</button>
            <button type="button" class="rl-cambtn" data-cam="side">Side</button>
          </div>
        </div>
      </div>

      <div class="rl-readout">
        {CELLS.map((c) => (
          <div class="rl-cell">
            <div class="rl-cell-k">{c.k}</div>
            <div class="rl-cell-v"><span id={`rd-${c.id}`}>&mdash;</span><span class="rl-cell-u" id={`ru-${c.id}`}></span></div>
            <div class="rl-cell-f">{c.f}</div>
          </div>
        ))}
      </div>
        </div>
      </div>
    </div>


    <div class="rl-tab" data-tab="concepts" hidden>
      <div class="rl-cs">
        <header class="rl-cs-head">
          <span class="rl-cs-eyebrow">In progress</span>
          <h2>Concepts, from the ground up</h2>
          <p>
            The Article tab moves fast and assumes you can already read a
            differential equation. This one won't. It is a longer path through
            the same material, starting from what a reference frame is, with
            each idea introduced properly before anything depends on it.
          </p>
          <p class="rl-cs-note">
            The outline below is what it will cover. I am writing it a rung at
            a time, so it will appear in pieces rather than all at once. Rungs that
            are already written link out.
          </p>
        </header>

        <div class="rl-ladder">
          {CONCEPTS.map((c, i) => (
            <section class="rl-rung">
              <div class="rl-rung-head">
                <span class="rl-rung-n">{String(i + 1).padStart(2, "0")}</span>
                <h3>{c.level}</h3>
              </div>
              <p class="rl-rung-blurb">{c.blurb}</p>
              <ul class="rl-rung-list">
                {c.topics.map((t) => (
                  typeof t === "string"
                    ? <li>{t}</li>
                    : <li class="written">
                        <a href={t.href}>{t.t}<span class="rl-rung-tag">Written</span></a>
                      </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  /* three.js and the booster model come to about 1.1MB, and on a phone the
     canvas sits well below the fold behind the title, tags and writeup. Held
     back until the canvas is nearly in view so the page's text renders and
     is interactive without waiting on any of it. A visitor who switches to
     the Article tab first never brings the canvas into view at all, so they
     never pay for the simulator. rootMargin starts the fetch 400px early,
     which on a normal scroll is enough for it to be ready on arrival. */
  await new Promise(function (resolve) {
    var el = document.getElementById("scene");
    if (!el || !("IntersectionObserver" in window)) return resolve();
    var io = new IntersectionObserver(function (entries) {
      for (var i = 0; i < entries.length; i++) {
        if (entries[i].isIntersecting) { io.disconnect(); return resolve(); }
      }
    }, { rootMargin: "400px" });
    io.observe(el);
  });
  var THREE = await import("three");
  var GLTFLoader = (await import("three/examples/jsm/loaders/GLTFLoader.js")).GLTFLoader;

  var canvas = document.getElementById("scene");
  var throttleInput = document.getElementById("throttle");
  var throttleLabel = document.getElementById("throttleV");
  var resetBtn = document.getElementById("reset");
  var autopilotBtn = document.getElementById("autopilot");
  var worldSelect = document.getElementById("world");
  var scenarioSelect = document.getElementById("scenario");
  var guidanceSelect = document.getElementById("guidance");
  var windInput = document.getElementById("wind");
  var windLabel = document.getElementById("windV");
  var camButtons = document.querySelectorAll(".rl-cambtn");
  var rateButtons = document.querySelectorAll(".rl-ratebtn");
  var rateLabel = document.getElementById("rateV");
  var rateHudEl = document.getElementById("rateHud");
  var rateRowEl = document.getElementById("rateRow");
  var altEl = document.getElementById("alt");
  var vspeedEl = document.getElementById("vspeed");
  var fuelEl = document.getElementById("fuel");
  var lateralEl = document.getElementById("lateral");
  var phaseEl = document.getElementById("phaseChip");
  var tiltHudEl = document.getElementById("tiltHud");
  var gimbalHudEl = document.getElementById("gimbalHud");
  var finHudEl = document.getElementById("finHud");
  var rcsHudEl = document.getElementById("rcsHud");
  var instrumentsEl = document.getElementById("instruments");
  var attDotEl = document.getElementById("attDot");
  var attCmdEl = document.getElementById("attCmd");
  var attLimEl = document.getElementById("attLimRing");
  var attSafeEl = document.getElementById("attSafeRing");
  var attSafeFillEl = document.getElementById("attSafeFill");
  var attErrEl = document.getElementById("attErr");
  var thrFillEl = document.getElementById("thrFill");
  var thrDeadEl = document.getElementById("thrDead");
  var thrMinEl = document.getElementById("thrMin");
  var thrHoverEl = document.getElementById("thrHover");
  var tplusEl = document.getElementById("tplus");
  var tgoHudEl = document.getElementById("tgoHud");
  var camNameEl = document.getElementById("camNameHud");
  var verdictEl = document.getElementById("verdict");
  var verdictTitleEl = document.getElementById("verdictTitle");
  var vVyEl = document.getElementById("vVy");
  var vVhEl = document.getElementById("vVh");
  var vTiltEl = document.getElementById("vTilt");
  var vMissEl = document.getElementById("vMiss");

  // Transparent canvas over a CSS gradient sky, so the sky is a per-world
  // custom property rather than a WebGL dome.
  var renderer = new THREE.WebGLRenderer({ canvas: canvas, antialias: true, alpha: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));

  var scene = new THREE.Scene();
  var fog = new THREE.Fog(0xc9d3d6, 500, 3200);
  scene.fog = fog;

  var camera = new THREE.PerspectiveCamera(50, 16 / 10, 0.5, 20000);

  // camTarget tracks the vehicle; each mode just supplies theta/phi/dist.
  var camTarget = new THREE.Vector3(0, 20, 0);
  // Orbit by default: it holds the vehicle at a usable size for the whole
  // descent, where chase frames the vehicle-to-pad span and so only fills
  // the frame near touchdown.
  var camRig = { mode: "orbit", spin: 0, userTheta: 0, userPhi: 0, distMul: 1 };
  // Wall-clock seconds per simulated second. Scales the physics and the
  // plume, not the camera -- the descent is over in ~25 s at 1x, which
  // is too fast to watch the guidance law actually make its decisions.
  var simRate = 1;
  var reducedMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // The article tab's own numbers, same values as its constants table.
  var DEG = Math.PI / 180;
  var STD_G0 = 9.80665; // standard gravity Isp is conventionally referenced to
  var VEH = {
    dry: 22200, fuel0: 5200, maxT: 845000, minThr: 0.4, L: 47, R: 1.85, arm: 16,
    maxGimbal: 15 * DEG, maxTilt: 32 * DEG, gimbalRate: 40 * DEG,
    // Grid-fin geometry (Article §04's own numbers): lift-curve slope,
    // reference area, moment arm from the CoM, and the fin actuator's
    // own (faster, smaller-surface) limits.
    finS: 16, finArm: 14, finCL: 2.0, maxFin: 20 * DEG, finRate: 120 * DEG,
    // Cold-gas RCS in the interstage. Tiny authority next to the gimbal, but
    // it is the only actuator that works with the engine off and no air, so
    // it covers the gap the other two leave high in the coast.
    rcsT: 2500, rcsArm: 19, rcsIsp: 70, n2_0: 45
  };

  // RK4 with zero-order-hold control, ZEM/ZEV terminal guidance driving a PD
  // attitude loop. See the Article tab for the derivations.
  var PHYS = {
    isp: 282, Cd: 0.82, A: Math.PI * VEH.R * VEH.R,
    vTouch: 6, vTarget: 2, tGoFloor: 1, Kp: 2.4, Kd: 5.2, step: 0.02,
    // Throttle slew, fraction per second: a ~0.2 s spool from idle to full.
    spoolRate: 5,
    // Crossrange divert clock (Article §09): kill lateral drift by this
    // altitude, then just descend; the 11 s floor is the article's own
    // number, same vehicle as the reference file.
    hDiv: 45, tLatFloor: 11,
    // Deceleration-profile law (Article §07's "reference profile" --
    // symbolic there, these two numbers are this port's own tuning, not
    // from the source).
    aDec: 12, profileK: 0.8,
    // Article §05's allocation: the fin command is the same PD signal as
    // the gimbal's, just scaled up before its own clamp.
    finGain: 1.4
  };

  // Gravity and atmosphere are looked up per world on every physics step.
  var WORLDS = {
    earth: { name: "Earth", g: 9.807, rho0: 1.225, H: 8500, ground: 0x8d8878, sky: ["#b9c6cf", "#e7e2d6"], fog: 0xc9d3d6 },
    mars: { name: "Mars", g: 3.721, rho0: 0.020, H: 11100, ground: 0xa1603c, sky: ["#c8a98c", "#e6d9c6"], fog: 0xd9c4ab },
    moon: { name: "Moon", g: 1.625, rho0: 0, H: 1, ground: 0x7e7b74, sky: ["#20242c", "#2b2b2c"], fog: 0x25242a }
  };
  function world() { return WORLDS[state.world]; }
  function applyWorldLook() {
    var w = world();
    if (groundMesh) groundMesh.material.color.setHex(w.ground);
    fog.color.setHex(w.fog);
    if (canvas) canvas.style.background = "linear-gradient(" + w.sky[0] + ", " + w.sky[1] + ")";
  }

  // "upset" starts tilted and rotating, to test whether the attitude loop
  // settles before guidance needs real authority.
  var LIMITS = { vy: PHYS.vTouch, vh: 5, tilt: 10 * DEG, miss: 25 };

  var SCENARIOS = {
    nominal: { name: "Nominal return", h: 900, vy: -85, x: 180, vx: -16, z: 60, vz: -6, fuel: 5200 },
    hifast: { name: "High and fast", h: 2400, vy: -190, x: 700, vx: -45, z: -200, vz: 12, fuel: 9000 },
    offset: { name: "Off-target divert", h: 900, vy: -70, x: -320, vx: 5, z: 220, vz: 0, fuel: 7000 },
    late: { name: "Late start", h: 300, vy: -45, x: 45, vx: -4, z: 0, vz: 0, fuel: 5200 },
    upset: { name: "Upset attitude", h: 700, vy: -75, x: 110, vx: -10, z: 0, vz: 0, fuel: 5200, phi: 18 * DEG, wphi: 0.25 }
  };

  function defaultState() {
    var sc = SCENARIOS[scenarioSelect ? scenarioSelect.value : "nominal"] || SCENARIOS.nominal;
    return {
      world: worldSelect ? worldSelect.value : "earth",
      x: sc.x, y: sc.h, z: sc.z,
      vx: sc.vx, vy: sc.vy, vz: sc.vz,
      phi: sc.phi || 0, psi: sc.psi || 0, wphi: sc.wphi || 0, wpsi: sc.wpsi || 0,
      fuel: sc.fuel,
      fuel0: sc.fuel, // scenarios start with different loads; the gauge is relative to this one
      thrFrac: 0,
      phase: "falling", // falling | landed | crashed
      ignited: false,
      autopilot: true,
      thrustFrac: 0, defPhi: 0, defPsi: 0, finPhi: 0, finPsi: 0, // last-applied control, for the visuals
      rcsPhi: 0, rcsPsi: 0, n2: VEH.n2_0,
      cmdPhi: 0, cmdPsi: 0, // attitude the controller is ASKING for -- the flight director needle
      // Guidance internals, surfaced for the flight strip. Null until the
      // autopilot has actually run a cycle -- in manual there is no
      // guidance law, so these stay null and the cells read as dashes.
      gKappa: null, gVref: null, gAcmd: null, gZem: null, peakG: 0,
      tPlus: 0, tGo: null, cut: false,
      verdict: null
    };
  }
  var state = defaultState();

  var rocket, placeholder, nozzleGroup, nozzleBell, glowSprite, plumeLight, groundMesh, legParts = [];
  var modelMixer, modelActions = [];
  // Offset between the rocket group's origin and the pad. Overwritten from
  // the model's own bounds once it loads.
  var LEG_SPLAY = 30 * DEG;
  var LEG_FOLD = -90 * DEG;
  var restY = VEH.arm - 2.2 + 11 * Math.cos(LEG_SPLAY);

  function buildLights() {
    var hemi = new THREE.HemisphereLight(0xffffff, 0x8d8878, 0.95);
    scene.add(hemi);
    var sun = new THREE.DirectionalLight(0xfff6e8, 1.6);
    sun.position.set(-300, 420, 260);
    scene.add(sun);
    // World-space so it can light the ground from the nozzle; parenting it
    // to the vehicle would carry it along without ever illuminating what
    // the plume is actually pointed at.
    plumeLight = new THREE.PointLight(0xff7a2a, 0, 900, 2);
    scene.add(plumeLight);
  }

  function buildGround() {
    groundMesh = new THREE.Mesh(
      new THREE.PlaneGeometry(20000, 20000),
      new THREE.MeshStandardMaterial({ color: world().ground, roughness: 1, metalness: 0 })
    );
    groundMesh.rotation.x = -Math.PI / 2;
    groundMesh.position.y = -0.4;
    scene.add(groundMesh);

    var pad = new THREE.Mesh(
      new THREE.CircleGeometry(43, 64),
      new THREE.MeshStandardMaterial({ color: 0x30302c, roughness: 0.95 })
    );
    pad.rotation.x = -Math.PI / 2;
    pad.position.y = 0.05;
    scene.add(pad);

    var padRing = new THREE.Mesh(
      new THREE.RingGeometry(41, 43, 64),
      new THREE.MeshBasicMaterial({ color: 0xe8e2d4, side: THREE.DoubleSide })
    );
    padRing.rotation.x = -Math.PI / 2;
    padRing.position.y = 0.08;
    scene.add(padRing);

    var successRing = new THREE.Mesh(
      new THREE.RingGeometry(LIMITS.miss - 0.6, LIMITS.miss, 64),
      new THREE.MeshBasicMaterial({ color: 0xb8431f, side: THREE.DoubleSide, transparent: true, opacity: 0.85 })
    );
    successRing.rotation.x = -Math.PI / 2;
    successRing.position.y = 0.1;
    scene.add(successRing);

    applyWorldLook();
  }

  // Primitive stand-in, hidden once the GLB loads. The nozzle is its own
  // group so gimbal rotation moves the engine, not the airframe.
  function buildRocket() {
    rocket = new THREE.Group();
    scene.add(rocket);
    placeholder = new THREE.Group();
    rocket.add(placeholder);

    var white = new THREE.MeshStandardMaterial({ color: 0xdedad0, roughness: 0.55, metalness: 0.15 });
    var dark = new THREE.MeshStandardMaterial({ color: 0x24231f, roughness: 0.7, metalness: 0.3 });
    var soot = new THREE.MeshStandardMaterial({ color: 0x151412, roughness: 0.9 });

    var bodyH = VEH.L - 6;
    var body = new THREE.Mesh(new THREE.CylinderGeometry(VEH.R, VEH.R, bodyH, 36), white);
    body.position.y = bodyH / 2 - VEH.arm + 3;
    placeholder.add(body);

    var sootBand = new THREE.Mesh(new THREE.CylinderGeometry(VEH.R * 1.005, VEH.R * 1.005, 13, 36, 1, true), soot);
    sootBand.position.y = -VEH.arm + 8;
    placeholder.add(sootBand);

    var inter = new THREE.Mesh(new THREE.CylinderGeometry(VEH.R, VEH.R, 3.2, 36), dark);
    inter.position.y = bodyH - VEH.arm + 4.6;
    placeholder.add(inter);

    for (var i = 0; i < 4; i++) {
      var fin = new THREE.Group();
      var blade = new THREE.Mesh(new THREE.BoxGeometry(0.35, 3.6, 2.6), dark);
      blade.position.set(VEH.R + 1.3, 0, 0);
      fin.add(blade);
      fin.position.y = bodyH - VEH.arm - 0.5;
      fin.rotation.y = (i * Math.PI) / 2;
      placeholder.add(fin);
    }

    var bay = new THREE.Mesh(new THREE.CylinderGeometry(VEH.R, VEH.R * 0.86, 3.4, 36), dark);
    bay.position.y = -VEH.arm + 1.5;
    placeholder.add(bay);

    for (var j = 0; j < 4; j++) {
      // Two levels: a leg at local (0,y,0) sits on the Y axis, so rotating one
      // pivot around Y is a no-op and all four legs land on top of each other.
      // The mount carries the azimuth, the hinge the fold.
      var mount = new THREE.Group();
      mount.position.set(0, -VEH.arm + 2.2, 0);
      mount.rotation.y = (j * Math.PI) / 2 + Math.PI / 4;
      placeholder.add(mount);

      var hinge = new THREE.Group();
      hinge.position.set(VEH.R, 0, 0);
      mount.add(hinge);

      var leg = new THREE.Mesh(new THREE.CylinderGeometry(0.36, 0.5, 11, 10), dark);
      leg.position.set(0, -5.5, 0);
      hinge.add(leg);
      var foot = new THREE.Mesh(new THREE.CylinderGeometry(1.3, 1.3, 0.5, 12), soot);
      foot.position.set(0, -11, 0);
      hinge.add(foot);
      legParts.push(hinge);
    }

    nozzleGroup = new THREE.Group();
    nozzleGroup.position.y = -VEH.arm;
    rocket.add(nozzleGroup);
    // The bell is structural, not an effect -- it lives outside
    // `placeholder` only so it can gimbal, so it has to be hidden
    // separately once the real model (which has its own) loads.
    nozzleBell = new THREE.Mesh(
      new THREE.CylinderGeometry(0.85, 1.55, 3.6, 24, 1, true),
      new THREE.MeshStandardMaterial({ color: 0x2a2723, roughness: 0.5, metalness: 0.6, side: THREE.DoubleSide })
    );
    nozzleBell.position.y = -1.6;
    nozzleGroup.add(nozzleBell);

    // No flame cone: the exhaust is the particle plume, an additive glow
    // sprite in the throat, and plumeLight (added to the scene, not the
    // nozzle, so it lights the ground).
    glowSprite = new THREE.Sprite(new THREE.SpriteMaterial({
      color: 0xffc37a, transparent: true, opacity: 0,
      blending: THREE.AdditiveBlending, depthWrite: false
    }));
    glowSprite.position.y = -3.5;
    glowSprite.visible = false;
    nozzleGroup.add(glowSprite);

    loadRocketModel();

    // Position/rotation are driven every frame from `state` in tick() --
    // see `restY` above for the rest-on-pad offset this is built around.
    rocket.position.set(state.x, restY + state.y, state.z);
  }

  // Scales and offsets the model onto the CoM-relative origin, then hides
  // the primitives. Failure leaves the placeholder visible.
  function loadRocketModel() {
    new GLTFLoader().load(
      "/lab/3dModels/rocket_model_v2.glb",
      function (gltf) {
        var model = gltf.scene;
        var box = new THREE.Box3().setFromObject(model);
        var size = new THREE.Vector3();
        box.getSize(size);
        // Scale so the model's tallest dimension matches the placeholder's
        // own length (VEH.L), then re-center horizontally and sit its
        // base at the same -VEH.arm+... datum the placeholder used.
        var scale = size.y > 0 ? VEH.L / size.y : 1;
        model.scale.setScalar(scale);
        box.setFromObject(model);
        var center = new THREE.Vector3();
        box.getCenter(center);
        model.position.x -= center.x;
        model.position.z -= center.z;
        model.position.y -= box.min.y;
        model.position.y -= VEH.arm;

        // Scrubbed by altitude rather than played as a timed loop.
        if (gltf.animations && gltf.animations.length) {
          modelMixer = new THREE.AnimationMixer(model);
          modelActions = gltf.animations.map(function (clip) {
            var action = modelMixer.clipAction(clip);
            action.play();
            action.paused = true;
            action.clampWhenFinished = true;
            return action;
          });
        }

        // Measured with the gear deployed and before the model joins `rocket`,
        // so the box is already in the frame restY is expressed in.
        scrubDeploy(1);
        model.updateMatrixWorld(true);
        var footBox = new THREE.Box3().setFromObject(model);
        if (isFinite(footBox.min.y)) restY = -footBox.min.y;

        rocket.add(model);
        // Every stand-in mesh goes, the gimballing bell included -- the
        // model brings its own, and two overlapping nozzles is exactly
        // the "extra mesh" that shows up as a cone under the vehicle.
        if (placeholder) placeholder.visible = false;
        if (nozzleBell) nozzleBell.visible = false;
      },
      undefined,
      function (err) {
        console.warn("Rocket model failed to load, keeping the placeholder.", err);
      }
    );
  }

  // Two procedural sprites, generated once on a canvas: a radial falloff
  // for fire, a blotchy one for smoke and dust.
  function spriteTexture(blotchy) {
    var S = 128, c = document.createElement("canvas");
    c.width = c.height = S;
    var x = c.getContext("2d");
    var g = x.createRadialGradient(S / 2, S / 2, 0, S / 2, S / 2, S / 2);
    g.addColorStop(0, "rgba(255,255,255,1)");
    g.addColorStop(0.35, "rgba(255,255,255,0.62)");
    g.addColorStop(0.72, "rgba(255,255,255,0.18)");
    g.addColorStop(1, "rgba(255,255,255,0)");
    x.fillStyle = g;
    x.fillRect(0, 0, S, S);
    if (blotchy) {
      x.globalCompositeOperation = "destination-out";
      for (var i = 0; i < 26; i++) {
        var r = 6 + Math.random() * 16;
        var px = S / 2 + (Math.random() - 0.5) * S * 0.7;
        var py = S / 2 + (Math.random() - 0.5) * S * 0.7;
        var h = x.createRadialGradient(px, py, 0, px, py, r);
        h.addColorStop(0, "rgba(0,0,0,0.42)");
        h.addColorStop(1, "rgba(0,0,0,0)");
        x.fillStyle = h;
        x.beginPath();
        x.arc(px, py, r, 0, 7);
        x.fill();
      }
      x.globalCompositeOperation = "source-over";
      var g2 = x.createRadialGradient(S / 2, S / 2, 0, S / 2, S / 2, S * 0.3);
      g2.addColorStop(0, "rgba(255,255,255,0.55)");
      g2.addColorStop(1, "rgba(255,255,255,0)");
      x.fillStyle = g2;
      x.fillRect(0, 0, S, S);
    }
    var t = new THREE.CanvasTexture(c);
    t.minFilter = THREE.LinearFilter;
    return t;
  }

  // One pool = one THREE.Points with per-particle size, alpha, rotation and
  // a colour ramp. PointsMaterial supports none of that.
  var POOLS = [];
  var fire, smoke, dust, debris, airFlow, rcsGas, prevNz = null, flashLight;
  var EM = { fire: 0, smoke: 0, dust: 0 };

  function makePool(n, tex, blending, order) {
    var g = new THREE.BufferGeometry();
    var pos = new Float32Array(n * 3), tint = new Float32Array(n * 3);
    var siz = new Float32Array(n), alp = new Float32Array(n), rot = new Float32Array(n);
    g.setAttribute("position", new THREE.BufferAttribute(pos, 3));
    g.setAttribute("aTint", new THREE.BufferAttribute(tint, 3));
    g.setAttribute("aSize", new THREE.BufferAttribute(siz, 1));
    g.setAttribute("aAlpha", new THREE.BufferAttribute(alp, 1));
    g.setAttribute("aRot", new THREE.BufferAttribute(rot, 1));
    var m = new THREE.ShaderMaterial({
      uniforms: { map: { value: tex }, uScale: { value: 700 } },
      vertexShader:
        "attribute float aSize; attribute float aAlpha; attribute float aRot;" +
        "attribute vec3 aTint; uniform float uScale;" +
        "varying float vA; varying float vR; varying vec3 vT;" +
        "void main(){ vA=aAlpha; vR=aRot; vT=aTint;" +
        " vec4 mv=modelViewMatrix*vec4(position,1.0);" +
        " gl_PointSize=min(640.0, aSize*uScale/max(1.0,-mv.z));" +
        " gl_Position=projectionMatrix*mv; }",
      fragmentShader:
        "uniform sampler2D map; varying float vA; varying float vR; varying vec3 vT;" +
        "void main(){ vec2 p=gl_PointCoord-0.5; float c=cos(vR); float s=sin(vR);" +
        " vec2 q=vec2(c*p.x-s*p.y, s*p.x+c*p.y)+0.5;" +
        " float a=texture2D(map,q).a*vA;" +
        " if(a<0.004) discard;" +
        " gl_FragColor=vec4(vT,a); }",
      transparent: true, depthWrite: false, depthTest: true, blending: blending
    });
    var pts = new THREE.Points(g, m);
    pts.frustumCulled = false;
    pts.renderOrder = order;
    scene.add(pts);
    var P = {
      geo: g, mat: m, pos: pos, tint: tint, siz: siz, alp: alp, rot: rot, n: n, head: 0,
      vel: new Float32Array(n * 3), age: new Float32Array(n), life: new Float32Array(n),
      s0: new Float32Array(n), grow: new Float32Array(n), aMax: new Float32Array(n),
      spin: new Float32Array(n), seed: new Float32Array(n),
      c0: new Float32Array(n * 3), c1: new Float32Array(n * 3)
    };
    POOLS.push(P);
    return P;
  }

  function buildParticles() {
    var texSoft = spriteTexture(false), texPuff = spriteTexture(true);
    fire = makePool(700, texSoft, THREE.AdditiveBlending, 3);
    smoke = makePool(800, texPuff, THREE.NormalBlending, 4);
    dust = makePool(700, texPuff, THREE.NormalBlending, 4);
    debris = makePool(420, texSoft, THREE.AdditiveBlending, 5);
    airFlow = makePool(600, texSoft, THREE.NormalBlending, 2);
    rcsGas = makePool(260, texPuff, THREE.NormalBlending, 4);
    clearParticles();
    // The glow sprite shares the fire sprite's falloff, so the throat and
    // the particles leaving it are the same shape of light.
    if (glowSprite) { glowSprite.material.map = texSoft; glowSprite.material.needsUpdate = true; }
    flashLight = new THREE.PointLight(0xffd9a0, 0, 3000, 2);
    scene.add(flashLight);
  }

  function clearParticles() {
    for (var p = 0; p < POOLS.length; p++) {
      var P = POOLS[p];
      for (var i = 0; i < P.n; i++) { P.life[i] = 0; P.alp[i] = 0; P.pos[i * 3 + 1] = -99999; }
      for (var a = 0; a < PARTICLE_ATTRS.length; a++) P.geo.attributes[PARTICLE_ATTRS[a]].needsUpdate = true;
    }
    EM.fire = EM.smoke = EM.dust = 0;
    EM_AIR = EM_RCS = 0;
    prevNz = null;
    if (flashLight) flashLight.intensity = 0;
  }
  var PARTICLE_ATTRS = ["position", "aTint", "aSize", "aAlpha", "aRot"];

  function emit(P, x, y, z, vx, vy, vz, life, size, grow, alpha, r0, g0, b0, r1, g1, b1) {
    var i = P.head; P.head = (P.head + 1) % P.n;
    var i3 = i * 3;
    P.pos[i3] = x; P.pos[i3 + 1] = y; P.pos[i3 + 2] = z;
    P.vel[i3] = vx; P.vel[i3 + 1] = vy; P.vel[i3 + 2] = vz;
    P.age[i] = 0; P.life[i] = life; P.s0[i] = size; P.grow[i] = grow; P.aMax[i] = alpha;
    P.spin[i] = (Math.random() - 0.5) * 1.5;
    P.rot[i] = Math.random() * 6.283;
    P.seed[i] = Math.random() * 100;
    P.c0[i3] = r0; P.c0[i3 + 1] = g0; P.c0[i3 + 2] = b0;
    if (r1 === undefined) { P.c1[i3] = r0; P.c1[i3 + 1] = g0; P.c1[i3 + 2] = b0; }
    else { P.c1[i3] = r1; P.c1[i3 + 1] = g1; P.c1[i3 + 2] = b1; }
    P.alp[i] = 0; P.siz[i] = size;
  }

  // The envelope is what makes it smooth: alpha eases in over fadeIn
  // seconds and out over the rest of the life, size grows linearly,
  // colour ramps c0 -> c1. Nothing appears or vanishes in one frame.
  function stepPool(P, dt, o) {
    var windX = windInput ? Number(windInput.value) : 0;
    for (var i = 0; i < P.n; i++) {
      if (P.life[i] <= 0) continue;
      var i3 = i * 3;
      P.age[i] += dt;
      var u = P.age[i] / P.life[i];
      if (u >= 1) { P.life[i] = 0; P.alp[i] = 0; P.pos[i3 + 1] = -99999; continue; }
      var d = Math.exp(-o.drag * dt);
      P.vel[i3] *= d; P.vel[i3 + 2] *= d;
      P.vel[i3 + 1] = P.vel[i3 + 1] * d + (o.grav + o.buoy) * dt;
      if (o.windK) {
        P.vel[i3] += (windX - P.vel[i3]) * o.windK * dt;
        P.vel[i3 + 2] += (0 - P.vel[i3 + 2]) * o.windK * dt;
      }
      if (o.turb) {
        var t = P.seed[i] + state.tPlus * 1.3;
        P.vel[i3] += Math.sin(t * 2.1 + P.pos[i3 + 1] * 0.11) * o.turb * dt;
        P.vel[i3 + 1] += Math.sin(t * 1.7 + P.pos[i3] * 0.09) * o.turb * 0.6 * dt;
        P.vel[i3 + 2] += Math.cos(t * 1.9 + P.pos[i3] * 0.07) * o.turb * dt;
      }
      P.pos[i3] += P.vel[i3] * dt;
      P.pos[i3 + 1] += P.vel[i3 + 1] * dt;
      P.pos[i3 + 2] += P.vel[i3 + 2] * dt;
      if (P.pos[i3 + 1] < o.floor) {
        P.pos[i3 + 1] = o.floor;
        if (P.vel[i3 + 1] < 0) P.vel[i3 + 1] = -P.vel[i3 + 1] * o.bounce;
        P.vel[i3] *= 0.96; P.vel[i3 + 2] *= 0.96;
      }
      P.rot[i] += P.spin[i] * dt;
      P.siz[i] = P.s0[i] * (1 + P.grow[i] * u);
      var ain = Math.min(1, P.age[i] / o.fadeIn);
      P.alp[i] = P.aMax[i] * ain * ain * Math.pow(1 - u, o.pow);
      var k = Math.min(1, u * o.ramp);
      P.tint[i3] = P.c0[i3] + (P.c1[i3] - P.c0[i3]) * k;
      P.tint[i3 + 1] = P.c0[i3 + 1] + (P.c1[i3 + 1] - P.c0[i3 + 1]) * k;
      P.tint[i3 + 2] = P.c0[i3 + 2] + (P.c1[i3 + 2] - P.c0[i3 + 2]) * k;
    }
    for (var a = 0; a < PARTICLE_ATTRS.length; a++) P.geo.attributes[PARTICLE_ATTRS[a]].needsUpdate = true;
  }

  function airFrac() { return clamp(world().rho0 / 1.225, 0, 1); }
  function groundTint() {
    var h = world().ground;
    return [((h >> 16) & 255) / 255, ((h >> 8) & 255) / 255, (h & 255) / 255];
  }

  function updateParticles(dt) {
    if (dt <= 0 || !fire) return;
    var W = world(), air = airFrac();
    var us = renderer.domElement.height * 1.02;
    for (var p = 0; p < POOLS.length; p++) POOLS[p].mat.uniforms.uScale.value = us;
    stepPool(fire, dt, { drag: 2.6, grav: 0, buoy: 8 * air, turb: 6 * air, fadeIn: 0.03, pow: 1.4, ramp: 1.6, floor: 0.5, bounce: 0, windK: 0 });
    stepPool(smoke, dt, { drag: 1.5, grav: 0, buoy: 1.2 + 2.2 * air, turb: 2.4, fadeIn: 0.3, pow: 1.15, ramp: 1.0, floor: 0.8, bounce: 0, windK: 0.5 });
    stepPool(dust, dt, air > 0.03
      ? { drag: 1.1, grav: -W.g * 0.2, buoy: 0.8, turb: 1.8, fadeIn: 0.14, pow: 1.2, ramp: 1.0, floor: 0.5, bounce: 0, windK: 0.4 }
      : { drag: 0.02, grav: -W.g, buoy: 0, turb: 0, fadeIn: 0.02, pow: 1.6, ramp: 1.0, floor: 0.3, bounce: 0.25, windK: 0 });
    stepPool(debris, dt, { drag: 0.25, grav: -W.g, buoy: 0, turb: 0, fadeIn: 0.01, pow: 1.1, ramp: 2.2, floor: 0.6, bounce: 0.3, windK: 0 });
    // Airflow keeps its own velocity: drag would stop it dead beside the
    // vehicle instead of sweeping past. No floor, it lives above the ground.
    stepPool(airFlow, dt, { drag: 0.02, grav: 0, buoy: 0, turb: 0.4, fadeIn: 0.06, pow: 1.5, ramp: 1.0, floor: -1e5, bounce: 0, windK: 0 });
    stepPool(rcsGas, dt, { drag: 1.8, grav: 0, buoy: 0.6, turb: 1.2, fadeIn: 0.02, pow: 1.3, ramp: 1.0, floor: -1e5, bounce: 0, windK: 0 });
    if (flashLight && flashLight.intensity > 0) flashLight.intensity = Math.max(0, flashLight.intensity - dt * 18);
  }

  // Per-frame plume emission. Particles spawn along the nozzle's SWEPT
  // path this frame rather than at a point, so a fast-moving vehicle
  // leaves a continuous ribbon instead of clumps once per frame.
  function emitPlume(dt) {
    if (!fire || dt <= 0) return;
    var thr = state.thrustFrac;
    var on = thr > 0.01 && state.phase === "falling";
    if (!on) { prevNz = null; return; }

    var air = airFrac();
    // Thrust direction: the deflected body axis, same û(φ,ψ) the physics
    // integrates against, so the plume points where the force does.
    var tPhi = state.phi + state.defPhi, tPsi = state.psi + state.defPsi;
    var td = [-Math.sin(tPhi), Math.cos(tPhi) * Math.cos(tPsi), Math.cos(tPhi) * Math.sin(tPsi)];
    var nz = new THREE.Vector3(0, -VEH.arm, 0).applyEuler(rocket.rotation).add(rocket.position);
    if (!prevNz) prevNz = nz.clone();

    EM.fire += thr * 240 * dt;
    var nf = Math.min(Math.floor(EM.fire), 90);
    EM.fire -= Math.floor(EM.fire);
    var spr = 1 + (1 - air) * 1.3;
    for (var i = 0; i < nf; i++) {
      var f = Math.random();
      var px = prevNz.x + (nz.x - prevNz.x) * f;
      var py = prevNz.y + (nz.y - prevNz.y) * f;
      var pz = prevNz.z + (nz.z - prevNz.z) * f;
      var sp = 70 + Math.random() * 120 * thr;
      emit(fire, px + (Math.random() - 0.5) * 1.6, py, pz + (Math.random() - 0.5) * 1.6,
        -td[0] * sp + (Math.random() - 0.5) * 11 * spr + state.vx * 0.4,
        -td[1] * sp + (Math.random() - 0.5) * 5.5 * spr + state.vy * 0.4,
        -td[2] * sp + (Math.random() - 0.5) * 11 * spr + state.vz * 0.4,
        0.14 + Math.random() * 0.22, 2.2 + Math.random() * 2.4 * thr, 1.6, 0.85,
        1.0, 0.93, 0.66, 1.0, 0.42, 0.1);
    }

    // Soot, spawned downstream where the flame has cooled. Needs air to
    // hold it -- on the Moon there is nothing for smoke to billow into.
    if (air > 0.03) {
      EM.smoke += thr * 38 * air * dt;
      var ns = Math.min(Math.floor(EM.smoke), 16);
      EM.smoke -= Math.floor(EM.smoke);
      for (var j = 0; j < ns; j++) {
        var L = 10 + Math.random() * 26;
        emit(smoke,
          nz.x - td[0] * L + (Math.random() - 0.5) * 4,
          Math.max(nz.y - td[1] * L, 1.2),
          nz.z - td[2] * L + (Math.random() - 0.5) * 4,
          -td[0] * 14 + state.vx * 0.5 + (Math.random() - 0.5) * 5,
          -td[1] * 10 + 3 + Math.random() * 3,
          -td[2] * 14 + state.vz * 0.5 + (Math.random() - 0.5) * 5,
          2.2 + Math.random() * 2.6, 3.5 + Math.random() * 3, 4.5 + Math.random() * 2,
          0.3 * (0.35 + 0.65 * air),
          0.2, 0.19, 0.175, 0.66, 0.63, 0.58);
      }
    }
    prevNz.copy(nz);

    // Plume impingement: the dust ring forms where the plume AXIS meets
    // the ground -- under the nozzle, not under the nose, which is a
    // visible difference the moment the vehicle is tilted.
    if (td[1] > 0.25 && nz.y < 150) {
      var hit = nz.y / td[1];
      var gx = nz.x - td[0] * hit, gz = nz.z - td[2] * hit;
      var k = 1 - nz.y / 150;
      var g = groundTint();
      EM.dust += thr * k * (air > 0.03 ? 26 : 44) * dt;
      var nd = Math.min(Math.floor(EM.dust), 20);
      EM.dust -= Math.floor(EM.dust);
      for (var d = 0; d < nd; d++) {
        var a2 = Math.random() * 6.283, r0 = 2 + nz.y * 0.16 * Math.random();
        var dsp = (air > 0.03 ? 14 + 40 * k : 30 + 90 * k) * (0.6 + 0.4 * Math.random());
        if (air > 0.03) {
          emit(dust, gx + Math.cos(a2) * r0, 0.8 + Math.random() * 1.5, gz + Math.sin(a2) * r0,
            Math.cos(a2) * dsp, 2.5 + Math.random() * 7 * k, Math.sin(a2) * dsp,
            1.6 + Math.random() * 1.8, 3 + Math.random() * 3, 4 + Math.random() * 2, 0.34,
            g[0], g[1], g[2], Math.min(1, g[0] * 1.12), Math.min(1, g[1] * 1.12), Math.min(1, g[2] * 1.12));
        } else {
          // Vacuum: a flat ballistic sheet, no billowing -- no air to billow in.
          emit(dust, gx + Math.cos(a2) * r0, 0.6, gz + Math.sin(a2) * r0,
            Math.cos(a2) * dsp, 1.5 + Math.random() * 5, Math.sin(a2) * dsp,
            0.9 + Math.random() * 0.9, 1.1 + Math.random() * 0.8, 0.4, 0.5,
            g[0], g[1], g[2]);
        }
      }
    }
  }

  // Streaks of air swept past the vehicle along the RELATIVE wind, which is
  // where the angle of attack becomes visible: tilt the vehicle and the flow
  // keeps running along its own direction while the body no longer matches it.
  var EM_AIR = 0, EM_RCS = 0;
  function emitAirflow(dt) {
    if (!airFlow || dt <= 0 || state.phase !== "falling") return;
    var w = world();
    if (w.rho0 <= 0) return;

    var windX = windInput ? Number(windInput.value) : 0;
    var rvx = state.vx - windX, rvy = state.vy, rvz = state.vz;
    var speed = Math.hypot(rvx, rvy, rvz);
    if (speed < 25) return;

    var bodyUy = Math.cos(state.phi) * Math.cos(state.psi);
    var alt = Math.max(0, state.y - VEH.arm * bodyUy);
    var rho = w.rho0 * Math.exp(-alt / w.H);
    var q = 0.5 * rho * speed * speed;
    // Nothing worth drawing until the air is actually doing something.
    var strength = clamp(q / 9000, 0, 1);
    if (strength <= 0.02) return;

    // Unit vector the air travels along, and two axes across it to scatter on.
    var fx = -rvx / speed, fy = -rvy / speed, fz = -rvz / speed;
    var ax = Math.abs(fy) < 0.9 ? 0 : 1, ay = Math.abs(fy) < 0.9 ? 1 : 0;
    var px = ay * fz - 0 * fy, py = 0 * fx - ax * fz, pz = ax * fy - ay * fx;
    var pm = Math.hypot(px, py, pz) || 1;
    px /= pm; py /= pm; pz /= pm;
    var qx = fy * pz - fz * py, qy = fz * px - fx * pz, qz = fx * py - fy * px;

    // Angle of attack: how far the body axis has departed from the flow.
    // Tilting into the airstream is what thickens the effect.
    var bx = -Math.sin(state.phi);
    var by = Math.cos(state.phi) * Math.cos(state.psi);
    var bz = Math.cos(state.phi) * Math.sin(state.psi);
    var aoa = Math.acos(clamp(-(bx * fx + by * fy + bz * fz), -1, 1));
    var aoaBoost = 1 + 2.4 * Math.sin(Math.min(aoa, Math.PI / 2));

    EM_AIR += strength * aoaBoost * 190 * dt;
    var n = Math.min(Math.floor(EM_AIR), 30);
    EM_AIR -= Math.floor(EM_AIR);

    var cx = state.x, cy = restY + state.y, cz = state.z;
    for (var i = 0; i < n; i++) {
      // Hugging the body and spawned upstream only, so they read as flow
      // arriving and sweeping past rather than haze scattered around it.
      var r = 3 + Math.random() * 15;
      var a = Math.random() * 6.283;
      var off = 24 + Math.random() * 46;
      var ox = px * Math.cos(a) * r + qx * Math.sin(a) * r - fx * off;
      var oy = py * Math.cos(a) * r + qy * Math.sin(a) * r - fy * off;
      var oz = pz * Math.cos(a) * r + qz * Math.sin(a) * r - fz * off;
      var sp = speed * (0.88 + Math.random() * 0.24);
      emit(airFlow, cx + ox, cy + oy, cz + oz,
        fx * sp, fy * sp, fz * sp,
        0.30 + Math.random() * 0.22, 1.1 + Math.random() * 1.4, 1.6,
        (0.08 + 0.26 * strength) * Math.min(aoaBoost, 2),
        0.40, 0.45, 0.53, 0.60, 0.64, 0.70);
    }
  }

  // Cold-gas puffs from the interstage, fired opposite the torque they make.
  function emitRcs(dt) {
    if (!rcsGas || dt <= 0) return;
    var on = Math.abs(state.rcsPhi) + Math.abs(state.rcsPsi);
    if (on <= 0 || state.n2 <= 0) return;

    EM_RCS += on * 70 * dt;
    var n = Math.min(Math.floor(EM_RCS), 10);
    EM_RCS -= Math.floor(EM_RCS);
    if (n <= 0) return;

    var pod = new THREE.Vector3(0, VEH.rcsArm, 0).applyEuler(rocket.rotation).add(rocket.position);
    // Gas leaves along +x for a positive phi command and +z for psi, rotated
    // into the vehicle's own frame.
    var dir = new THREE.Vector3(state.rcsPhi, 0, state.rcsPsi).normalize().applyEuler(rocket.rotation);
    for (var i = 0; i < n; i++) {
      var sp = 26 + Math.random() * 20;
      emit(rcsGas,
        pod.x + (Math.random() - 0.5) * 2, pod.y + (Math.random() - 0.5) * 2, pod.z + (Math.random() - 0.5) * 2,
        dir.x * sp + state.vx * 0.5 + (Math.random() - 0.5) * 6,
        dir.y * sp + state.vy * 0.5 + (Math.random() - 0.5) * 6,
        dir.z * sp + state.vz * 0.5 + (Math.random() - 0.5) * 6,
        0.45 + Math.random() * 0.35, 2.0 + Math.random() * 1.6, 3.6, 0.7,
        0.95, 0.96, 0.98, 0.72, 0.75, 0.80);
    }
  }

  function touchdownEffects(ok) {
    if (!dust) return;
    var g = groundTint(), air = airFrac();
    var i, a, r, sp;
    if (ok) {
      for (i = 0; i < 140; i++) {
        a = Math.random() * 6.283; r = 6 + Math.random() * 22; sp = 16 + Math.random() * 26;
        emit(dust, state.x + Math.cos(a) * r, 1.2, state.z + Math.sin(a) * r,
          Math.cos(a) * sp, 4 + Math.random() * 8, Math.sin(a) * sp,
          2.0 + Math.random() * 1.6, 3.5 + Math.random() * 3, 3.5, 0.36,
          g[0], g[1], g[2], Math.min(1, g[0] * 1.1), Math.min(1, g[1] * 1.1), Math.min(1, g[2] * 1.1));
      }
      return;
    }
    if (rocket) rocket.visible = false;
    if (flashLight) { flashLight.position.set(state.x, 10, state.z); flashLight.intensity = 14; }
    for (i = 0; i < debris.n; i++) {
      a = Math.random() * 6.283;
      var e = Math.random() * 1.2; sp = 30 + Math.random() * 150;
      emit(debris, state.x, 6, state.z,
        Math.cos(a) * Math.cos(e) * sp, Math.sin(e) * sp * 1.1, Math.sin(a) * Math.cos(e) * sp,
        1.4 + Math.random() * 2.2, 1.6 + Math.random() * 1.6, 0.4, 0.95,
        1.0, 0.82, 0.42, 0.62, 0.12, 0.04);
    }
    for (i = 0; i < 120; i++) {
      a = Math.random() * 6.283; r = Math.random() * 14; sp = 8 + Math.random() * 30;
      emit(fire, state.x + Math.cos(a) * r, 3 + Math.random() * 10, state.z + Math.sin(a) * r,
        Math.cos(a) * sp, 12 + Math.random() * 28, Math.sin(a) * sp,
        0.4 + Math.random() * 0.7, 4 + Math.random() * 5, 2.2, 0.9,
        1.0, 0.88, 0.55, 1.0, 0.32, 0.06);
    }
    for (i = 0; i < 160; i++) {
      a = Math.random() * 6.283; r = Math.random() * 20;
      emit(smoke, state.x + Math.cos(a) * r, 2 + Math.random() * 8, state.z + Math.sin(a) * r,
        Math.cos(a) * (6 + Math.random() * 14), (4 + Math.random() * 14) * (0.3 + 0.7 * air),
        Math.sin(a) * (6 + Math.random() * 14),
        3.5 + Math.random() * 3, 5 + Math.random() * 4, 5, 0.42 * (0.3 + 0.7 * air),
        0.13, 0.12, 0.11, 0.45, 0.42, 0.38);
    }
    for (i = 0; i < 180; i++) {
      a = Math.random() * 6.283; r = Math.random() * 45;
      emit(dust, state.x + Math.cos(a) * r, 1.5, state.z + Math.sin(a) * r,
        Math.cos(a) * (30 + Math.random() * 40), 8 + Math.random() * 18, Math.sin(a) * (30 + Math.random() * 40),
        2.4 + Math.random() * 2, 3 + Math.random() * 3, 4, 0.4,
        g[0], g[1], g[2]);
    }
  }

  // Four rigs, all the same spherical theta/phi/dist-around-a-look-point
  // math, just different sources for those three numbers per mode.
  function updateCamera(dt) {
    var alt = Math.max(state.y, 0);
    // Aim where the vehicle is drawn (restY + state.y), not at the raw
    // physics datum, which sits a third of a body-length lower.
    var bodyY = restY + state.y;
    var look = new THREE.Vector3(state.x, bodyY, state.z);
    var dist, theta, phi;

    if (camRig.mode === "pad") {
      var d = Math.hypot(state.x, state.z);
      dist = clamp(Math.hypot(d, state.y) * 0.55 + 70, 90, 2600);
      theta = Math.atan2(state.z, state.x) + 2.2;
      phi = clamp(0.1 + alt / 9000, 0.1, 0.55);
      look.set(0, restY, 0);
    } else if (camRig.mode === "side") {
      dist = clamp(Math.max(alt * 1.25, Math.hypot(state.x, state.z) * 1.5) + 130, 180, 4200);
      theta = Math.atan2(state.z, state.x || 1e-3) + Math.PI / 2;
      phi = 0.06;
      look.set(state.x * 0.55, Math.max(bodyY * 0.5, restY), state.z * 0.55);
    } else if (camRig.mode === "orbit") {
      if (!reducedMotion) camRig.spin += dt * 0.05;
      dist = clamp(150 + alt * 0.22, 150, 2200);
      theta = camRig.spin * 0.4 - 0.6;
      phi = 0.28;
    } else { // chase (default)
      if (!reducedMotion) camRig.spin += dt * 0.05;
      theta = camRig.spin * 0.4 - 0.6;
      phi = 0.32;
      // Midpoint of vehicle and pad. dist * ~0.93 must exceed alt or one end
      // falls outside the frustum.
      dist = clamp(150 + alt * 1.15, 150, 3200);
      look.y = bodyY / 2;
    }

    // Drag-to-orbit / scroll-to-zoom, layered on top of whichever rig is
    // active above -- same idea as the reference file's own CAM.userTheta/
    // userPhi/distMul, so every view mode stays adjustable by hand.
    theta += camRig.userTheta;
    phi = clamp(phi + camRig.userPhi, -0.25, 1.35);
    dist *= camRig.distMul;

    var k = 1 - Math.pow(0.0016, Math.min(dt, 0.1));
    camTarget.lerp(look, camRig.mode === "orbit" ? 1 : k);
    camera.position.set(
      camTarget.x + dist * Math.cos(phi) * Math.cos(theta),
      camTarget.y + dist * Math.sin(phi),
      camTarget.z + dist * Math.cos(phi) * Math.sin(theta)
    );
    camera.lookAt(camTarget);
  }

  function clamp(v, a, b) { return v < a ? a : v > b ? b : v; }

  function throttleFraction() {
    var pct = throttleInput ? Number(throttleInput.value) : 0;
    return pct <= 0 ? 0 : Math.max(pct / 100, VEH.minThr);
  }

  // One PD signal per axis, clipped to each actuator's own limits and rate.
  // Shared by the autopilot and manual attitude hold.
  var RCS_DEADBAND = 0.035;
  function allocate(uPhi, uPsi, engineOff) {
    var maxGimbalStep = VEH.gimbalRate * PHYS.step;
    var defPhi = clamp(clamp(uPhi, -VEH.maxGimbal, VEH.maxGimbal), state.defPhi - maxGimbalStep, state.defPhi + maxGimbalStep);
    var defPsi = clamp(clamp(uPsi, -VEH.maxGimbal, VEH.maxGimbal), state.defPsi - maxGimbalStep, state.defPsi + maxGimbalStep);

    var maxFinStep = VEH.finRate * PHYS.step;
    var finPhi = clamp(clamp(PHYS.finGain * uPhi, -VEH.maxFin, VEH.maxFin), state.finPhi - maxFinStep, state.finPhi + maxFinStep);
    var finPsi = clamp(clamp(PHYS.finGain * uPsi, -VEH.maxFin, VEH.maxFin), state.finPsi - maxFinStep, state.finPsi + maxFinStep);

    // Cold gas is a valve, not a servo: full thrust or nothing, outside a
    // deadband. Held back for the engine-off coast so it isn't wasted
    // fighting the gimbal, which is stronger by two orders of magnitude.
    var rcsPhi = 0, rcsPsi = 0;
    if (engineOff && state.n2 > 0) {
      if (Math.abs(uPhi) > RCS_DEADBAND) rcsPhi = uPhi > 0 ? 1 : -1;
      if (Math.abs(uPsi) > RCS_DEADBAND) rcsPsi = uPsi > 0 ? 1 : -1;
    }

    return { defPhi: defPhi, defPsi: defPsi, finPhi: finPhi, finPsi: finPsi, rcsPhi: rcsPhi, rcsPsi: rcsPsi };
  }

  // Keys move a held target angle; the same PD loop the autopilot uses
  // tracks it. Attitude hold is always on, there is no raw open-loop mode.
  var manualKeys = {};
  var manualPhiCmd = 0, manualPsiCmd = 0;
  var MANUAL_TILT_RATE = 24 * DEG;
  var MANUAL_THROTTLE_RATE = 70; // percent per second

  function manualControl(dt) {
    if (throttleInput) {
      var pct = Number(throttleInput.value);
      if (manualKeys.throttleUp) pct += MANUAL_THROTTLE_RATE * dt;
      if (manualKeys.throttleDown) pct -= MANUAL_THROTTLE_RATE * dt;
      throttleInput.value = String(clamp(pct, 0, 100));
    }
    var frac = state.fuel > 0 ? throttleFraction() : 0;

    var tiltCap = tiltLimit(state.y);
    if (manualKeys.left) manualPhiCmd += MANUAL_TILT_RATE * dt;
    if (manualKeys.right) manualPhiCmd -= MANUAL_TILT_RATE * dt;
    if (manualKeys.fwd) manualPsiCmd += MANUAL_TILT_RATE * dt;
    if (manualKeys.back) manualPsiCmd -= MANUAL_TILT_RATE * dt;
    manualPhiCmd = clamp(manualPhiCmd, -tiltCap, tiltCap);
    manualPsiCmd = clamp(manualPsiCmd, -tiltCap, tiltCap);
    state.cmdPhi = manualPhiCmd; state.cmdPsi = manualPsiCmd;

    var uPhi = -(PHYS.Kp * (manualPhiCmd - state.phi) - PHYS.Kd * state.wphi);
    var uPsi = -(PHYS.Kp * (manualPsiCmd - state.psi) - PHYS.Kd * state.wpsi);
    var alloc = allocate(uPhi, uPsi, frac <= 0);

    return { thrust: frac * VEH.maxT, defPhi: alloc.defPhi, defPsi: alloc.defPsi,
      finPhi: alloc.finPhi, finPsi: alloc.finPsi, rcsPhi: alloc.rcsPhi, rcsPsi: alloc.rcsPsi };
  }

  // One combined reference: how hard to brake (aDec/kapReq) and how long the
  // crossrange divert has (tLat), from the same base numbers.

  // One combined reference: how hard to brake (aDec/kapReq), and how
  // long the crossrange divert has (tLat), from the same base numbers.
  function refProfile(alt, aMax, g) {
    var base = Math.max(0.5, (0.88 * aMax - g) * 0.8);
    var aLat = Math.max(1, 0.34 * aMax * Math.sin(VEH.maxTilt));
    var h = Math.max(1, alt);
    var tgo = (2 * h) / (Math.abs(state.vy) + PHYS.vTarget + 1e-3);
    var latMiss = Math.hypot(state.x + state.vx * tgo, state.z + state.vz * tgo);
    var tLat = Math.min(26, 3.2 * Math.sqrt(latMiss / aLat));
    var kMin = clamp((VEH.minThr * aMax - g + 0.8) / base, 0.1, 0.95);
    var kapReq = (state.vy * state.vy - PHYS.vTarget * PHYS.vTarget) / (2 * base * h);
    var aDec = Math.max(0.5, base * clamp(kapReq, kMin, 1));
    return {
      vRef: -Math.min(200, Math.sqrt(PHYS.vTarget * PHYS.vTarget + 2 * aDec * Math.max(0, alt))),
      aDec: aDec, kapReq: kapReq, tLat: tLat, kMin: kMin, tgo: tgo
    };
  }

  // Tilt authority folds toward vertical near the ground so the vehicle
  // arrives upright instead of leaning on one leg -- never below 45% of
  // max, or there'd be no steering left at all in the last few metres.
  function tiltLimit(alt) { return VEH.maxTilt * clamp(alt / 40, 0.45, 1); }

  // The floor matters on low-gravity worlds: a lit engine produces at least
  // minThr regardless, and that thrust is available for steering.
  function lateralCap(ay, aMax, tiltCap) {
    return Math.max(ay * Math.tan(tiltCap), VEH.minThr * aMax * Math.sin(tiltCap));
  }

  // Drift must be dead by PHYS.hDiv, not by touchdown: below it the tilt
  // limit is folding. tLatFloor keeps the command inside the tilt budget.
  function divertClock(alt, aDec) {
    if (alt <= PHYS.hDiv) return Math.max(PHYS.tLatFloor, (2 * alt) / (Math.abs(state.vy) + PHYS.vTarget + 1e-3));
    var vAtDiv = Math.sqrt(PHYS.vTarget * PHYS.vTarget + 2 * Math.max(0.5, aDec) * PHYS.hDiv);
    return Math.max(PHYS.tLatFloor, (2 * (alt - PHYS.hDiv)) / (Math.abs(state.vy) + vAtDiv + 1e-3));
  }

  // ZEM/ZEV on the horizontal plane alone, capped to what lateralCap
  // says the tilt limit can actually deliver.
  //
  // This is a terminal-descent law, and it assumes the vehicle can translate
  // during the braking burn. That holds where minimum throttle is close to
  // local weight. It does not hold on Mars or the Moon, where the floor is
  // several times local gravity: the vehicle cannot loiter, so the burn has
  // to be short, so there is no time to translate, and cutting the engine to
  // buy time removes the only actuator that can. A few hundred metres of
  // crossrange there needs a lofted burn/coast/burn plan this law does not
  // produce, which is why the off-target case lands short on both.
  function lateralGuide(tLat, cap) {
    var t2 = tLat * tLat;
    var ax = (-6 * (state.x + state.vx * tLat)) / t2 + (2 * state.vx) / tLat;
    var az = (-6 * (state.z + state.vz * tLat)) / t2 + (2 * state.vz) / tLat;
    var am = Math.hypot(ax, az);
    if (am > cap) { ax *= cap / am; az *= cap / am; }
    return { ax: ax, az: az };
  }

  function guideProfile(alt, aMax, g, pr) {
    var ay = g + pr.aDec + 1.6 * (pr.vRef - state.vy);
    var tiltCap = tiltLimit(alt);
    var L = lateralGuide(divertClock(alt, pr.aDec), lateralCap(ay, aMax, tiltCap));
    return { ax: L.ax, ay: clamp(ay, 0, aMax), az: L.az };
  }

  function guideZemZev(alt, aMax, g, pr) {
    var t = clamp((2 * Math.max(alt, 0)) / (Math.abs(state.vy) + PHYS.vTarget + 1e-3), 0.6, 150);
    var t2 = t * t;
    var zemY = -(alt + state.vy * t - 0.5 * g * t2);
    var zevY = -PHYS.vTarget - (state.vy - g * t);
    var ay = (6 * zemY) / t2 - (2 * zevY) / t;
    var tiltCap = tiltLimit(alt);
    var L = lateralGuide(divertClock(alt, pr.aDec), lateralCap(ay, aMax, tiltCap));
    var ax = L.ax, az = L.az;
    var am = Math.hypot(ax, ay, az);
    if (am > aMax) { ax = (ax * aMax) / am; ay = (ay * aMax) / am; az = (az * aMax) / am; }
    return { ax: ax, ay: ay, az: az };
  }

  // Full autopilot: trigger, guidance law, throttle + attitude command,
  // rate-limited gimbal. state.cut is the controller's own memory for
  // the throttle hysteresis below.
  function guidance(dt) {
    var mass = VEH.dry + state.fuel;
    var aMax = VEH.maxT / mass;
    var g = world().g;
    var alt = state.y;
    var pr = refProfile(alt, aMax, g);
    state.tGo = pr.tgo;
    state.gKappa = pr.kapReq;
    state.gVref = pr.vRef;
    // Zero-effort miss: where the vehicle arrives if it does nothing at
    // all from here, gravity included (Article §08). Target is the pad
    // origin, so r_f = 0 and the whole term is the negated coast.
    var zt = pr.tgo;
    state.gZem = Math.hypot(
      state.x + state.vx * zt,
      state.y + state.vy * zt - 0.5 * g * zt * zt,
      state.z + state.vz * zt
    );

    // Ignite early for a divert only if the profile is still flyable: on a
    // low-gravity world the throttle floor makes a shallow descent impossible.
    //
    // Without air that guard leaves a tumbling vehicle with nothing to fly on.
    // There is no weathervane and no fin authority, and RCS on its own needs
    // longer than the whole descent to null a real body rate, so the gimbal
    // has to be available: light the engine rather than coast into the ground
    // sideways. A large crossrange divert is a different problem and this law
    // does not solve it -- see the note above lateralGuide().
    if (!state.ignited && state.vy < 0) {
      var inertia = (mass * VEH.L * VEH.L) / 12;
      var rcsAlpha = (VEH.rcsT * VEH.rcsArm) / inertia;
      var bodyRate = Math.hypot(state.wphi, state.wpsi);
      var tiltNow = Math.acos(clamp(Math.cos(state.phi) * Math.cos(state.psi), -1, 1));
      var attitudeLost = bodyRate / Math.max(rcsAlpha, 1e-9) > 0.5 * pr.tgo || tiltNow > VEH.maxTilt;
      if (pr.kapReq >= 0.98
        || (pr.tgo <= 2.2 * pr.tLat && pr.kapReq >= pr.kMin)
        || (airFrac() < 0.25 && attitudeLost)) {
        state.ignited = true;
      }
    }

    var ax, ay, az, thrustFrac;
    if (!state.ignited) {
      // Hold retrograde attitude during the coast so the vehicle is
      // already pointed the right way at ignition, without actually
      // burning anything.
      var sp = Math.hypot(state.vx, state.vy, state.vz) || 1;
      ax = (-state.vx / sp) * 0.02;
      ay = Math.max(0.02, (-state.vy / sp) * 0.02);
      az = (-state.vz / sp) * 0.02;
      thrustFrac = 0;
    } else if (state.fuel <= 0) {
      ax = 0; ay = 0; az = 0; thrustFrac = 0;
    } else {
      var g2 = (guidanceSelect && guidanceSelect.value === "profile")
        ? guideProfile(alt, aMax, g, pr) : guideZemZev(alt, aMax, g, pr);
      ax = g2.ax; ay = g2.ay; az = g2.az;
      var am2 = Math.hypot(ax, ay, az);
      var thr = clamp(am2 / aMax, 0, 1);
      // Hysteresis, not a hard cutoff: once cut, stays cut until the
      // command climbs back above the floor, or a command sitting right
      // at the floor would chatter the engine on/off every step.
      if (state.cut) { if (thr > VEH.minThr) state.cut = false; }
      else if (thr < 0.85 * VEH.minThr && alt > 20) state.cut = true;
      thrustFrac = state.cut ? 0 : Math.max(thr, VEH.minThr);
      if (alt < 18 && state.vy > -0.6) thrustFrac = 0; // don't float
    }

    // Scales the commanded lateral accel directly, unlike tiltLimit() which
    // caps the PD target.
    if (state.ignited && alt < 28) {
      var b = clamp(alt / 28, 0.3, 1);
      ax *= b; az *= b;
    }

    // An engine does not step from zero to commanded thrust inside one frame.
    // The spool also removes the lurch a tilted vehicle showed at ignition,
    // where a full-thrust vector appeared sideways in a single step.
    var spool = PHYS.spoolRate * Math.max(dt || 0, 1e-4);
    state.thrFrac = thrustFrac > state.thrFrac
      ? Math.min(thrustFrac, state.thrFrac + spool)
      : Math.max(thrustFrac, state.thrFrac - spool);
    thrustFrac = state.thrFrac;

    state.gAcmd = Math.hypot(ax, ay, az);

    var dirMag = Math.hypot(ax, ay, az) || 1;
    var dx = ax / dirMag, dy = ay / dirMag, dz = az / dirMag;
    if (dy < 0.25) { dx = 0; dy = 1; dz = 0; }
    var phiCmd = clamp(-Math.asin(clamp(dx, -1, 1)), -VEH.maxTilt, VEH.maxTilt);
    var psiCmd = clamp(Math.atan2(dz, Math.max(0.25, dy)), -VEH.maxTilt, VEH.maxTilt);
    state.cmdPhi = phiCmd; state.cmdPsi = psiCmd;

    var uPhi = -(PHYS.Kp * (phiCmd - state.phi) - PHYS.Kd * state.wphi);
    var uPsi = -(PHYS.Kp * (psiCmd - state.psi) - PHYS.Kd * state.wpsi);
    var alloc = allocate(uPhi, uPsi, thrustFrac <= 0);

    return { thrust: thrustFrac * VEH.maxT, defPhi: alloc.defPhi, defPsi: alloc.defPsi,
      finPhi: alloc.finPhi, finPsi: alloc.finPsi, rcsPhi: alloc.rcsPhi, rcsPsi: alloc.rcsPsi };
  }

  // Mass is held constant across one RK4 step's four evaluations and burned
  // once afterwards (zero-order hold).
  var RK4_FIELDS = ["x", "y", "z", "vx", "vy", "vz", "phi", "psi", "wphi", "wpsi"];
  function derivatives(s, u, mass) {
    var totalPhi = s.phi + u.defPhi, totalPsi = s.psi + u.defPsi;
    var ux = -Math.sin(totalPhi);
    var uy = Math.cos(totalPhi) * Math.cos(totalPsi);
    var uz = Math.cos(totalPhi) * Math.sin(totalPsi);
    var w = world();

    // Altitude of the engine bell, not the CoM (Article §01) -- tilting
    // raises the lowest point, and it's what the atmosphere around the
    // fins actually sees too, not the raw y the HUD displays.
    var bodyUy = Math.cos(s.phi) * Math.cos(s.psi);
    var alt = Math.max(0, s.y - VEH.arm * bodyUy);

    // Drag depends on velocity RELATIVE to the air (Article §02), not
    // ground-relative velocity -- a crosswind along x is what actually
    // disturbs the vehicle, not the ground track.
    var windX = windInput ? Number(windInput.value) : 0;
    var relVx = s.vx - windX, relVy = s.vy, relVz = s.vz;
    var speed = Math.sqrt(relVx * relVx + relVy * relVy + relVz * relVz);
    var rho = w.rho0 * Math.exp(-alt / w.H);
    var dragK = (0.5 * rho * PHYS.Cd * PHYS.A * speed) / mass;

    // Fin torque, weathervane and damping, all proportional to q.
    var q = 0.5 * rho * speed * speed;
    var finK = q * VEH.finS * VEH.finCL * VEH.finArm;

    // From current mass, not a constant: it shrinks as propellant burns.
    var I = (mass * VEH.L * VEH.L) / 12;

    // Passive restoring torque toward the flow. Gated on speed to keep the
    // asin() below well conditioned.
    var wvPhi = 0, wvPsi = 0;
    if (speed > 2 && relVy < 0) {
      var wgt = clamp(-relVy / speed, 0, 1);
      var phiFlow = Math.asin(clamp(relVx / speed, -1, 1));
      var psiFlow = Math.asin(clamp(-relVz / speed, -1, 1));
      wvPhi = finK * wgt * clamp(phiFlow - s.phi, -0.6, 0.6);
      wvPsi = finK * wgt * clamp(psiFlow - s.psi, -0.6, 0.6);
    }

    // Aerodynamic damping: both the bare body and the fins resist
    // rotation, fins by more than an order of magnitude for this
    // geometry (Article §04).
    var cD = 0.5 * rho * speed * PHYS.A * VEH.L * VEH.L * 0.03
      + 0.5 * rho * speed * VEH.finS * VEH.finCL * VEH.finArm * VEH.finArm;

    return {
      x: s.vx, y: s.vy, z: s.vz,
      vx: (u.thrust * ux) / mass - dragK * relVx,
      vy: (u.thrust * uy) / mass - w.g - dragK * relVy,
      vz: (u.thrust * uz) / mass - dragK * relVz,
      phi: s.wphi, psi: s.wpsi,
      wphi: (-u.thrust * VEH.arm * Math.sin(u.defPhi) - finK * Math.sin(u.finPhi || 0)
        - (u.rcsPhi || 0) * VEH.rcsT * VEH.rcsArm + wvPhi - cD * s.wphi) / I,
      wpsi: (-u.thrust * VEH.arm * Math.sin(u.defPsi) - finK * Math.sin(u.finPsi || 0)
        - (u.rcsPsi || 0) * VEH.rcsT * VEH.rcsArm + wvPsi - cD * s.wpsi) / I
    };
  }
  function advance(s, k, h) {
    var out = {};
    for (var i = 0; i < RK4_FIELDS.length; i++) { var f = RK4_FIELDS[i]; out[f] = s[f] + k[f] * h; }
    return out;
  }
  function rk4Step(s, u, dt, mass) {
    var k1 = derivatives(s, u, mass);
    var k2 = derivatives(advance(s, k1, dt / 2), u, mass);
    var k3 = derivatives(advance(s, k2, dt / 2), u, mass);
    var k4 = derivatives(advance(s, k3, dt), u, mass);
    for (var i = 0; i < RK4_FIELDS.length; i++) {
      var f = RK4_FIELDS[i];
      s[f] += (dt / 6) * (k1[f] + 2 * k2[f] + 2 * k3[f] + k4[f]);
    }
  }

  function stepPhysics(dt) {
    if (state.phase !== "falling") return;
    state.tPlus += dt;
    var mass = VEH.dry + state.fuel;
    var u = state.autopilot ? guidance(dt) : manualControl(dt);

    rk4Step(state, u, dt, mass);
    // Isp is defined against standard Earth gravity by convention, not the
    // local world's -- STD_G0, not world().g, is what belongs here.
    if (u.thrust > 0) state.fuel = Math.max(0, state.fuel - (u.thrust / (PHYS.isp * STD_G0)) * dt);
    state.thrustFrac = u.thrust / VEH.maxT;
    state.defPhi = u.defPhi;
    state.defPsi = u.defPsi;
    state.finPhi = u.finPhi;
    state.finPsi = u.finPsi;
    state.rcsPhi = u.rcsPhi || 0;
    state.rcsPsi = u.rcsPsi || 0;
    var rcsOn = Math.abs(state.rcsPhi) + Math.abs(state.rcsPsi);
    if (rcsOn > 0) {
      state.n2 = Math.max(0, state.n2 - (rcsOn * VEH.rcsT / (VEH.rcsIsp * STD_G0)) * dt);
    }
    // Peak load is a high-water mark, referenced to standard g the way
    // an accelerometer trace would be, not to the local world's gravity.
    state.peakG = Math.max(state.peakG, u.thrust / mass / STD_G0);

    if (state.y <= 0) {
      state.y = 0;
      var vLat = Math.sqrt(state.vx * state.vx + state.vz * state.vz);
      var touchSpeed = Math.sqrt(state.vx * state.vx + state.vy * state.vy + state.vz * state.vz);
      var tilt = Math.sqrt(state.phi * state.phi + state.psi * state.psi);
      var miss = Math.sqrt(state.x * state.x + state.z * state.z);
      state.phase = touchSpeed <= PHYS.vTouch ? "landed" : "crashed";
      state.verdict = {
        vy: Math.abs(state.vy), vh: vLat, tilt: tilt, miss: miss,
        okVy: Math.abs(state.vy) <= LIMITS.vy, okVh: vLat <= LIMITS.vh,
        okTilt: tilt <= LIMITS.tilt, okMiss: miss <= LIMITS.miss
      };
      state.vx = state.vy = state.vz = 0;
      state.wphi = state.wpsi = 0;
      state.thrustFrac = 0;
      if (throttleInput) throttleInput.value = "0";
      updateEngineVisual();
      touchdownEffects(state.phase === "landed");
      showVerdict();
    }
  }

  function showVerdict() {
    if (!state.verdict || !verdictEl) return;
    var v = state.verdict;
    if (verdictTitleEl) {
      verdictTitleEl.textContent = state.phase === "landed" ? "Landed" : "Crashed";
      verdictTitleEl.classList.toggle("tone-ok", state.phase === "landed");
      verdictTitleEl.classList.toggle("tone-bad", state.phase === "crashed");
    }
    function fill(el, val, unit, ok) {
      if (!el) return;
      el.textContent = val.toFixed(1) + " " + unit;
      el.classList.toggle("tone-ok", ok);
      el.classList.toggle("tone-bad", !ok);
    }
    fill(vVyEl, v.vy, "m/s", v.okVy);
    fill(vVhEl, v.vh, "m/s", v.okVh);
    fill(vTiltEl, v.tilt / DEG, "deg", v.okTilt);
    fill(vMissEl, v.miss, "m", v.okMiss);
    verdictEl.hidden = false;
  }

  function updateHud() {
    if (altEl) altEl.textContent = Math.round(state.y);
    if (vspeedEl) vspeedEl.textContent = state.vy.toFixed(1);
    if (fuelEl) fuelEl.textContent = Math.round((state.fuel / (state.fuel0 || VEH.fuel0)) * 100) + "%";
    if (lateralEl) lateralEl.textContent = Math.round(Math.sqrt(state.x * state.x + state.z * state.z));
    if (tiltHudEl) tiltHudEl.textContent = (Math.sqrt(state.phi * state.phi + state.psi * state.psi) / DEG).toFixed(1) + "°";
    if (gimbalHudEl) gimbalHudEl.textContent = (state.defPhi / DEG).toFixed(1) + "° / " + (state.defPsi / DEG).toFixed(1) + "°";
    if (finHudEl) finHudEl.textContent = (state.finPhi / DEG).toFixed(1) + "° / " + (state.finPsi / DEG).toFixed(1) + "°";
    if (rcsHudEl) {
      var firing = Math.abs(state.rcsPhi) + Math.abs(state.rcsPsi) > 0;
      rcsHudEl.textContent = firing ? "firing · " + state.n2.toFixed(1) + " kg" : state.n2.toFixed(1) + " kg";
      rcsHudEl.classList.toggle("tone-ok", firing);
    }
    if (tplusEl) tplusEl.textContent = state.tPlus.toFixed(1) + " s";
    if (tgoHudEl) tgoHudEl.textContent = (state.ignited && state.tGo != null) ? state.tGo.toFixed(1) + " s" : "––";
    if (phaseEl) {
      var label = state.phase === "falling" ? (state.ignited ? "Burn" : "Coast")
        : state.phase === "landed" ? "Landed" : "Crashed";
      phaseEl.textContent = label;
      phaseEl.classList.toggle("tone-ok", state.phase === "landed");
      phaseEl.classList.toggle("tone-bad", state.phase === "crashed");
    }
  }

  // Attitude dial: a top-down view of the tilt plane, where distance from
  // the centre is the tilt angle. Dashed ring is tiltLimit(), green is the
  // touchdown limit, cross is the commanded attitude, dot is actual.
  var ATT_R = 44; // viewBox units at VEH.maxTilt
  var THR_Y0 = 94, THR_H = 88; // throttle bar: y at 0%, and its full height

  function attXY(phi, psi) {
    var k = ATT_R / VEH.maxTilt;
    return {
      x: 50 + clamp(-phi * k, -ATT_R, ATT_R),
      y: 50 - clamp(psi * k, -ATT_R, ATT_R)
    };
  }
  function thrY(f) { return THR_Y0 - THR_H * clamp(f, 0, 1); }

  // Static geometry: the landing tilt limit and the throttle floor don't
  // move, so they're placed once rather than every frame.
  function initInstruments() {
    var safeR = ((ATT_R * LIMITS.tilt) / VEH.maxTilt).toFixed(2);
    if (attSafeEl) attSafeEl.setAttribute("r", safeR);
    if (attSafeFillEl) attSafeFillEl.setAttribute("r", safeR);
    var yMin = thrY(VEH.minThr);
    if (thrDeadEl) {
      thrDeadEl.setAttribute("y", yMin.toFixed(2));
      thrDeadEl.setAttribute("height", (THR_Y0 - yMin).toFixed(2));
    }
    if (thrMinEl) { thrMinEl.setAttribute("y1", yMin.toFixed(2)); thrMinEl.setAttribute("y2", yMin.toFixed(2)); }
  }

  function updateInstruments() {
    var p = attXY(state.phi, state.psi);
    if (attDotEl) {
      attDotEl.setAttribute("cx", p.x.toFixed(2));
      attDotEl.setAttribute("cy", p.y.toFixed(2));
      attDotEl.classList.toggle("over", Math.hypot(state.phi, state.psi) > LIMITS.tilt);
    }
    var c = attXY(state.cmdPhi, state.cmdPsi);
    if (attCmdEl) attCmdEl.setAttribute("transform", "translate(" + c.x.toFixed(2) + " " + c.y.toFixed(2) + ")");
    if (attErrEl) {
      attErrEl.setAttribute("x1", p.x.toFixed(2)); attErrEl.setAttribute("y1", p.y.toFixed(2));
      attErrEl.setAttribute("x2", c.x.toFixed(2)); attErrEl.setAttribute("y2", c.y.toFixed(2));
    }
    if (attLimEl) attLimEl.setAttribute("r", ((ATT_R * tiltLimit(state.y)) / VEH.maxTilt).toFixed(2));

    if (thrFillEl) {
      var yTop = thrY(state.thrustFrac);
      thrFillEl.setAttribute("y", yTop.toFixed(2));
      thrFillEl.setAttribute("height", Math.max(0, THR_Y0 - yTop).toFixed(2));
      thrFillEl.style.opacity = state.thrustFrac > 0 ? "1" : "0";
    }
    // Throttle that would cancel weight. On Earth it falls inside the band
    // the engine cannot run in, which is why the vehicle cannot hover.
    if (thrHoverEl) {
      var yh = thrY(((VEH.dry + state.fuel) * world().g) / VEH.maxT);
      thrHoverEl.setAttribute("y1", yh.toFixed(2));
      thrHoverEl.setAttribute("y2", yh.toFixed(2));
    }
  }

  // ---- flight strip ------------------------------------------------
  // Throttled to ~12 Hz: these are 24 DOM text writes and nothing here
  // changes fast enough to be worth doing every frame.
  var lastStrip = 0;
  function setCell(id, v, u) {
    var el = document.getElementById("rd-" + id);
    if (el) el.textContent = v;
    var ue = document.getElementById("ru-" + id);
    if (ue) ue.textContent = u || "";
  }
  function fmt(v, d) { return (Math.abs(v) < 1e-9 ? 0 : v).toFixed(d == null ? 1 : d); }
  function fmtInt(v) { return Math.round(v).toLocaleString("en-US"); }

  function updateReadout(now) {
    if (now - lastStrip < 80) return;
    lastStrip = now;

    var w = world();
    var mass = VEH.dry + state.fuel;
    var aMax = VEH.maxT / mass;
    var thrust = state.thrustFrac * VEH.maxT;
    var alt = Math.max(state.y, 0);
    var rho = w.rho0 * Math.exp(-alt / w.H);
    var sp = Math.hypot(state.vx, state.vy, state.vz);
    var q = 0.5 * rho * sp * sp;
    // Same slender-rod inertia the physics integrates with, so the fin
    // authority shown is the number actually acting on the vehicle.
    var I = (mass * VEH.L * VEH.L) / 12;

    setCell("mass", fmtInt(mass), " kg");
    setCell("twr", fmt(thrust / (mass * w.g), 2), "");
    setCell("amax", fmt(aMax, 1), " m/s²");
    // Tsiolkovsky over the propellant that is still aboard.
    setCell("dv", fmtInt(PHYS.isp * STD_G0 * Math.log(mass / VEH.dry)), " m/s");
    setCell("q", fmtInt(q), " Pa");
    setCell("acmd", state.gAcmd != null ? fmt(state.gAcmd, 1) : "—", " m/s²");
    setCell("kappa", state.gKappa != null ? fmt(Math.max(0, state.gKappa), 2) : "—", "");
    setCell("zem", state.gZem != null ? fmtInt(state.gZem) : "—", " m");
    setCell("vref", state.gVref != null ? fmt(state.gVref, 1) : "—", " m/s");
    setCell("peak", fmt(state.peakG, 2), " g");
    setCell("fin", fmt(state.finPhi / DEG, 1) + " / " + fmt(state.finPsi / DEG, 1), " °");
    setCell("finq", fmt((q * VEH.finS * VEH.finCL * VEH.finArm) / I, 3), " rad/s²");
  }

  function resetRun() {
    var autopilot = state.autopilot;
    state = defaultState();
    state.autopilot = autopilot;
    manualPhiCmd = 0; manualPsiCmd = 0;
    if (throttleInput) throttleInput.value = "0";
    if (verdictEl) verdictEl.hidden = true;
    if (rocket) rocket.visible = true; // a crash hides it; a reset brings it back
    clearParticles();
    updateEngineVisual();
  }

  function resize() {
    var w = canvas.clientWidth, h = canvas.clientHeight;
    if (!w || !h) return;
    renderer.setSize(w, h, false);
    camera.aspect = w / h;
    camera.updateProjectionMatrix();
  }

  // ---- maximize + the stats drawer ----
  var stage = document.getElementById("rlStage");
  var fullBtn = document.getElementById("rlFull");
  var statsBtn = document.getElementById("rlStatsToggle");

  function isFullscreen() {
    return document.fullscreenElement === stage || document.webkitFullscreenElement === stage;
  }

  var fullEnterIcon = document.getElementById("rlFullEnter");
  var fullExitIcon = document.getElementById("rlFullExit");

  function syncFullscreen() {
    var fs = isFullscreen();
    if (fullBtn) {
      var label = fs ? "Minimize" : "Maximize";
      fullBtn.title = label;
      fullBtn.setAttribute("aria-label", label);
    }
    // SVG elements do not reflect the hidden IDL attribute, so `.hidden = x`
    // would set an inert JS property instead of the attribute.
    if (fullEnterIcon) fullEnterIcon.toggleAttribute("hidden", fs);
    if (fullExitIcon) fullExitIcon.toggleAttribute("hidden", !fs);
    if (!fs) stage.classList.remove("stats-open");
    if (statsBtn) statsBtn.setAttribute("aria-expanded", String(stage.classList.contains("stats-open")));
    resize();
  }

  if (fullBtn && stage) {
    fullBtn.addEventListener("click", function () {
      if (isFullscreen()) {
        if (document.exitFullscreen) document.exitFullscreen();
        else if (document.webkitExitFullscreen) document.webkitExitFullscreen();
      } else if (stage.requestFullscreen) {
        stage.requestFullscreen();
      } else if (stage.webkitRequestFullscreen) {
        stage.webkitRequestFullscreen();
      }
      fullBtn.blur();
    });
  }
  if (statsBtn && stage) {
    statsBtn.addEventListener("click", function () {
      stage.classList.toggle("stats-open");
      statsBtn.setAttribute("aria-expanded", String(stage.classList.contains("stats-open")));
      statsBtn.blur();
    });
  }
  document.addEventListener("fullscreenchange", syncFullscreen);
  document.addEventListener("webkitfullscreenchange", syncFullscreen);

  buildLights();
  buildGround();
  buildRocket();
  buildParticles();
  resize();
  if (window.ResizeObserver) new ResizeObserver(resize).observe(canvas);
  else window.addEventListener("resize", resize);

  // Reads the last applied control, not the slider, which is disabled
  // under autopilot.
  function updateEngineVisual() {
    var pct = state.autopilot ? Math.round(state.thrustFrac * 100) : (throttleInput ? Number(throttleInput.value) : 0);
    var t = state.thrustFrac;
    if (throttleLabel) throttleLabel.textContent = pct + "%";

    // Flicker as a sum of incommensurate sines (the reference file's own
    // trick): it breathes instead of strobing the way per-frame random
    // does, because no two components ever line up twice.
    var tms = performance.now();
    var flick = 0.9 + 0.062 * Math.sin(tms * 0.019) + 0.041 * Math.sin(tms * 0.043 + 1.4)
      + 0.027 * Math.sin(tms * 0.087 + 2.6);
    var on = t > 0.01;
    if (glowSprite) {
      glowSprite.visible = on;
      if (on) {
        glowSprite.scale.setScalar((10 + 16 * t) * flick);
        glowSprite.material.opacity = 0.5 * t * flick;
      }
    }
    if (plumeLight && rocket) {
      // Track the nozzle in world space -- the same point the plume
      // particles spawn from, so light and smoke agree.
      plumeLight.position.copy(
        new THREE.Vector3(0, -VEH.arm, 0).applyEuler(rocket.rotation).add(rocket.position)
      );
      plumeLight.intensity = on ? (2.2 + 1.8 * t) * flick : 0;
      plumeLight.distance = 400 + 600 * t;
    }
    if (nozzleGroup) {
      nozzleGroup.rotation.set(0, 0, 0);
      nozzleGroup.rotation.x = state.defPsi;
      nozzleGroup.rotation.z = -state.defPhi;
    }
  }

  // Model loaded: scrub its own baked animations to a deploy fraction
  // instead of driving the placeholder's procedural rotation.
  function scrubDeploy(deployed) {
    if (!modelMixer) return;
    for (var j = 0; j < modelActions.length; j++) {
      modelActions[j].time = deployed * modelActions[j].getClip().duration;
    }
    modelMixer.update(0);
  }

  // Legs fold flush against the body at altitude and swing down to the
  // fixed resting pose over the last 600 m -- no physics behind the
  // deploy itself, just a cue tied to altitude.
  function updateLegs() {
    var deployed = 1 - clamp(state.y / 600, 0, 1);

    if (modelMixer) { scrubDeploy(deployed); return; }

    var angle = LEG_FOLD + (LEG_SPLAY - LEG_FOLD) * deployed;
    // Local Z, not X: after the mount's Y-rotation, X is the radial
    // direction, so rotating around it swings the leg sideways.
    for (var i = 0; i < legParts.length; i++) legParts[i].rotation.z = angle;
  }

  var clock = new THREE.Clock();
  function tick() {
    requestAnimationFrame(tick);
    var dt = Math.min(clock.getDelta(), 0.1);
    // Simulated time, which is what the physics and the plume run on.
    // Capped independently of `dt` so 4x on a stuttering frame can't ask
    // for a hundred substeps at once and stall the tab further.
    var simDt = Math.min(dt * simRate, 0.25);
    // Fixed-step physics regardless of frame rate, then everything else
    // reads the resulting state.
    var remaining = simDt;
    while (remaining > 0) {
      var h = Math.min(PHYS.step, remaining);
      stepPhysics(h);
      remaining -= h;
    }
    rocket.position.set(state.x, restY + state.y, state.z);
    // Visual-only tilt -- an approximation of Article §01's û(φ,ψ) frame,
    // not a rederivation of it; good enough for a placeholder body.
    rocket.rotation.set(0, 0, 0);
    rocket.rotation.z = -state.phi;
    rocket.rotation.x = state.psi;
    updateLegs();
    // Camera smoothing stays on WALL time -- slowing the sim should give
    // you a longer look at the same motion, not a sluggish camera.
    updateCamera(dt);
    updateEngineVisual();
    emitPlume(simDt);
    emitAirflow(simDt);
    emitRcs(simDt);
    updateParticles(simDt);
    updateHud();
    updateInstruments();
    updateReadout(performance.now());
    renderer.render(scene, camera);
  }

  function setAutopilot(on) {
    state.autopilot = on;
    if (throttleInput) throttleInput.disabled = on;
    if (autopilotBtn) {
      autopilotBtn.textContent = on ? "Autopilot: On" : "Autopilot: Off";
      autopilotBtn.classList.toggle("active", on);
    }
    // Manual: the instruments stop being a readout and start being the
    // controls, so they get the accent treatment and the key legend.
    if (instrumentsEl) instrumentsEl.classList.toggle("manual", !on);
    if (!on) { manualPhiCmd = state.phi; manualPsiCmd = state.psi; }
  }

  if (throttleInput) throttleInput.addEventListener("input", updateEngineVisual);
  if (resetBtn) resetBtn.addEventListener("click", resetRun);
  if (windInput) windInput.addEventListener("input", function () {
    if (windLabel) windLabel.textContent = windInput.value + " m/s";
  });
  // Gravity/atmosphere can't sensibly change mid-fall, so picking a new
  // world just starts the run over under it.
  if (worldSelect) worldSelect.addEventListener("change", function () {
    resetRun();
    applyWorldLook();
  });
  if (scenarioSelect) scenarioSelect.addEventListener("change", resetRun);
  if (autopilotBtn) autopilotBtn.addEventListener("click", function () {
    setAutopilot(!state.autopilot);
    autopilotBtn.blur(); // don't leave the toggle holding focus over manual flight keys
  });
  camButtons.forEach(function (btn) {
    btn.addEventListener("click", function () {
      camRig.mode = btn.dataset.cam;
      camButtons.forEach(function (b) { b.classList.toggle("active", b === btn); });
      if (camNameEl) camNameEl.textContent = btn.textContent;
    });
  });
  rateButtons.forEach(function (btn) {
    btn.addEventListener("click", function () {
      simRate = Number(btn.dataset.rate);
      rateButtons.forEach(function (b) { b.classList.toggle("active", b === btn); });
      var txt = btn.textContent.trim();
      if (rateLabel) rateLabel.textContent = txt;
      if (rateHudEl) rateHudEl.textContent = txt;
      // Only worth screen space when it's telling you something.
      if (rateRowEl) rateRowEl.hidden = simRate === 1;
      btn.blur();
    });
  });

  // Drag to orbit, wheel/pinch to zoom -- on every view mode, same as the
  // reference file. Pointer Events cover mouse, touch and pen in one path.
  var dragging = false, lastPX = 0, lastPY = 0;
  canvas.addEventListener("pointerdown", function (e) {
    dragging = true; lastPX = e.clientX; lastPY = e.clientY;
    canvas.setPointerCapture(e.pointerId);
  });
  canvas.addEventListener("pointermove", function (e) {
    if (!dragging) return;
    camRig.userTheta += (e.clientX - lastPX) * -0.006;
    camRig.userPhi += (e.clientY - lastPY) * 0.006;
    lastPX = e.clientX; lastPY = e.clientY;
  });
  canvas.addEventListener("pointerup", function (e) {
    dragging = false;
    try { canvas.releasePointerCapture(e.pointerId); } catch (err) {}
  });
  canvas.addEventListener("wheel", function (e) {
    e.preventDefault();
    camRig.distMul = clamp(camRig.distMul * (1 + e.deltaY * 0.001), 0.2, 5);
  }, { passive: false });

  // Manual flight keys -- only live once autopilot is off, and only when
  // focus isn't already on a form control (so arrow keys still work
  // normally on the wind slider, world/scenario selects, etc).
  var MANUAL_KEY_MAP = {
    KeyW: "throttleUp", ArrowUp: "throttleUp",
    KeyS: "throttleDown", ArrowDown: "throttleDown",
    KeyA: "left", ArrowLeft: "left",
    KeyD: "right", ArrowRight: "right",
    KeyQ: "back", KeyE: "fwd"
  };
  window.addEventListener("keydown", function (e) {
    var action = MANUAL_KEY_MAP[e.code];
    if (!action || state.autopilot) return;
    // Don't steal arrow keys from inputs and selects. Buttons are excluded:
    // the autopilot toggle keeps focus after the click.
    var tag = document.activeElement && document.activeElement.tagName;
    if (tag === "INPUT" || tag === "SELECT" || tag === "TEXTAREA") return;
    manualKeys[action] = true;
    e.preventDefault();
  });
  window.addEventListener("keyup", function (e) {
    var action = MANUAL_KEY_MAP[e.code];
    if (action) manualKeys[action] = false;
  });

  initInstruments();
  setAutopilot(state.autopilot);
  updateEngineVisual();
  updateHud();
  updateInstruments();
  updateReadout(performance.now());
  tick();

</script>

<!--
  Tab switching is deliberately its own script. The simulator below waits on
  a dynamic import before it runs, and anything sharing that module would be
  stuck behind the same await -- including, previously, this, which meant the
  tabs went dead until three.js had landed.
-->
<script>
  var tabs = document.querySelectorAll(".rl-tabbtn");
  var panels = document.querySelectorAll(".rl-tab");

  function show(target, writeHash) {
    var known = false;
    tabs.forEach(function (b) { if (b.dataset.tab === target) known = true; });
    if (!known) return;
    tabs.forEach(function (b) { b.classList.toggle("active", b.dataset.tab === target); });
    panels.forEach(function (p) { p.hidden = p.dataset.tab !== target; });
    // replaceState, not a hash assignment: setting location.hash would make
    // the browser hunt for an element of that id and jump the page.
    if (writeHash) history.replaceState(null, "", "#" + target);
  }

  tabs.forEach(function (btn) {
    btn.addEventListener("click", function () { show(btn.dataset.tab, true); });
  });

  /* The article moved to its own route. Anything already pointing at the old
     in-page tab -- shared links, the RSS entry that shipped before the move --
     lands here, so send it on rather than showing the simulator silently. */
  if (location.hash === "#article") {
    location.replace("/writing/landing-a-booster");
  }
  show(location.hash.slice(1), false);
  window.addEventListener("hashchange", function () { show(location.hash.slice(1), false); });
</script>

<style>
