<script is:inline>
"use strict";
/* ============================================================
 * SLAM playground v2 — pipeline:
 *   raycast LiDAR -> noisy odometry -> occupancy grid
 *   -> ICP scan matching, GPS + IMU compass fusion
 *      (Kalman-style: prediction grows P, measurements shrink it)
 * World units: 1 unit = 1 canvas px (world is 560x560).
 * ============================================================ */

/* ---------- world definition (wall segments) ---------- */
const W = 560;
const WALLS = [
  [10,10, 550,10],[550,10, 550,550],[550,550, 10,550],[10,550, 10,10],
  [180,180, 380,180],[380,180, 380,380],[380,380, 230,380],[180,380, 180,180],
  [10,140, 120,140],[440,10, 440,120],[550,420, 430,420],[120,550, 120,440],
];

/* ---------- tunables ---------- */
const BEAMS = 180, MAXR = 220;
const CELL = 4, GN = W / CELL;
const L_FREE = -0.35, L_OCC = 0.9, L_CLAMP = 4;
const SPEED = 95, TURN = 2.3;
const WHEELBASE = 18, STEER_MAX = 0.55, STEER_RATE = 2.8;  // car (bicycle model)
const STRAFE = 76;                                          // drone lateral speed
const KF_DIST = 14, KF_ROT = 0.35;
const ICP_ITERS = 8, ICP_MAX_D = 16, ICP_MIN_PAIRS = 25;
/* sensor models */
const GPS_SIGMA  = 8,    GPS_R  = GPS_SIGMA*GPS_SIGMA;   // position fix noise
const GPS_PERIOD = 50;                                   // frames between fixes (~1 Hz)
const COMP_SIGMA = 0.05, COMP_R = COMP_SIGMA*COMP_SIGMA; // compass noise (rad)
const COMP_PERIOD = 14;

/* ---------- state ---------- */
const START = {x:80, y:80, th:0.0};
let truth, dead, est;
let Ppos, Pth;                        // pose covariance (scalar approx)
let logodds = new Float32Array(GN*GN);
let trailT = [], trailD = [], trailE = [];
let keyframe = null, kfCount = 0, lastScan = null;
let gpsFixes = [];                    // recent fixes for rendering
let steer = 0;                        // car steering angle (rad)

function resetRun(){
  truth = {...START}; dead = {...START}; est = {...START};
  Ppos = 4; Pth = 0.01; steer = 0;
  logodds.fill(0);
  trailT = [{...START}]; trailD = [{...START}]; trailE = [{...START}];
  keyframe = null; kfCount = 0; lastScan = null; gpsFixes = [];
}
resetRun();

/* ---------- small math helpers ---------- */
let spare = null;
function randn(){
  if (spare !== null){ const v = spare; spare = null; return v; }
  let u = 0, v = 0;
  while (u === 0) u = Math.random();
  while (v === 0) v = Math.random();
  const m = Math.sqrt(-2 * Math.log(u));
  spare = m * Math.sin(2*Math.PI*v);
  return m * Math.cos(2*Math.PI*v);
}
const clamp = (v,a,b)=> v<a?a : v>b?b : v;
const wrapAngle = a => Math.atan2(Math.sin(a), Math.cos(a));

/* ---------- raycasting ---------- */
function castRay(px,py,dx,dy){
  let best = Infinity;
  for (const [ax,ay,bx,by] of WALLS){
    const rx = bx-ax, ry = by-ay;
    const denom = dx*ry - dy*rx;
    if (Math.abs(denom) < 1e-9) continue;
    const t = ((ax-px)*ry - (ay-py)*rx) / denom;
    const s = ((ax-px)*dy - (ay-py)*dx) / denom;
    if (t >= 0 && s >= 0 && s <= 1 && t < best) best = t;
  }
  return best;
}

/* ---------- LiDAR scan from the TRUE pose ---------- */
function scan(noiseSigma){
  const out = new Array(BEAMS);
  for (let i = 0; i < BEAMS; i++){
    const a = (i / BEAMS) * 2*Math.PI - Math.PI;
    const wa = truth.th + a;
    const t = castRay(truth.x, truth.y, Math.cos(wa), Math.sin(wa));
    let r, hit;
    if (t < MAXR){ r = Math.max(1, t + randn()*noiseSigma); hit = true; }
    else        { r = MAXR; hit = false; }
    out[i] = {a, r, hit};
  }
  return out;
}

/* ---------- body-frame motion integration (forward, lateral, rotation) ----------
 * Lateral (l) is only nonzero for the holonomic drone; for wheeled vehicles
 * the non-holonomic constraint forces l = 0. Odometry noise is built inline
 * in the main loop, proportional to actual motion. */
function integrate3(p, f, l, r){
  p.x += f*Math.cos(p.th) - l*Math.sin(p.th);
  p.y += f*Math.sin(p.th) + l*Math.cos(p.th);
  p.th = wrapAngle(p.th + r);
}

/* ---------- Kalman-style prediction: motion inflates uncertainty ---------- */
function predictCovariance(dtrans, drot, k){
  const sT  = 0.07*k*Math.abs(dtrans);                       // translational noise std
  const sR  = 0.05*k*Math.abs(drot) + 0.0035*k*Math.abs(dtrans);
  Pth  = Math.min(2,    Pth  + sR*sR);
  /* heading uncertainty leaks into position: err ≈ dtrans * σθ */
  Ppos = Math.min(2e4,  Ppos + sT*sT + dtrans*dtrans*Pth);
}

/* ---------- sensor updates: measurements shrink uncertainty ----------
 * Absolute fixes move the estimate, so the local keyframe map must move
 * WITH it — otherwise relative ICP just drags the pose back to the old
 * (drifted) chain and the sensors fight each other. Re-anchoring the
 * keyframe is a one-node version of pose-graph relaxation. */
const K_CAP = 0.35;                       // limit per-fix jump (smoothness)
function reanchorKeyframe(dx, dy, dth, px, py){
  if (!keyframe) return;
  const c = Math.cos(dth), s = Math.sin(dth);
  for (const p of keyframe.pts){
    const rx = p.x - px, ry = p.y - py;
    p.x = px + c*rx - s*ry + dx;
    p.y = py + s*rx + c*ry + dy;
  }
  const rx = keyframe.pose.x - px, ry = keyframe.pose.y - py;
  keyframe.pose = {x: px + c*rx - s*ry + dx, y: py + s*rx + c*ry + dy,
                   th: wrapAngle(keyframe.pose.th + dth)};
}
function gpsUpdate(){
  const zx = truth.x + randn()*GPS_SIGMA;
  const zy = truth.y + randn()*GPS_SIGMA;
  const ix = zx - est.x, iy = zy - est.y;
  /* innovation gate: a fix landing far outside our claimed uncertainty
     means the filter is inconsistent — inflate P and admit being lost,
     instead of confidently ignoring reality */
  if ((ix*ix + iy*iy) / (Ppos + GPS_R) > 9){
    Ppos = Math.min(2e4, Ppos*4 + 50);
    Pth  = Math.min(2,   Pth*2 + 0.02);
  }
  const K = Math.min(K_CAP, Ppos / (Ppos + GPS_R));
  const dx = K*ix, dy = K*iy;
  est.x += dx; est.y += dy;
  Ppos = Math.max(1.5, Ppos*(1 - K));      // floor: never freeze GPS out
  reanchorKeyframe(dx, dy, 0, est.x, est.y);
  gpsFixes.push({x:zx, y:zy, t:frame});
  if (gpsFixes.length > 24) gpsFixes.shift();
}
function compassUpdate(){
  const zth = truth.th + randn()*COMP_SIGMA;
  const innov = wrapAngle(zth - est.th);
  if (innov*innov / (Pth + COMP_R) > 9){
    Pth = Math.min(2, Pth*4 + 0.05);       // inconsistent — inflate
  }
  const K = Math.min(0.25, Pth / (Pth + COMP_R));
  const dth = K * innov;
  est.th = wrapAngle(est.th + dth);
  Pth = Math.max(0.0005, Pth*(1 - K));
  if (Math.abs(dth) > 1e-4) reanchorKeyframe(0, 0, dth, est.x, est.y);
}

/* ---------- ICP: align current scan to keyframe points ---------- */
function icpAlign(src, ref, pose){
  let p = {...pose};
  for (let iter = 0; iter < ICP_ITERS; iter++){
    const c = Math.cos(p.th), s = Math.sin(p.th);
    const pairs = [];
    for (const q of src){
      const wx = p.x + c*q.x - s*q.y;
      const wy = p.y + s*q.x + c*q.y;
      let bj = -1, bd = ICP_MAX_D * ICP_MAX_D;
      for (let j = 0; j < ref.length; j++){
        const dx = ref[j].x - wx, dy = ref[j].y - wy, d = dx*dx + dy*dy;
        if (d < bd){ bd = d; bj = j; }
      }
      if (bj >= 0) pairs.push([wx, wy, ref[bj].x, ref[bj].y]);
    }
    if (pairs.length < ICP_MIN_PAIRS) return pose;
    let ax=0, ay=0, bx=0, by=0;
    for (const [x1,y1,x2,y2] of pairs){ ax+=x1; ay+=y1; bx+=x2; by+=y2; }
    const n = pairs.length; ax/=n; ay/=n; bx/=n; by/=n;
    let dot=0, cross=0;
    for (const [x1,y1,x2,y2] of pairs){
      const ux=x1-ax, uy=y1-ay, vx=x2-bx, vy=y2-by;
      dot   += ux*vx + uy*vy;
      cross += ux*vy - uy*vx;
    }
    const dth = Math.atan2(cross, dot);
    const cd = Math.cos(dth), sd = Math.sin(dth);
    const tx = bx - (cd*ax - sd*ay);
    const ty = by - (sd*ax + cd*ay);
    const nx = cd*p.x - sd*p.y + tx;
    const ny = sd*p.x + cd*p.y + ty;
    const moved = Math.hypot(nx - p.x, ny - p.y);
    p = {x:nx, y:ny, th: wrapAngle(p.th + dth)};
    if (moved < 0.01 && Math.abs(dth) < 1e-4) break;
  }
  return p;
}
function scanPointsRobot(sc){
  const pts = [];
  for (let i = 0; i < sc.length; i += 2){
    const b = sc[i];
    if (b.hit) pts.push({x: b.r*Math.cos(b.a), y: b.r*Math.sin(b.a)});
  }
  return pts;
}
function toWorld(pts, p){
  const c = Math.cos(p.th), s = Math.sin(p.th);
  return pts.map(q => ({x: p.x + c*q.x - s*q.y, y: p.y + s*q.x + c*q.y}));
}

/* ---------- occupancy grid ---------- */
function bresenham(x0,y0,x1,y1,cb){
  let dx = Math.abs(x1-x0), sx = x0<x1 ? 1 : -1;
  let dy = -Math.abs(y1-y0), sy = y0<y1 ? 1 : -1;
  let err = dx + dy;
  for(;;){
    cb(x0,y0);
    if (x0 === x1 && y0 === y1) break;
    const e2 = 2*err;
    if (e2 >= dy){ err += dy; x0 += sx; }
    if (e2 <= dx){ err += dx; y0 += sy; }
  }
}
function updateGrid(pose, sc){
  const cx = clamp(Math.floor(pose.x/CELL), 0, GN-1);
  const cy = clamp(Math.floor(pose.y/CELL), 0, GN-1);
  for (let i = 0; i < sc.length; i += 2){
    const b = sc[i];
    const wa = pose.th + b.a;
    const r = Math.min(b.r, MAXR);
    const gx = clamp(Math.floor((pose.x + r*Math.cos(wa))/CELL), 0, GN-1);
    const gy = clamp(Math.floor((pose.y + r*Math.sin(wa))/CELL), 0, GN-1);
    bresenham(cx, cy, gx, gy, (x,y)=>{
      if (x === gx && y === gy) return;
      const k = y*GN + x;
      logodds[k] = Math.max(-L_CLAMP, logodds[k] + L_FREE);
    });
    if (b.hit){
      const k = gy*GN + gx;
      logodds[k] = Math.min(L_CLAMP, logodds[k] + L_OCC);
    }
  }
}

/* ---------- input ----------
 * a/d and ←/→ are tracked separately: ground vehicles treat both as
 * turn/steer; the drone strafes with A/D and yaws with ←/→. */
const keys = {fwd:false, back:false, a:false, d:false, al:false, ar:false};
const KEYMAP = {KeyW:'fwd', ArrowUp:'fwd', KeyS:'back', ArrowDown:'back',
                KeyA:'a', KeyD:'d', ArrowLeft:'al', ArrowRight:'ar'};
addEventListener('keydown', e=>{ const k = KEYMAP[e.code]; if(k){keys[k]=true; e.preventDefault();} });
addEventListener('keyup',   e=>{ const k = KEYMAP[e.code]; if(k){keys[k]=false;} });
for (const btn of document.querySelectorAll('.dpad button')){
  const k = btn.dataset.k;
  btn.addEventListener('pointerdown', e=>{ keys[k]=true; e.preventDefault(); });
  btn.addEventListener('pointerup',   ()=> keys[k]=false);
  btn.addEventListener('pointerleave',()=> keys[k]=false);
}

/* ---------- controls + tabs ---------- */
const $ = id => document.getElementById(id);
const ui = {noise:$('noise'), drift:$('drift'), icp:$('icp'), gps:$('gps'), imu:$('imu'), veh:$('veh')};
const VEH_HINT = {
  diff:  'turns in place — A/D or ←/→',
  car:   'no turning in place — A/D steers, must roll to turn',
  drone: 'A/D strafe sideways, ←/→ yaw'
};
ui.veh.onchange = ()=>{ $('vehHint').textContent = VEH_HINT[ui.veh.value]; steer = 0; };
ui.noise.oninput = ()=> $('noiseV').textContent = (+ui.noise.value).toFixed(1);
ui.drift.oninput = ()=> $('driftV').textContent = (+ui.drift.value).toFixed(1);
$('reset').onclick = resetRun;
$('tabbar').addEventListener('click', e=>{
  const t = e.target.dataset && e.target.dataset.t;
  if (!t) return;
  document.querySelectorAll('.tabbar button').forEach(b=>b.classList.toggle('active', b.dataset.t===t));
  document.querySelectorAll('.pane').forEach(p=>p.classList.toggle('active', p.id==='pane-'+t));
});

/* ---------- rendering ---------- */
const wctx = $('world').getContext('2d');
const bctx = $('belief').getContext('2d');
const gridCanvas = document.createElement('canvas');
gridCanvas.width = GN; gridCanvas.height = GN;
const gctx = gridCanvas.getContext('2d');
const gridImg = gctx.createImageData(GN, GN);

function drawRobot(ctx, p, color){
  ctx.save();
  ctx.translate(p.x, p.y); ctx.rotate(p.th);
  ctx.fillStyle = color; ctx.strokeStyle = color;
  const m = ui.veh.value;
  if (m === 'car'){
    ctx.fillRect(-9, -5, 15, 10);                        // body
    ctx.beginPath();                                     // nose
    ctx.moveTo(12,0); ctx.lineTo(6,-5); ctx.lineTo(6,5);
    ctx.closePath(); ctx.fill();
  } else if (m === 'drone'){
    ctx.lineWidth = 2;
    ctx.beginPath();                                     // cross frame
    ctx.moveTo(-6,-6); ctx.lineTo(6,6); ctx.moveTo(-6,6); ctx.lineTo(6,-6);
    ctx.stroke();
    for (const [qx,qy] of [[-6,-6],[6,6],[-6,6],[6,-6]]){
      ctx.beginPath(); ctx.arc(qx, qy, 3.5, 0, 2*Math.PI); ctx.stroke();
    }
    ctx.beginPath();                                     // heading tick
    ctx.moveTo(11,0); ctx.lineTo(4,-3); ctx.lineTo(4,3);
    ctx.closePath(); ctx.fill();
  } else {
    ctx.beginPath();
    ctx.moveTo(11,0); ctx.lineTo(-7,6); ctx.lineTo(-4,0); ctx.lineTo(-7,-6);
    ctx.closePath(); ctx.fill();
  }
  ctx.restore();
}
function drawTrail(ctx, trail, color, dashed){
  if (trail.length < 2) return;
  ctx.strokeStyle = color; ctx.lineWidth = 1.5;
  ctx.setLineDash(dashed ? [4,4] : []);
  ctx.beginPath();
  ctx.moveTo(trail[0].x, trail[0].y);
  for (const p of trail) ctx.lineTo(p.x, p.y);
  ctx.stroke();
  ctx.setLineDash([]);
}
function renderWorld(sc){
  wctx.fillStyle = '#0d1117'; wctx.fillRect(0,0,W,W);
  if (sc){
    wctx.strokeStyle = 'rgba(255,180,84,0.16)'; wctx.lineWidth = 1;
    wctx.beginPath();
    for (let i = 0; i < sc.length; i += 3){
      const b = sc[i], wa = truth.th + b.a;
      wctx.moveTo(truth.x, truth.y);
      wctx.lineTo(truth.x + b.r*Math.cos(wa), truth.y + b.r*Math.sin(wa));
    }
    wctx.stroke();
  }
  wctx.strokeStyle = '#aab8c5'; wctx.lineWidth = 2.5; wctx.lineCap = 'round';
  wctx.beginPath();
  for (const [ax,ay,bx,by] of WALLS){ wctx.moveTo(ax,ay); wctx.lineTo(bx,by); }
  wctx.stroke();
  drawTrail(wctx, trailT, 'rgba(74,222,128,0.55)', false);
  drawRobot(wctx, truth, '#4ade80');
}
function renderBelief(fusionOn){
  const d = gridImg.data;
  for (let i = 0; i < GN*GN; i++){
    const t = 1 / (1 + Math.exp(-logodds[i]));
    let r,g,b;
    if (t > 0.5){ const u = (t-0.5)*2;
      r = 27 + u*(230-27); g = 35 + u*(237-35); b = 48 + u*(243-48);
    } else {      const u = (0.5-t)*2;
      r = 27 - u*13; g = 35 - u*15; b = 48 - u*16;
    }
    d[i*4]=r; d[i*4+1]=g; d[i*4+2]=b; d[i*4+3]=255;
  }
  gctx.putImageData(gridImg, 0, 0);
  bctx.imageSmoothingEnabled = false;
  bctx.clearRect(0,0,W,W);
  bctx.drawImage(gridCanvas, 0, 0, W, W);

  /* GPS fixes: fading yellow crosses */
  for (const f of gpsFixes){
    const age = (frame - f.t) / 200;
    if (age > 1) continue;
    bctx.strokeStyle = `rgba(250,204,21,${0.85*(1-age)})`;
    bctx.lineWidth = 1.5;
    bctx.beginPath();
    bctx.moveTo(f.x-4, f.y-4); bctx.lineTo(f.x+4, f.y+4);
    bctx.moveTo(f.x-4, f.y+4); bctx.lineTo(f.x+4, f.y-4);
    bctx.stroke();
  }

  drawTrail(bctx, trailT, 'rgba(74,222,128,0.7)', true);
  drawTrail(bctx, trailD, 'rgba(248,113,113,0.8)', false);
  if (fusionOn) drawTrail(bctx, trailE, 'rgba(56,189,248,0.9)', false);

  const shown = fusionOn ? est : dead;
  /* uncertainty circle: 2σ position confidence */
  const rad = Math.min(120, 2*Math.sqrt(Ppos));
  bctx.strokeStyle = 'rgba(56,189,248,0.35)';
  bctx.fillStyle   = 'rgba(56,189,248,0.06)';
  bctx.lineWidth = 1;
  bctx.beginPath();
  bctx.arc(shown.x, shown.y, rad, 0, 2*Math.PI);
  bctx.fill(); bctx.stroke();

  drawRobot(bctx, shown, fusionOn ? '#38bdf8' : '#f87171');
}

/* ---------- main loop ---------- */
let frame = 0, last = performance.now();
function tick(now){
  const dt = Math.min(0.05, (now - last)/1000); last = now;
  frame++;
  const fusionOn = ui.icp.checked || ui.gps.checked || ui.imu.checked;

  /* ---- drive the true robot under the selected motion model ---- */
  const model = ui.veh.value;
  let df = 0, dl = 0, dr = 0;                 // body-frame deltas: fwd, lateral, rot
  if (model === 'car'){
    /* non-holonomic bicycle model: heading change is COUPLED to rolling */
    const v = (keys.fwd ? SPEED : 0) - (keys.back ? SPEED*0.6 : 0);
    const want = (((keys.d||keys.ar)?1:0) - ((keys.a||keys.al)?1:0)) * STEER_MAX;
    steer += clamp(want - steer, -STEER_RATE*dt, STEER_RATE*dt);
    df = v*dt;                                // dr derived AFTER collision below
  } else if (model === 'drone'){
    /* holonomic: translation in any direction, yaw independent */
    df = ((keys.fwd ? SPEED : 0) - (keys.back ? SPEED : 0)) * dt;
    dl = ((keys.a ? STRAFE : 0) - (keys.d ? STRAFE : 0)) * dt;   // +left
    dr = ((keys.ar ? TURN : 0) - (keys.al ? TURN : 0)) * dt;
  } else {
    /* diff-drive point robot: forward + rotate in place */
    df = ((keys.fwd ? SPEED : 0) - (keys.back ? SPEED*0.6 : 0)) * dt;
    dr = (((keys.d||keys.ar) ? TURN : 0) - ((keys.a||keys.al) ? TURN : 0)) * dt;
  }

  /* wall stop along the actual direction of travel; blocked wheels/rotors
     produce no encoder motion (the wheel-slip lesson) */
  let aF = 0, aL = 0;
  const mag = Math.hypot(df, dl);
  if (mag > 0){
    const ma = truth.th + Math.atan2(dl, df);
    const ahead = castRay(truth.x, truth.y, Math.cos(ma), Math.sin(ma));
    if (ahead > mag + 9){
      truth.x += df*Math.cos(truth.th) - dl*Math.sin(truth.th);
      truth.y += df*Math.sin(truth.th) + dl*Math.cos(truth.th);
      aF = df; aL = dl;
    }
  }
  if (model === 'car') dr = (aF / WHEELBASE) * Math.tan(steer);  // constraint:
  truth.th = wrapAngle(truth.th + dr);                           // no roll, no turn

  /* odometry: ACTUAL motion, corrupted; prediction inflates P */
  const aMag = Math.hypot(aF, aL);
  const moving = aMag !== 0 || dr !== 0;
  if (moving){
    const k = +ui.drift.value;
    const nF = aF*(1 + 0.02*k) + randn()*0.05*k*Math.abs(aF);
    const nL = aL*(1 + 0.02*k) + randn()*0.05*k*Math.abs(aL);
    const nR = dr + randn()*0.05*k*Math.abs(dr)
                  + randn()*0.0025*k*aMag
                  + 0.0009*k*aF;              // systematic bias
    integrate3(dead, nF, nL, nR);
    integrate3(est,  nF, nL, nR);
    predictCovariance(aMag, dr, k);
  }

  /* sense + scan match + map (every 2nd frame).
     Order matters: relative ICP first, absolute sensors LAST,
     so ICP can't immediately undo GPS/compass corrections. */
  let sc = lastScan;
  if (frame % 2 === 0){
    sc = lastScan = scan(+ui.noise.value);

    if (ui.icp.checked){
      const src = scanPointsRobot(sc);
      if (keyframe && src.length >= ICP_MIN_PAIRS){
        const prev = est;                  // icpAlign returns prev on failure
        const fit = icpAlign(src, keyframe.pts, est);
        const jump = Math.hypot(fit.x - est.x, fit.y - est.y);
        const jrot = Math.abs(wrapAngle(fit.th - est.th));
        /* gate: between consecutive scans the legitimate correction is tiny;
           a huge "correction" means ICP snapped to a wrong local minimum
           (aliasing) — reject it and trust odometry instead */
        if (fit !== prev && jump < 8 && jrot < 0.25){
          est = fit;
          /* ICP is RELATIVE (to a drifting keyframe chain), so it must not
             collapse absolute uncertainty — keep GPS gain alive */
          Ppos = Math.min(Ppos, 25);
          Pth  = Math.min(Pth, 0.02);
        }
      }
      const needKF = !keyframe
        || Math.hypot(est.x - keyframe.pose.x, est.y - keyframe.pose.y) > KF_DIST
        || Math.abs(wrapAngle(est.th - keyframe.pose.th)) > KF_ROT;
      if (needKF && src.length >= ICP_MIN_PAIRS){
        keyframe = {pts: toWorld(src, est), pose: {...est}};
        kfCount++;
      }
    }

    /* absolute measurement updates (these also re-anchor the keyframe) */
    if (ui.gps.checked && frame % GPS_PERIOD === 0) gpsUpdate();
    if (ui.imu.checked && frame % COMP_PERIOD === 0) compassUpdate();

    const mapPose = fusionOn ? est : dead;
    if (moving || frame < 30) updateGrid(mapPose, sc);
  }

  /* trails (sampled, length-capped) */
  if (frame % 6 === 0){
    trailT.push({x:truth.x, y:truth.y});
    trailD.push({x:dead.x,  y:dead.y});
    trailE.push({x:est.x,   y:est.y});
    if (trailT.length > 2200){ trailT.shift(); trailD.shift(); trailE.shift(); }
  }

  renderWorld(sc);
  renderBelief(fusionOn);

  if (frame % 15 === 0){
    $('errDead').textContent = Math.hypot(dead.x-truth.x, dead.y-truth.y).toFixed(1);
    $('errEst').textContent  = Math.hypot(est.x-truth.x,  est.y-truth.y).toFixed(1);
    $('sigPos').textContent  = Math.sqrt(Ppos).toFixed(1);
    $('kfCount').textContent = kfCount;
  }
  requestAnimationFrame(tick);
}
requestAnimationFrame(tick);
</script>
