  <dialog id="boeScenarioDialog" class="boe-export-dialog boe-scenario-dialog">
    <div class="boe-export-head">
      <h3>Saved states</h3>
      <button type="button" class="boe-export-x" id="scenarioClose" aria-label="Close">×</button>
    </div>

    <p class="boe-scenario-blurb">
      Four slots in this browser. A slot stores every tab's numbers, the latency
      hops, and the diagram.
    </p>

    <div id="scenarioSlots"></div>

    <p class="boe-scenario-note" id="scenarioNote" role="status" aria-live="polite"></p>
  </dialog>

  <!-- Global, matching ExportDialog.astro: the slot and preset rows are built
       in presets.js at open time, so they never carry this component's own
       data-astro-cid attribute and scoped styles would miss them. -->
  <style is:global>
    .boe-scenario-dialog { width: min(560px, calc(100vw - 32px)); }
    .boe-scenario-blurb {
      font-family: var(--font-body); font-size: 13px; line-height: 1.6;
      color: var(--card-desc); margin: 0 0 18px;
    }
    .boe-slot {
      display: flex; align-items: center; gap: 12px;
      border: 1px solid var(--card-border); padding: 11px 13px;
      margin-bottom: 6px;
    }
    .boe-slot-meta { flex: 1 1 auto; min-width: 0; }
    .boe-slot-name {
      display: block; font-family: var(--font-mono); font-size: 12.5px;
      color: var(--headline-color);
    }
    .boe-slot-sub {
      display: block; font-family: var(--font-mono); font-size: 10.5px;
      color: var(--card-desc); margin-top: 4px;
    }
    /* An empty slot reads as a placeholder, not as content. */
    .boe-slot:not(.filled) .boe-slot-name { color: var(--card-desc); }

    .boe-slot-acts { display: flex; gap: 6px; flex: 0 0 auto; }
    .boe-slot-btn {
      font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.06em;
      text-transform: uppercase; color: var(--card-desc); background: transparent;
      border: 1px solid var(--card-border); padding: 6px 10px; cursor: pointer;
      transition: border-color .2s ease, color .2s ease;
    }
    .boe-slot-btn:hover { border-color: var(--card-label); color: var(--card-label); }
    .boe-slot-btn.primary { color: var(--headline-color); }
    .boe-slot-btn.danger:hover { border-color: var(--tone-bad); color: var(--tone-bad); }

    .boe-scenario-note {
      font-family: var(--font-mono); font-size: 11px; color: var(--card-label);
      margin: 4px 0 0; min-height: 15px;
    }
  </style>
