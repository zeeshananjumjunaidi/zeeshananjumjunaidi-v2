    }
    return false;
  }

  // Repaint in place rather than re-rendering nodes, so a calculator change
  // mid-drag does not tear down the element being dragged.
  function refreshMetrics() {
    var grew = false;
    nodeLayer.querySelectorAll(".dg-node-metric").forEach(function (el) {
      paintMetric(el);
      var host = el.closest(".dg-node");
      var node = host && nodeById(host.dataset.id);
      if (node && fitNodeHeight(host, node)) grew = true;
    });
    if (grew) renderEdges();
  }

  function setSelectionMetric(id) {
    if (selectedNodeIds.size === 0) return;
    pushUndo();
    selectedNodeIds.forEach(function (n) {
      var node = nodeById(n);
      if (!node || node.type === "container") return;
      node.metric = id ? canonicalId(id) : null;
      if (id && node.h < METRIC_MIN_H) node.h = METRIC_MIN_H;
    });
    renderNodes();
    renderEdges();
    save();
  }

  function currentMetricId() {
    var first = selectedNodeIds.values().next();
    var node = first.done ? null : nodeById(first.value);
    return node ? node.metric || null : null;
  }

  function createNodeEl(node) {
    var el = document.createElement("div");
    var animClass = (node.animate === "heartbeat" || node.animate === "error") ? " dg-anim-" + node.animate : "";
    el.className = "dg-node" + (node.type === "container" ? " container" : "") + (node.icon ? " has-icon" : "")
      + (node.metric ? " has-metric" : "") + animClass;
    el.dataset.id = node.id;
    if (node.color) el.dataset.color = node.color;
    el.dataset.shape = node.shape || "rect";
    // Catches nodes that arrived from an import or an older save at a height
    // that would clip the metric line.
    if (node.metric && node.h < METRIC_MIN_H) node.h = METRIC_MIN_H;
    el.style.left = node.x + "px";
    el.style.top = node.y + "px";
    el.style.width = node.w + "px";
    el.style.height = node.h + "px";

    if (node.icon && NODE_ICONS[node.icon]) {
      var iconWrap = document.createElement("div");
      iconWrap.className = "dg-node-icon";
      iconWrap.innerHTML = iconSvg(node.icon, "dg-node-icon-svg");
      el.appendChild(iconWrap);
    }

    var label = document.createElement("div");
    label.className = "dg-node-label";
    label.textContent = node.label;
    label.spellcheck = false;
    el.appendChild(label);

    if (node.metric) {
      var metricEl = document.createElement("div");
      metricEl.className = "dg-node-metric";
      metricEl.dataset.metric = node.metric;
      el.appendChild(metricEl);
      paintMetric(metricEl);
    }

    if (node.animate === "notify") {
      var badge = document.createElement("div");
      badge.className = "dg-node-badge";
      el.appendChild(badge);
    } else if (node.animate === "fill") {
      var fillBar = document.createElement("div");
      fillBar.className = "dg-node-fillbar";
      var fillBarInner = document.createElement("div");
      fillBarInner.className = "dg-node-fillbar-inner";
      fillBar.appendChild(fillBarInner);
      el.appendChild(fillBar);
    } else if (node.animate === "spinner") {
      var spinner = document.createElement("div");
      spinner.className = "dg-node-spinner";
      spinner.innerHTML = '<svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="2" stroke-dasharray="26 12" stroke-linecap="round"/></svg>';
      el.appendChild(spinner);
    }
    // Heartbeat/Error don't add an element -- they're a class on the node
    // itself (animClass, set above), animating its own border/box-shadow.

    portSides(node).forEach(function (side) {
      var port = document.createElement("div");
      port.className = "dg-port dg-port-" + side;
      port.dataset.side = side;
      el.appendChild(port);
    });

    // Resize from any side. Text nodes size themselves to their content, so
    // they get no handles at all.
    var handles = [];
    if (node.shape !== "text") {
      SIDES_8.forEach(function (side) {
        var h = document.createElement("div");
        h.className = "dg-resize-handle dg-rs-" + side;
        h.dataset.side = side;
        el.appendChild(h);
        handles.push(h);
      });
    }

    nodeLayer.appendChild(el);
    fitNodeHeight(el, node);
    wireNodeEvents(el, node, label, handles);
    return el;
  }

  function renderNodes() {
    nodeLayer.innerHTML = "";
    nodes.forEach(createNodeEl);
    applyNodeSelectionClasses();
  }

  function clipPoint(cx, cy, w, h, dx, dy) {
    if (dx === 0 && dy === 0) return { x: cx, y: cy };
    var halfW = w / 2, halfH = h / 2;
    var scaleX = dx !== 0 ? halfW / Math.abs(dx) : Infinity;
    var scaleY = dy !== 0 ? halfH / Math.abs(dy) : Infinity;
    var s = Math.min(scaleX, scaleY);
    return { x: cx + dx * s, y: cy + dy * s };
  }

  // Elbow routers take their turn axis from the ports' normals when anchored,
  // from the dominant delta when not, or an edge leaving an east port would
  // set off northwards.
  var ELBOW_R = 10;

  function axisOf(dir, dx, dy) {
    if (dir && dir[0] !== 0 && dir[1] === 0) return "h";
    if (dir && dir[1] !== 0 && dir[0] === 0) return "v";
    return Math.abs(dx) >= Math.abs(dy) ? "h" : "v";
  }

  // `bend` (0..1) is where along the run the turn happens; null means the
  // midpoint. Only the same-axis case has that freedom -- a perpendicular
  // pair has exactly one corner and nothing to slide.
  function elbowPoints(p1, p2, d1, d2, bend) {
    var dx = p2.x - p1.x, dy = p2.y - p1.y;
    var a1 = axisOf(d1, dx, dy);
    var a2 = axisOf(d2, -dx, -dy);
    var t = (typeof bend === "number" && isFinite(bend)) ? clamp(bend, 0.02, 0.98) : 0.5;
    if (a1 === a2) {
      return a1 === "h"
        ? [p1, { x: p1.x + dx * t, y: p1.y }, { x: p1.x + dx * t, y: p2.y }, p2]
        : [p1, { x: p1.x, y: p1.y + dy * t }, { x: p2.x, y: p1.y + dy * t }, p2];
    }
    return a1 === "h" ? [p1, { x: p2.x, y: p1.y }, p2] : [p1, { x: p1.x, y: p2.y }, p2];
  }
  // True when the route has a slidable turn -- drives whether a bend handle
  // is worth drawing.
  function elbowIsSlidable(p1, p2, d1, d2) {
    var dx = p2.x - p1.x, dy = p2.y - p1.y;
    return axisOf(d1, dx, dy) === axisOf(d2, -dx, -dy);
  }

  function polylinePath(pts) {
    return pts.map(function (p, i) {
      return (i ? "L " : "M ") + p.x.toFixed(1) + " " + p.y.toFixed(1);
    }).join(" ");
  }

  // Same corner points as the orthogonal router, but each turn is replaced by
  // a quadratic arc pulled back along both legs -- clamped to half the shorter
  // leg so a tight elbow degrades to a sharp corner instead of overshooting.
  function roundedPath(pts) {
    if (pts.length < 3) return polylinePath(pts);
    var d = "M " + pts[0].x.toFixed(1) + " " + pts[0].y.toFixed(1);
    for (var i = 1; i < pts.length - 1; i++) {
      var prev = pts[i - 1], cur = pts[i], next = pts[i + 1];
      var l1 = Math.hypot(cur.x - prev.x, cur.y - prev.y);
      var l2 = Math.hypot(next.x - cur.x, next.y - cur.y);
      var r = Math.min(ELBOW_R, l1 / 2, l2 / 2);
      if (r < 0.5) { d += " L " + cur.x.toFixed(1) + " " + cur.y.toFixed(1); continue; }
      var t1 = { x: cur.x + (prev.x - cur.x) / l1 * r, y: cur.y + (prev.y - cur.y) / l1 * r };
      var t2 = { x: cur.x + (next.x - cur.x) / l2 * r, y: cur.y + (next.y - cur.y) / l2 * r };
      d += " L " + t1.x.toFixed(1) + " " + t1.y.toFixed(1) +
           " Q " + cur.x.toFixed(1) + " " + cur.y.toFixed(1) + " " + t2.x.toFixed(1) + " " + t2.y.toFixed(1);
    }
    var last = pts[pts.length - 1];
    return d + " L " + last.x.toFixed(1) + " " + last.y.toFixed(1);
  }

  function unit(v) {
    var m = Math.hypot(v[0], v[1]) || 1;
    return [v[0] / m, v[1] / m];
  }
  function curvedPath(p1, p2, d1, d2) {
    var dx = p2.x - p1.x, dy = p2.y - p1.y;
    // Normalised, or a corner port's [1,-1] reaches sqrt(2) further than an
    // edge port's [1,0] and the curve slings out past both nodes.
    var k = Math.max(30, Math.min(110, Math.hypot(dx, dy) * 0.36));
    var a1 = axisOf(d1, dx, dy), a2 = axisOf(d2, -dx, -dy);
    var s1 = unit(d1 ? d1 : (a1 === "h" ? [Math.sign(dx) || 1, 0] : [0, Math.sign(dy) || 1]));
    var s2 = unit(d2 ? d2 : (a2 === "h" ? [Math.sign(-dx) || -1, 0] : [0, Math.sign(-dy) || -1]));
    var c1 = { x: p1.x + s1[0] * k, y: p1.y + s1[1] * k };
    var c2 = { x: p2.x + s2[0] * k, y: p2.y + s2[1] * k };
    return "M " + p1.x.toFixed(1) + " " + p1.y.toFixed(1) +
      " C " + c1.x.toFixed(1) + " " + c1.y.toFixed(1) +
      ", " + c2.x.toFixed(1) + " " + c2.y.toFixed(1) +
      ", " + p2.x.toFixed(1) + " " + p2.y.toFixed(1);
  }

  function edgePathD(routing, p1, p2, d1, d2, bend) {
    if (routing === "orthogonal") return polylinePath(elbowPoints(p1, p2, d1, d2, bend));
    if (routing === "rounded") return roundedPath(elbowPoints(p1, p2, d1, d2, bend));
    if (routing === "curved") return curvedPath(p1, p2, d1, d2);
    return polylinePath([p1, p2]);
  }

  // Drag either end of a selected connector onto a different node, or onto a
  // different port of the same node. Dropping anywhere else puts it back --
  // an endpoint has to land on something.
  function addEndpointHandle(g, edge, which, at) {
    // A node port sits underneath with a 26px hit area, so the grip needs a
    // bigger target or a few pixels off starts a new connection instead.
    var hit = document.createElementNS(SVGNS, "circle");
    hit.setAttribute("class", "dg-edge-endpoint-hit");
    hit.setAttribute("r", "16");
    hit.setAttribute("cx", at.x);
    hit.setAttribute("cy", at.y);
    g.appendChild(hit);

    var dot = document.createElementNS(SVGNS, "circle");
    dot.setAttribute("class", "dg-edge-endpoint");
    dot.setAttribute("data-edge", edge.id);
    dot.setAttribute("r", "5");
    dot.setAttribute("cx", at.x);
    dot.setAttribute("cy", at.y);
    g.appendChild(dot);

    var h = hit;

    h.addEventListener("pointerdown", function (e) {
      if (e.button !== 0) return;
      e.stopPropagation();
      h.setPointerCapture(e.pointerId);
      draggingEdgeHandle = true;
      var pre = snapshotState();
      var otherId = which === "from" ? edge.to : edge.from;
      var hoverId = null;

      function setHover(id) {
        if (id === hoverId) return;
        if (hoverId) {
          var prev = nodeLayer.querySelector('[data-id="' + hoverId + '"]');
          if (prev) prev.classList.remove("drop-target");
        }
        if (id) {
          var next = nodeLayer.querySelector('[data-id="' + id + '"]');
          if (next) next.classList.add("drop-target");
        }
        hoverId = id;
      }

      function onMove(ev) {
        var pt = screenToCanvas(ev.clientX, ev.clientY);
        // Same forgiving target as drawing a new connection -- endpoints used
        // to demand a direct hit, which is why re-aiming one felt impossible.
        var id = dropTargetAt(ev.clientX, ev.clientY, otherId);
        setHover(id);

        if (id) {
          var n = nodeById(id);
          if (n) {
            var side = nearestPortSide(n, pt.x, pt.y);
            if (which === "from") { edge.from = id; edge.fromPort = side; }
            else { edge.to = id; edge.toPort = side; }
            renderEdges();
            var anchor = portPoint(n, side);
            h.setAttribute("cx", anchor.x);
            h.setAttribute("cy", anchor.y);
            dot.setAttribute("cx", anchor.x);
            dot.setAttribute("cy", anchor.y);
            return;
          }
        }
        // Free-floating: the grip follows the pointer without committing.
        h.setAttribute("cx", pt.x);
        h.setAttribute("cy", pt.y);
        dot.setAttribute("cx", pt.x);
        dot.setAttribute("cy", pt.y);
      }
      function onUp() {
        h.removeEventListener("pointermove", onMove);
        h.removeEventListener("pointerup", onUp);
        setHover(null);
        draggingEdgeHandle = false;
        commitUndo(pre);
        renderEdges();
        save();
      }
      h.addEventListener("pointermove", onMove);
      h.addEventListener("pointerup", onUp);
    });
  }

  // Slide the elbow. The turn runs along one axis, so only the movement
  // across that axis matters; the handle stores it back as a 0..1 fraction
  // of the run so it survives the nodes moving afterwards.
  function addBendHandle(g, edge, p1, p2, d1, d2) {
    var pts = elbowPoints(p1, p2, d1, d2, edge.bend);
    if (pts.length < 4) return;
    var mid = { x: (pts[1].x + pts[2].x) / 2, y: (pts[1].y + pts[2].y) / 2 };
    var horiz = Math.abs(pts[1].x - p1.x) > Math.abs(pts[1].y - p1.y);

    var h = document.createElementNS(SVGNS, "circle");
    h.setAttribute("class", "dg-edge-bend");
    h.setAttribute("r", "5");
    h.setAttribute("cx", mid.x);
    h.setAttribute("cy", mid.y);
    g.appendChild(h);

    h.addEventListener("pointerdown", function (e) {
      if (e.button !== 0) return;
      e.stopPropagation();
      h.setPointerCapture(e.pointerId);
      draggingEdgeHandle = true;
      var pre = snapshotState();
      var span = horiz ? (p2.x - p1.x) : (p2.y - p1.y);

      function onMove(ev) {
        if (!span) return;
        var pt = screenToCanvas(ev.clientX, ev.clientY);
        var along = horiz ? (pt.x - p1.x) : (pt.y - p1.y);
        edge.bend = clamp(along / span, 0.02, 0.98);
        renderEdges();
        // Keep the grip under the cursor while the edge redraws beneath it.
        var pts = elbowPoints(p1, p2, d1, d2, edge.bend);
        if (pts.length >= 4) {
          h.setAttribute("cx", (pts[1].x + pts[2].x) / 2);
          h.setAttribute("cy", (pts[1].y + pts[2].y) / 2);
        }
      }
      function onUp() {
        h.removeEventListener("pointermove", onMove);
        h.removeEventListener("pointerup", onUp);
        draggingEdgeHandle = false;
        commitUndo(pre);
        renderEdges();
        save();
      }
      h.addEventListener("pointermove", onMove);
      h.addEventListener("pointerup", onUp);
    });
  }

  function wireEdgeEvents(g, edge) {
    g.addEventListener("pointerdown", function (e) {
      if (e.button !== 0) return;
      e.stopPropagation();
      selectEdgeOnly(edge.id);
    });
    g.addEventListener("dblclick", function (e) {
      e.stopPropagation();
      openEdgeLabelEditor(edge);
    });
  }

  // Rebuilding handleLayer mid-drag would delete the element holding the
  // pointer capture, killing the gesture after one frame.
  var draggingEdgeHandle = false;

  function renderEdges() {
    edgeLayer.innerHTML = "";
    if (handleLayer && !draggingEdgeHandle) handleLayer.innerHTML = "";
    edges.forEach(function (edge) {
      var a = nodeById(edge.from), b = nodeById(edge.to);
      if (!a || !b) return;
      var acx = a.x + a.w / 2, acy = a.y + a.h / 2;
      var bcx = b.x + b.w / 2, bcy = b.y + b.h / 2;
      var dx = bcx - acx, dy = bcy - acy;
      // An edge anchored to a port stays on that port; an unanchored one keeps
      // the original behaviour of sliding around the border to face the other
      // node, so diagrams made before ports existed look exactly as they did.
      var d1 = null, d2 = null, p1, p2;
      if (edge.fromPort && PORT_AT[edge.fromPort]) {
        p1 = portPoint(a, edge.fromPort); d1 = PORT_DIR[edge.fromPort];
      } else {
        p1 = clipPoint(acx, acy, a.w, a.h, dx, dy);
      }
      if (edge.toPort && PORT_AT[edge.toPort]) {
        p2 = portPoint(b, edge.toPort); d2 = PORT_DIR[edge.toPort];
      } else {
        p2 = clipPoint(bcx, bcy, b.w, b.h, -dx, -dy);
      }

      var routing = edge.routing || "straight";
      var pathD = edgePathD(routing, p1, p2, d1, d2, edge.bend);

      var g = document.createElementNS(SVGNS, "g");
      g.setAttribute("data-id", edge.id);
      g.setAttribute("class", "dg-edge" + (edge.id === selectedEdgeId ? " selected" : ""));
      // Attached up front: getPointAtLength() below needs the path to be in
      // the document to report geometry, and the label position depends on it.
      edgeLayer.appendChild(g);

      var hit = document.createElementNS(SVGNS, "path");
      hit.setAttribute("class", "dg-edge-hit");
      hit.setAttribute("d", pathD);
      hit.setAttribute("fill", "none");

      var line = document.createElementNS(SVGNS, "path");
      line.setAttribute("d", pathD);
      line.setAttribute("fill", "none");

      var arrowStyle = edge.arrowStyle || "one";
      if (arrowStyle !== "none") line.setAttribute("marker-end", "url(#dgArrow)");
      if (arrowStyle === "both") line.setAttribute("marker-start", "url(#dgArrow)");

      // "dashed" is a static line style; "dash" flow reuses the same dash
      // pattern but animates its offset (marching ants) to read as motion.
      var flowAlt = edge.flowDirection === "alternate";
      var lineClass = "dg-edge-line";
      var dash = edge.lineStyle === "dashed" ? "6 4" : null;
      if (edge.flow === "dash") {
        dash = dash || "6 4";
        lineClass += " dg-flow-dash" + (flowAlt ? " dg-flow-alt" : "");
      }
      if (dash) line.setAttribute("stroke-dasharray", dash);
      line.setAttribute("class", lineClass);

      g.appendChild(hit);
      g.appendChild(line);

      // The label rides the real geometry rather than the straight-line
      // midpoint, so it stays on an elbow or a curve instead of floating off
      // in the space the connector no longer passes through.
      edge._mid = { x: (p1.x + p2.x) / 2, y: (p1.y + p2.y) / 2 };
      if (routing !== "straight" && line.getTotalLength) {
        try {
          var half = line.getPointAtLength(line.getTotalLength() / 2);
          if (half) edge._mid = { x: half.x, y: half.y };
        } catch (err) { /* not laid out yet -- the straight midpoint will do */ }
      }

      if (edge.flow === "dot") {
        var dot = document.createElementNS(SVGNS, "circle");
        dot.setAttribute("r", "3");
        dot.setAttribute("class", "dg-edge-flow-dot" + (flowAlt ? " dg-flow-alt" : ""));
        dot.style.offsetPath = "path('" + pathD + "')";
        g.appendChild(dot);
      }

      if (edge.flow === "packet") {
        var pw = 14, ph = 10;
        var packet = document.createElementNS(SVGNS, "g");
        packet.setAttribute("class", "dg-edge-flow-packet" + (flowAlt ? " dg-flow-alt" : ""));
        var pbody = document.createElementNS(SVGNS, "rect");
        pbody.setAttribute("class", "dg-edge-flow-packet-body");
        pbody.setAttribute("x", -pw / 2); pbody.setAttribute("y", -ph / 2);
        pbody.setAttribute("width", pw); pbody.setAttribute("height", ph);
        pbody.setAttribute("rx", 1.5);
        var pflap = document.createElementNS(SVGNS, "path");
        pflap.setAttribute("class", "dg-edge-flow-packet-flap");
        pflap.setAttribute("d", "M " + (-pw / 2) + " " + (-ph / 2) + " L 0 1 L " + (pw / 2) + " " + (-ph / 2));
        packet.appendChild(pbody);
        packet.appendChild(pflap);
        packet.style.offsetPath = "path('" + pathD + "')";
        g.appendChild(packet);
      }

      if (edge.label) {
        var w = Math.max(20, edge.label.length * 6 + 10);
        var rect = document.createElementNS(SVGNS, "rect");
        rect.setAttribute("class", "dg-edge-label-bg");
        rect.setAttribute("x", edge._mid.x - w / 2);
        rect.setAttribute("y", edge._mid.y - 8);
        rect.setAttribute("width", w);
        rect.setAttribute("height", 16);

        var text = document.createElementNS(SVGNS, "text");
        text.setAttribute("class", "dg-edge-label");
        text.setAttribute("x", edge._mid.x);
        text.setAttribute("y", edge._mid.y + 3.5);
        text.setAttribute("text-anchor", "middle");
        text.textContent = edge.label;

        g.appendChild(rect);
        g.appendChild(text);
      }

      // Editing handles, only on the selected edge: one grip per endpoint to
      // re-aim it at another node or port, and (where the route has a
      // slidable turn) one on the elbow to move where it bends.
      if (edge.id === selectedEdgeId && handleLayer && !draggingEdgeHandle) {
        addEndpointHandle(handleLayer, edge, "from", p1);
        addEndpointHandle(handleLayer, edge, "to", p2);
        if ((routing === "orthogonal" || routing === "rounded") && elbowIsSlidable(p1, p2, d1, d2)) {
          addBendHandle(handleLayer, edge, p1, p2, d1, d2);
        }
      }

      wireEdgeEvents(g, edge);
    });
    renderGroupOverlay();
  }

  function openEdgeLabelEditor(edge) {
    var mid = edge._mid || { x: 0, y: 0 };
    edgeInput.style.left = (view.panX + view.zoom * mid.x) + "px";
    edgeInput.style.top = (view.panY + view.zoom * mid.y) + "px";
    edgeInput.value = edge.label || "";
    edgeInput.hidden = false;
    edgeInput.focus();
    edgeInput.select();

    function commit() {
      var newLabel = edgeInput.value.trim();
      if (newLabel !== (edge.label || "")) {
        pushUndo();
        edge.label = newLabel;
      }
      edgeInput.hidden = true;
      edgeInput.removeEventListener("blur", commit);
      edgeInput.removeEventListener("keydown", onKeydown);
      renderEdges();
      save();
    }
    function onKeydown(e) {
      if (e.key === "Enter") {
        e.preventDefault();
        edgeInput.blur();
      } else if (e.key === "Escape") {
        edgeInput.hidden = true;
        edgeInput.removeEventListener("blur", commit);
        edgeInput.removeEventListener("keydown", onKeydown);
      }
    }
    edgeInput.addEventListener("blur", commit);
    edgeInput.addEventListener("keydown", onKeydown);
  }

  function addNode(x, y, type, extra) {
    var isContainer = type === "container";
    var isText = type === "text";
    extra = extra || {};
    var node = {
      id: uid(),
      x: x, y: y,
      w: isContainer ? 320 : (isText ? 110 : 140),
      h: isContainer ? 220 : (isText ? 28 : 56),
      label: extra.label || (isContainer ? "Container" : (isText ? "Text" : "Component")),
      type: isContainer ? "container" : "box",
      shape: extra.shape || (isText ? "text" : "rect"),
      icon: extra.icon || "",
      parentId: null,
      color: null
    };
    // A container can nest inside another container too (a Subnet dropped
    // inside a VPC), same auto-parent as a plain box dropped inside one.
    var c = containerAt(x + node.w / 2, y + node.h / 2, null);
    if (c) node.parentId = c.id;
    pushUndo();
