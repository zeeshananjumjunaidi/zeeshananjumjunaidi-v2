  // Recursive: a container's "children" includes anything nested inside a
  // child container too, so dragging the outermost container (say a VPC)
  // carries a Subnet inside it, and everything inside that Subnet, together.
  function containerChildren(containerId) {
    var direct = nodes.filter(function (n) { return n.parentId === containerId; });
    var ids = direct.map(function (n) { return n.id; });
    direct.forEach(function (n) {
      if (n.type === "container") ids = ids.concat(containerChildren(n.id));
