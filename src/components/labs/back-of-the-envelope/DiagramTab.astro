  </div>

<style is:global>
.dg-root { margin-top: 4px; }
.dg-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-bottom: 12px; }
.dg-chip {
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--card-label); border: 1px dashed var(--card-label); padding: 7px 12px;
  cursor: grab; user-select: none; background: transparent;
}
.dg-chip:active { cursor: grabbing; }
.dg-chip-btn { cursor: pointer; font: inherit; }
.dg-tool-group { display: flex; align-items: center; gap: 6px; }
.dg-zoom-val { font-family: var(--font-mono); font-size: 11px; color: var(--card-desc); min-width: 34px; text-align: center; }
.dg-btn {
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--card-desc); background: transparent; border: 1px solid var(--card-border);
  padding: 6px 10px; cursor: pointer; transition: border-color .3s ease, color .3s ease;
}
.dg-btn:hover { border-color: var(--card-label); color: var(--headline-color); }
.dg-btn:disabled { opacity: 0.35; cursor: default; pointer-events: none; }
.dg-btn-danger { color: var(--tone-bad); }
.dg-btn-danger:hover { border-color: var(--tone-bad); color: var(--tone-bad); }
.dg-toolbar-spacer { flex: 1 1 auto; }

.dg-btn-icon { display: inline-flex; align-items: center; justify-content: center; padding: 6px; }
.dg-icon {
  width: 16px; height: 16px; fill: none; stroke: currentColor;
  stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round;
}
/* Browsers don't apply the UA [hidden] { display: none } rule to inline
   <svg> elements at all (it's scoped to the HTML namespace), so the
   fullscreen button's enter/exit icon swap needs its own explicit rule --
   without this, both icons render side by side regardless of the hidden
   attribute's state. */
.dg-icon[hidden] { display: none; }

/* --dg-canvas-h is the single source of truth for how tall this tool is --
   both the canvas and the sidebar read it, so they can never end up two
   different heights (the sidebar used to just grow past the canvas once it
   had enough icon groups to need it, since align-items:stretch only grows
   items that are shorter than the row, never shrinks one that's taller). */
.dg-body { display: flex; align-items: stretch; gap: 0; --dg-canvas-h: 600px; }
.dg-sidebar {
  width: 190px; flex-shrink: 0; border: 1px solid var(--card-border); border-right: 0;
  background: var(--card-bg); overflow-y: auto; max-height: var(--dg-canvas-h);
  transition: width .2s ease, opacity .2s ease, border-width .2s ease;
}
.dg-sidebar.collapsed { width: 0; opacity: 0; border-width: 0; overflow: hidden; }

.dg-sidebar-search-wrap { position: sticky; top: 0; background: var(--card-bg); padding: 8px; border-bottom: 1px solid var(--card-border); z-index: 1; }
.dg-sidebar-search {
  width: 100%; background: transparent; border: 1px solid var(--card-border); border-radius: 0;
  padding: 5px 8px; color: var(--headline-color); font-family: var(--font-mono); font-size: 11.5px; outline: none;
}
.dg-sidebar-search:focus { border-color: var(--card-label); }

.dg-sidebar-group { border-bottom: 1px solid var(--card-border); }
.dg-sidebar-group:last-child { border-bottom: 0; }
/* [hidden] and .dg-sidebar-item's own display:flex tie on specificity --
   same class of bug noted elsewhere in this file. Gate on :not([hidden]). */
.dg-sidebar-group[hidden] { display: none; }
.dg-sidebar-heading {
  display: flex; align-items: center; justify-content: space-between; width: 100%;
  font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.12em; text-transform: uppercase;
  color: var(--card-desc); background: transparent; border: 0; cursor: pointer;
  padding: 10px 12px 6px; white-space: nowrap; transition: color .15s ease;
}
.dg-sidebar-heading:hover { color: var(--headline-color); }
.dg-sidebar-chevron { font-size: 9px; transition: transform .15s ease; }
.dg-sidebar-group.dg-group-collapsed .dg-sidebar-chevron { transform: rotate(-90deg); }
.dg-sidebar-group-items { padding-bottom: 4px; }
.dg-sidebar-group.dg-group-collapsed .dg-sidebar-group-items { display: none; }
/* Search overrides a manual collapse so a match is never hidden by it. */
.dg-sidebar.searching .dg-sidebar-group.dg-group-collapsed .dg-sidebar-group-items { display: block; }

.dg-sidebar-item:not([hidden]) {
  display: flex; align-items: center; gap: 8px; padding: 6px 12px; cursor: grab;
  font-family: var(--font-mono); font-size: 11.5px; color: var(--headline-color); white-space: nowrap;
  transition: background .15s ease, color .15s ease;
}
.dg-sidebar-item:hover { background: color-mix(in srgb, var(--card-label) 10%, transparent); color: var(--card-label); }
.dg-sidebar-item:active { cursor: grabbing; }
.dg-sidebar-item-icon { width: 16px; height: 16px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }

@media (max-width: 640px) {
  .dg-body { flex-direction: column; }
  .dg-sidebar {
    width: auto; max-height: 220px; border-right: 1px solid var(--card-border); border-bottom: 0;
    transition: max-height .2s ease, opacity .2s ease, border-width .2s ease;
  }
  .dg-sidebar.collapsed { max-height: 0; width: auto; }
}

.dg-canvas-wrap {
  position: relative; height: var(--dg-canvas-h); border: 1px solid var(--card-border); background: var(--card-bg);
  overflow: hidden; cursor: grab; touch-action: none; flex: 1 1 auto; min-width: 0;
  background-image: radial-gradient(color-mix(in srgb, var(--card-border) 70%, transparent) 1px, transparent 1px);
  background-size: 22px 22px;
}
.dg-canvas-wrap.panning { cursor: grabbing; }
.dg-viewport { position: absolute; left: 0; top: 0; transform-origin: 0 0; }
.dg-svg { position: absolute; left: 0; top: 0; width: 1px; height: 1px; overflow: visible; pointer-events: none; }
.dg-svg #dgArrow path { fill: var(--card-desc); }

.dg-node {
  position: absolute; display: flex; align-items: center; justify-content: center; text-align: center;
  background: var(--card-bg); border: 1px solid var(--card-border); padding: 6px 10px; box-sizing: border-box;
  font-family: var(--font-body); font-size: 13px; color: var(--headline-color); cursor: grab; user-select: none;
  touch-action: none;
}
.dg-node:active { cursor: grabbing; }

/* Each color is a single cool, muted hue blended into the theme's own card
   tokens via color-mix, so the tint stays soft and adapts to dark/light
   automatically instead of needing separate hardcoded values per theme.
   Placed before .selected/.drop-target below so those still win the border. */
.dg-node[data-color="slate"] { background: color-mix(in srgb, #7c8aa5 16%, var(--card-bg)); border-color: color-mix(in srgb, #7c8aa5 55%, var(--card-border)); }
.dg-node[data-color="blue"] { background: color-mix(in srgb, #5b8def 16%, var(--card-bg)); border-color: color-mix(in srgb, #5b8def 55%, var(--card-border)); }
.dg-node[data-color="teal"] { background: color-mix(in srgb, #2fb8a6 16%, var(--card-bg)); border-color: color-mix(in srgb, #2fb8a6 55%, var(--card-border)); }
.dg-node[data-color="green"] { background: color-mix(in srgb, #5fae6a 16%, var(--card-bg)); border-color: color-mix(in srgb, #5fae6a 55%, var(--card-border)); }
.dg-node[data-color="purple"] { background: color-mix(in srgb, #9b7cd6 16%, var(--card-bg)); border-color: color-mix(in srgb, #9b7cd6 55%, var(--card-border)); }
.dg-node[data-color="rose"] { background: color-mix(in srgb, #d97b93 16%, var(--card-bg)); border-color: color-mix(in srgb, #d97b93 55%, var(--card-border)); }
.dg-node[data-color="aws"] { background: color-mix(in srgb, #FF9900 16%, var(--card-bg)); border-color: color-mix(in srgb, #FF9900 55%, var(--card-border)); }
.dg-node[data-color="gcp"] { background: color-mix(in srgb, #4285F4 16%, var(--card-bg)); border-color: color-mix(in srgb, #4285F4 55%, var(--card-border)); }
.dg-node[data-color="azure"] { background: color-mix(in srgb, #0078D4 16%, var(--card-bg)); border-color: color-mix(in srgb, #0078D4 55%, var(--card-border)); }

.dg-node.selected { border-color: var(--card-label); border-width: 2px; }
.dg-node.drop-target { border-color: var(--card-label); box-shadow: 0 0 0 3px color-mix(in srgb, var(--card-label) 30%, transparent); }
.dg-node-label { outline: none; width: 100%; overflow-wrap: break-word; }
.dg-node-label[contenteditable="true"] { cursor: text; background: color-mix(in srgb, var(--card-label) 8%, transparent); }

.dg-node.container {
  background: color-mix(in srgb, var(--card-bg) 35%, transparent);
  border-style: dashed;
  align-items: flex-start;
  justify-content: flex-start;
  padding: 8px 10px;
}
.dg-node.container .dg-node-label {
  width: auto;
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--card-desc);
}

/* Shape variants -- outline only, ports still sit at the bounding box's N/S/E/W
   midpoints regardless of shape (those happen to land exactly on a diamond's
   own vertices, so connectors need no special-casing there). */
.dg-node[data-shape="rounded"] { border-radius: 12px; }
.dg-node[data-shape="diamond"] { clip-path: polygon(50% 0%, 100% 50%, 50% 100%, 0% 50%); }
.dg-node[data-shape="text"] {
  background: transparent; border-color: transparent; padding: 4px 6px;
}
.dg-node[data-shape="text"]:hover, .dg-node[data-shape="text"].selected, .dg-node[data-shape="text"].drop-target {
  border-color: var(--card-border); border-style: dashed;
}
/* A text node has no background/border to tint (above), so its color swatch
   colors the label text instead. Scoped to [data-shape="text"] only -- a
   colored rect/rounded/diamond node keeps plain body-color text for
   contrast against its own tinted background. */
.dg-node[data-shape="text"][data-color="slate"] { color: color-mix(in srgb, #7c8aa5 70%, var(--headline-color)); }
.dg-node[data-shape="text"][data-color="blue"] { color: color-mix(in srgb, #5b8def 70%, var(--headline-color)); }
.dg-node[data-shape="text"][data-color="teal"] { color: color-mix(in srgb, #2fb8a6 70%, var(--headline-color)); }
.dg-node[data-shape="text"][data-color="green"] { color: color-mix(in srgb, #5fae6a 70%, var(--headline-color)); }
.dg-node[data-shape="text"][data-color="purple"] { color: color-mix(in srgb, #9b7cd6 70%, var(--headline-color)); }
.dg-node[data-shape="text"][data-color="rose"] { color: color-mix(in srgb, #d97b93 70%, var(--headline-color)); }
.dg-node[data-shape="text"][data-color="aws"] { color: color-mix(in srgb, #FF9900 70%, var(--headline-color)); }
.dg-node[data-shape="text"][data-color="gcp"] { color: color-mix(in srgb, #4285F4 70%, var(--headline-color)); }
.dg-node[data-shape="text"][data-color="azure"] { color: color-mix(in srgb, #0078D4 70%, var(--headline-color)); }

.dg-node.has-icon { flex-direction: column; gap: 5px; }
.dg-node-icon-svg {
  width: 22px; height: 22px; flex-shrink: 0; fill: none; stroke: currentColor;
  stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; color: var(--card-desc);
}

.dg-port {
  position: absolute; width: 8px; height: 8px; border-radius: 50%;
  background: var(--card-bg); border: 1px solid var(--card-desc); opacity: 0;
  transform: scale(1); transition: opacity .2s ease, background .2s ease, transform .15s ease;
  cursor: crosshair; touch-action: none;
}
.dg-node:hover .dg-port, .dg-node.selected .dg-port { opacity: 1; }
.dg-port:hover { background: var(--card-label); border-color: var(--card-label); transform: scale(1.6); }
.dg-port-n { top: -4px; left: 50%; margin-left: -4px; }
.dg-port-s { bottom: -4px; left: 50%; margin-left: -4px; }
.dg-port-e { right: -4px; top: 50%; margin-top: -4px; }
.dg-port-w { left: -4px; top: 50%; margin-top: -4px; }

.dg-resize-handle {
  position: absolute; right: -6px; bottom: -6px; width: 11px; height: 11px;
  background: var(--card-bg); border: 1px solid var(--card-desc); opacity: 0; transition: opacity .2s ease, background .2s ease;
  cursor: nwse-resize; touch-action: none;
}
.dg-node:hover .dg-resize-handle, .dg-node.selected .dg-resize-handle { opacity: 1; }
.dg-resize-handle:hover { background: var(--card-label); border-color: var(--card-label); }

.dg-group-box { fill: none; stroke: var(--card-desc); stroke-width: 1; stroke-dasharray: 5 4; pointer-events: none; }

.dg-edge-hit { stroke: transparent; stroke-width: 14; fill: none; pointer-events: stroke; cursor: pointer; }
.dg-edge-line { stroke: var(--card-desc); stroke-width: 1.5; fill: none; pointer-events: none; }
.dg-edge.selected .dg-edge-line { stroke: var(--card-label); stroke-width: 2; }
.dg-edge-temp { stroke: var(--card-label); stroke-width: 1.5; stroke-dasharray: 4 3; fill: none; pointer-events: none; }
.dg-edge-label-bg { fill: var(--card-bg); pointer-events: none; }
.dg-edge-label { font-family: var(--font-mono); font-size: 10px; fill: var(--card-desc); pointer-events: none; }

@keyframes dg-marching-ants { to { stroke-dashoffset: -20; } }
.dg-edge-line.dg-flow-dash { animation: dg-marching-ants 0.6s linear infinite; }
/* Same keyframes, just replayed forward-then-backward each cycle for a back-and-forth feel. */
.dg-edge-line.dg-flow-dash.dg-flow-alt { animation-direction: alternate; }

@keyframes dg-flow-move { from { offset-distance: 0%; } to { offset-distance: 100%; } }
.dg-edge-flow-dot { fill: var(--card-label); pointer-events: none; animation: dg-flow-move 1.6s linear infinite; }
.dg-edge-flow-dot.dg-flow-alt { animation-direction: alternate; }

/* Packet: same offset-path travel as the dot, but offset-rotate is pinned to
   0deg -- unlike an arrowhead, an envelope reads better staying upright than
   tilting to match each edge's angle. */
.dg-edge-flow-packet { pointer-events: none; animation: dg-flow-move 1.8s linear infinite; offset-rotate: 0deg; }
.dg-edge-flow-packet.dg-flow-alt { animation-direction: alternate; }
.dg-edge-flow-packet-body { fill: var(--card-bg); stroke: var(--card-label); stroke-width: 1.4; }
.dg-edge-flow-packet-flap { fill: none; stroke: var(--card-label); stroke-width: 1.2; }

/* Notify: a solid badge plus an expanding, fading ring behind it -- the
   classic two-layer "ping" read as new activity on a node. */
.dg-node-badge { position: absolute; top: -4px; right: -4px; width: 9px; height: 9px; pointer-events: none; }
.dg-node-badge::before, .dg-node-badge::after {
  content: ""; position: absolute; inset: 0; border-radius: 50%; background: var(--tone-bad);
}
.dg-node-badge::after { animation: dg-notify-ping 1.6s cubic-bezier(0, 0, 0.2, 1) infinite; }
@keyframes dg-notify-ping { 0% { transform: scale(1); opacity: 0.7; } 75%, 100% { transform: scale(2.4); opacity: 0; } }

/* Fill: a thin bar along the node's bottom edge that loops fill -> brief
   hold -> reset, the loading-bar read for "this is buffering/filling". */
.dg-node-fillbar {
  position: absolute; left: 4px; right: 4px; bottom: 4px; height: 4px; border-radius: 2px;
  background: color-mix(in srgb, var(--card-border) 70%, transparent); overflow: hidden; pointer-events: none;
}
.dg-node-fillbar-inner { height: 100%; width: 0; background: var(--card-label); animation: dg-fill-loop 2.4s ease-in-out infinite; }
@keyframes dg-fill-loop { 0% { width: 0; } 85%, 100% { width: 100%; } }

/* Spinner: this node is actively processing -- a small rotating ring,
   top-left so it doesn't collide with Notify's top-right badge. */
.dg-node-spinner { position: absolute; top: -4px; left: -4px; width: 14px; height: 14px; pointer-events: none; color: var(--card-label); }
.dg-node-spinner svg { animation: dg-spin 0.9s linear infinite; }
@keyframes dg-spin { to { transform: rotate(360deg); } }

/* Heartbeat: this node is healthy/alive -- a slow, calm glow breathing
   outward, distinct from Notify's sharp one-shot ping. */
.dg-node.dg-anim-heartbeat { animation: dg-heartbeat 2.2s ease-in-out infinite; }
@keyframes dg-heartbeat {
  0%, 100% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--tone-ok) 55%, transparent); }
  50% { box-shadow: 0 0 0 5px color-mix(in srgb, var(--tone-ok) 0%, transparent); }
}

/* Error: this node is down/failing -- a faster, red border pulse. */
.dg-node.dg-anim-error { animation: dg-error-flash 1s ease-in-out infinite; }
@keyframes dg-error-flash {
  0%, 100% { border-color: var(--card-border); }
  50% { border-color: var(--tone-bad); }
}

@media (prefers-reduced-motion: reduce) {
  .dg-edge-line.dg-flow-dash, .dg-edge-flow-dot, .dg-edge-flow-packet,
  .dg-node-badge::after, .dg-node-fillbar-inner, .dg-node-spinner svg,
  .dg-node.dg-anim-heartbeat, .dg-node.dg-anim-error { animation: none; }
}

.dg-edge-input {
  position: absolute; transform: translate(-50%, -50%); z-index: 5;
  font-family: var(--font-mono); font-size: 11px; color: var(--card-label);
  background: var(--card-bg); border: 1px solid var(--card-label); padding: 3px 6px; outline: none; width: 120px;
}

.dg-context-menu {
  /* Fixed, not absolute: it's a sibling of the canvas viewport but must be
     able to draw outside .dg-canvas-wrap's overflow:hidden clip (the
     component picker alone is ~23 rows, taller than the canvas). Fixed
     positioning escapes that clip and is measured straight in viewport
     coordinates, which is what showContextMenu() already receives. */
  position: fixed; z-index: 10; min-width: 140px; max-width: 260px; max-height: calc(100vh - 16px); overflow-y: auto;
  background: var(--card-bg); border: 1px solid var(--card-border); box-shadow: 0 4px 16px color-mix(in srgb, #000 30%, transparent);
  padding: 4px; flex-direction: column;
}
/* [hidden] and .dg-context-menu are equal specificity, so the plain class rule above
   must not set display itself (it would win the cascade tie and stay visible even
   when the hidden attribute is set). Gate display on :not([hidden]) instead. */
.dg-context-menu:not([hidden]) { display: flex; }
.dg-context-menu button {
  font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.05em; text-transform: uppercase;
  color: var(--headline-color); background: transparent; border: 0; text-align: left;
  padding: 7px 10px; cursor: pointer; display: flex; align-items: center; gap: 8px;
}
.dg-menu-icon-svg { width: 14px; height: 14px; flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
.dg-context-menu button:hover { background: color-mix(in srgb, var(--card-label) 12%, transparent); color: var(--card-label); }
.dg-context-menu button.danger { color: var(--tone-bad); }
.dg-context-menu button.danger:hover { background: color-mix(in srgb, var(--tone-bad) 12%, transparent); }
.dg-context-menu hr { width: 100%; border: 0; border-top: 1px solid var(--card-border); margin: 4px 0; }

.dg-color-row { display: flex; gap: 6px; padding: 6px 10px; flex-wrap: wrap; }
.dg-context-menu .dg-swatch {
  width: 18px; height: 18px; padding: 0; border-radius: 50%; border: 1px solid var(--card-border);
  cursor: pointer; background: transparent; transition: transform .12s ease;
}
.dg-context-menu .dg-swatch:hover { transform: scale(1.2); }
.dg-context-menu .dg-swatch-none { position: relative; background: var(--card-bg); }
.dg-context-menu .dg-swatch-none::after {
  content: ""; position: absolute; left: 3px; right: 3px; top: 50%; height: 1px;
  background: var(--tone-bad); transform: rotate(45deg);
}

.dg-style-label { font-family: var(--font-mono); font-size: 9px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--card-desc); opacity: 0.7; padding: 6px 10px 0; }
.dg-style-row { display: flex; gap: 4px; padding: 4px 10px 6px; flex-wrap: wrap; }
.dg-context-menu .dg-style-btn {
  font-family: var(--font-mono); font-size: 10px; letter-spacing: 0.04em; text-transform: uppercase;
  color: var(--card-desc); background: transparent; border: 1px solid var(--card-border);
  padding: 4px 8px; cursor: pointer;
}
.dg-context-menu .dg-style-btn:hover { border-color: var(--card-label); color: var(--headline-color); }
.dg-context-menu .dg-style-btn.active { border-color: var(--card-label); color: var(--card-label); }

.dg-root:fullscreen { background: var(--page-bg); padding: 18px 22px; }
.dg-root:fullscreen .dg-body { --dg-canvas-h: calc(100vh - 130px); }
.dg-root:-webkit-full-screen { background: var(--page-bg); padding: 18px 22px; }
.dg-root:-webkit-full-screen .dg-body { --dg-canvas-h: calc(100vh - 130px); }

.dg-hint { margin-top: 10px; }
