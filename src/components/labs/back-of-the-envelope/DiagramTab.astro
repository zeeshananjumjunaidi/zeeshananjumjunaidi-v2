    edges.forEach(function (ed) {
      if (idMap[ed.from] && idMap[ed.to]) {
        newEdges.push({
          id: uid(), from: idMap[ed.from], to: idMap[ed.to], label: ed.label,
          lineStyle: ed.lineStyle, arrowStyle: ed.arrowStyle, flow: ed.flow,
