---
---

<dialog id="boeMetricDialog" class="boe-export-dialog boe-metric-dialog">
  <div class="boe-export-head">
    <h3>Pin a number</h3>
    <button type="button" class="boe-export-x" id="metricClose" aria-label="Close">&times;</button>
  </div>

  <p class="boe-metric-blurb">
    The value stays live. Change an input on any tab and every node pinned to
    it follows.
  </p>

  <input type="search" id="metricSearch" class="boe-metric-search" placeholder="Search outputs" autocomplete="off" />

  <div id="metricList" class="boe-metric-list"></div>

  <div class="boe-metric-foot">
    <button type="button" class="boe-slot-btn" id="metricClear">Remove from node</button>
  </div>
</dialog>

<!-- Global, matching the other dialogs: the rows are built at open time and
     never carry this component's data-astro-cid attribute. -->
<style is:global>
  .boe-metric-dialog { width: min(620px, calc(100vw - 32px)); }
  .boe-metric-blurb {
    font-family: var(--font-body); font-size: 13px; line-height: 1.6;
    color: var(--card-desc); margin: 0 0 14px;
  }
  .boe-metric-search {
    width: 100%; box-sizing: border-box; font-family: var(--font-mono); font-size: 12.5px;
    color: var(--headline-color); background: transparent;
    border: 1px solid var(--card-border); padding: 8px 10px; margin-bottom: 12px;
  }
  .boe-metric-search:focus { outline: none; border-color: var(--card-label); }

  .boe-metric-list { max-height: min(52vh, 420px); overflow-y: auto; }
  .boe-metric-group-label {
    font-family: var(--font-mono); font-size: 9.5px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--section-meta);
    padding: 12px 0 6px; border-bottom: 1px solid var(--card-border); margin-bottom: 4px;
  }
  .boe-metric-row {
    display: flex; align-items: baseline; gap: 12px; width: 100%;
    background: none; border: 0; border-radius: 0; cursor: pointer; text-align: left;
    padding: 7px 8px; font-family: var(--font-mono); font-size: 12px;
    color: var(--subhead-color);
  }
  .boe-metric-row:hover, .boe-metric-row:focus-visible {
    background: color-mix(in srgb, var(--card-label) 12%, transparent);
    color: var(--headline-color); outline: none;
  }
  .boe-metric-row.current { color: var(--card-label); }
  .boe-metric-row.current .boe-metric-name::before { content: "\2022 "; }
  .boe-metric-name { flex: 1 1 auto; min-width: 0; }
  .boe-metric-val {
    flex: 0 0 auto; color: var(--card-label); font-variant-numeric: tabular-nums;
  }
  .boe-metric-row:hover .boe-metric-val { color: var(--headline-color); }
  .boe-metric-empty {
    font-family: var(--font-mono); font-size: 11.5px; color: var(--card-desc); padding: 16px 8px;
  }
  .boe-metric-foot {
    display: flex; justify-content: flex-end;
    margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--card-border);
  }
</style>
