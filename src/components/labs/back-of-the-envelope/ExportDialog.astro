  <dialog id="boeExportDialog" class="boe-export-dialog">
    <div class="boe-export-head">
      <h3>Export</h3>
      <button type="button" class="boe-export-x" id="exportClose" aria-label="Close">×</button>
    </div>

    <label class="boe-export-field">
      <span class="boe-label">Title</span>
      <input class="boe-inp" type="text" id="exportTitle" placeholder="e.g. Checkout service capacity plan">
    </label>
    <label class="boe-export-field">
      <span class="boe-label">Description</span>
      <textarea class="boe-inp boe-export-textarea" id="exportDescription" rows="3" placeholder="Optional context for whoever reads this"></textarea>
    </label>

    <div class="boe-export-field">
      <span class="boe-label-row">
        <span class="boe-label-text">Include</span>
        <label class="boe-export-check boe-export-check-all">
          <input type="checkbox" id="exportSelectAll" checked>
          All
        </label>
      </span>
      <div class="boe-export-sections" id="exportSections"></div>
    </div>

    <div class="boe-export-formats">
      <button type="button" class="boe-export-format-btn" id="exportYaml">YAML</button>
      <button type="button" class="boe-export-format-btn" id="exportMarkdown">Markdown</button>
      <button type="button" class="boe-export-format-btn" id="exportPdf">PDF</button>
    </div>
  </dialog>

  <div id="boeExportPrint"></div>

  <!--
    Global, not scoped, same reasoning as BackOfTheEnvelopeCalc.astro's own
    style block: #boeExportPrint is rebuilt at export time and (for the
    diagram section) receives a clone of DiagramTab's live #dgViewport, so
    nothing here can rely on this component's own data-astro-cid scoping.
  -->
  <style is:global>
    .boe-export-dialog {
      width: min(480px, calc(100vw - 32px));
      max-height: calc(100vh - 64px); overflow-y: auto;
      background: var(--card-bg); color: var(--headline-color);
      border: 1px solid var(--card-border); padding: 20px 22px;
      font-family: var(--font-body);
    }
    .boe-export-dialog::backdrop { background: color-mix(in srgb, #000 55%, transparent); }
    .boe-export-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .boe-export-head h3 {
      font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase;
      color: var(--card-label); margin: 0;
    }
    .boe-export-x {
      background: transparent; border: 0; color: var(--card-desc); font-size: 20px; line-height: 1;
      cursor: pointer; padding: 2px 6px; transition: color .2s ease;
    }
    .boe-export-x:hover { color: var(--headline-color); }

    .boe-export-field { margin-bottom: 14px; display: block; }
    .boe-export-textarea { resize: vertical; font-family: var(--font-body); }

    .boe-export-sections {
      display: grid; grid-template-columns: 1fr 1fr; gap: 4px 12px;
      border: 1px solid var(--card-border); padding: 10px 12px; margin-top: 6px;
    }
    .boe-export-check, .boe-export-check-all {
      display: flex; align-items: center; gap: 6px;
      font-family: var(--font-mono); font-size: 12px; color: var(--headline-color); cursor: pointer;
    }
    .boe-export-check-all { color: var(--card-desc); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; }
    .boe-export-check input, .boe-export-check-all input { accent-color: var(--card-label); }

    .boe-export-formats { display: flex; gap: 8px; margin-top: 18px; }
    .boe-export-format-btn {
      flex: 1 1 0; font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase;
      color: var(--headline-color); background: transparent; border: 1px solid var(--card-border);
      padding: 10px 8px; cursor: pointer; transition: border-color .2s ease, color .2s ease;
    }
    .boe-export-format-btn:hover { border-color: var(--card-label); color: var(--card-label); }

    /* Hidden in normal browsing; @media print below is the only thing that
       ever reveals it, so no show/hide bookkeeping is needed after printing. */
    #boeExportPrint { display: none; }

    @media print {
      body > * { display: none !important; }
      body > #boeExportPrint {
        display: block !important; position: static !important;
        color: #111; background: #fff; font-family: var(--font-body);
      }
      .boe-print-title { font-size: 22px; margin: 0 0 4px; }
      .boe-print-desc { font-size: 13px; color: #333; margin: 0 0 4px; }
      .boe-print-meta { font-size: 10px; color: #666; margin: 0 0 20px; }
      .boe-print-h2 {
        font-family: var(--font-mono); font-size: 13px; letter-spacing: 0.08em; text-transform: uppercase;
        border-bottom: 1px solid #ccc; padding-bottom: 4px; margin: 22px 0 8px; break-after: avoid;
      }
      .boe-print-h3 { font-size: 12px; color: #444; margin: 12px 0 4px; break-after: avoid; }
      .boe-print-table { width: 100%; border-collapse: collapse; font-size: 11.5px; margin-bottom: 6px; }
      .boe-print-table td { padding: 3px 6px 3px 0; border-bottom: 1px solid #eee; }
      .boe-print-label { color: #555; }
      .boe-print-value { text-align: right; font-family: var(--font-mono); }
      .boe-print-note { font-size: 11px; color: #333; border-left: 2px solid #999; padding-left: 8px; margin: 6px 0; }
      .boe-print-diagram { border: 1px solid #ccc; overflow: hidden; margin-bottom: 10px; }
    }
  </style>
