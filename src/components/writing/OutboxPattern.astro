<script>
  var demo = document.querySelector(".ob-demo");
  var rate = document.getElementById("obRate");
  var dwCv = document.getElementById("obDw");
  var obCv = document.getElementById("obOb");
  var runBtn = document.getElementById("obRun");
  var resetBtn = document.getElementById("obReset");

  if (demo && rate && dwCv && obCv && runBtn && resetBtn) {
    var CELLS = 120;
    var PER_FRAME = 2;
    var EMPTY = 0, OK = 1, HIT = 2;

    var dwTape = new Uint8Array(CELLS);
    var obTape = new Uint8Array(CELLS);
    var head = 0;
    var total = 0, lost = 0, dup = 0;
    var running = true;
    var raf = 0;

    var totalEl = document.getElementById("obTotal");
    var lostEl = document.getElementById("obLost");
    var dupEl = document.getElementById("obDup");
    var rateOut = document.getElementById("obRateOut");

    function token(name, fallback) {
      var v = getComputedStyle(demo).getPropertyValue(name).trim();
      return v || fallback;
    }

    function paint(cv, tape, hitColor) {
      var ctx = cv.getContext("2d");
      var dpr = window.devicePixelRatio || 1;
      var w = cv.clientWidth || 640;
      var h = cv.clientHeight || 30;
      if (cv.width !== Math.round(w * dpr)) {
        cv.width = Math.round(w * dpr);
        cv.height = Math.round(h * dpr);
      }
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, w, h);

      var gap = 1;
      var cw = (w - gap * (CELLS - 1)) / CELLS;
      var ok = token("--ob-ok", "rgba(150,140,120,0.32)");
      var edge = token("--card-border", "#3d2c1e");

      for (var i = 0; i < CELLS; i++) {
        var v = tape[i];
        if (v === EMPTY) continue;
        ctx.fillStyle = v === HIT ? hitColor : ok;
        ctx.fillRect(i * (cw + gap), 0, cw, h);
      }

      // The sweep head, so a paused tape still reads as a position in time.
      ctx.fillStyle = edge;
      ctx.fillRect(head * (cw + gap), 0, cw, h);
    }

    function render() {
      totalEl.textContent = total.toLocaleString();
      lostEl.textContent = lost.toLocaleString();
      dupEl.textContent = dup.toLocaleString();
      paint(dwCv, dwTape, token("--ob-bad", "#d9614f"));
      paint(obCv, obTape, token("--ob-dup", "#e3c069"));
    }

    function step() {
      var p = parseInt(rate.value, 10) / 10000;
      for (var i = 0; i < PER_FRAME; i++) {
        // One draw feeds both tapes: it is the same crash window either way.
        var caught = Math.random() < p;
        dwTape[head] = caught ? HIT : OK;
        obTape[head] = caught ? HIT : OK;
        if (caught) { lost++; dup++; }
        total++;
        head = (head + 1) % CELLS;
        if (head === 0) { dwTape.fill(EMPTY); obTape.fill(EMPTY); }
      }
      render();
      if (running) raf = requestAnimationFrame(step);
    }

    function setRunning(on) {
      running = on;
      runBtn.textContent = on ? "Pause" : "Run";
      cancelAnimationFrame(raf);
      if (on) raf = requestAnimationFrame(step);
    }

    rate.addEventListener("input", function () {
      rateOut.textContent = (parseInt(rate.value, 10) / 100).toFixed(2) + "%";
    });
    runBtn.addEventListener("click", function () { setRunning(!running); });
    resetBtn.addEventListener("click", function () {
      dwTape.fill(EMPTY);
      obTape.fill(EMPTY);
      head = 0; total = 0; lost = 0; dup = 0;
      render();
    });
    window.addEventListener("resize", render);
    new MutationObserver(render).observe(document.documentElement, {
      attributes: true, attributeFilter: ["data-theme", "class"]
    });

    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    render();
    setRunning(!reduce);
  }
</script>
