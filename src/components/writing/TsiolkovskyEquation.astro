    font-family: var(--font-mono) !important; font-size: 11px !important; line-height: 1.7 !important;
    color: var(--card-desc) !important;
    border-top: 1px solid var(--card-border); padding-top: 16px; margin-top: 34px !important;
  }

  @media (max-width: 560px) {
    .tsi-eq { font-size: 17px; }
    .tsi-ctrl { flex-wrap: wrap; }
    .tsi-ctrl label { min-width: 100%; }
  }
</style>

<script>
  // Surface escape velocities, m/s, ascending.
  var BODIES = [
    { n: "Deimos", v: 6 }, { n: "Phobos", v: 11 }, { n: "Enceladus", v: 239 },
    { n: "Vesta", v: 363 }, { n: "Ceres", v: 510 }, { n: "Charon", v: 590 },
    { n: "Pluto", v: 1210 }, { n: "Triton", v: 1455 }, { n: "Europa", v: 2025 },
    { n: "the Moon", v: 2380 }, { n: "Callisto", v: 2440 }, { n: "Io", v: 2558 },
    { n: "Titan", v: 2639 }, { n: "Ganymede", v: 2741 }, { n: "Mercury", v: 4250 },
    { n: "Mars", v: 5030 }, { n: "Venus", v: 10360 }, { n: "Earth", v: 11186 },
    { n: "Uranus", v: 21300 }, { n: "Neptune", v: 23500 }
  ];

  var pf = document.getElementById("tsiPf");
  var ve = document.getElementById("tsiVe");
  var cv = document.getElementById("tsiChart");

  if (pf && ve && cv) {
    var ctx = cv.getContext("2d");
    var Y_MAX = 20000;
    var PAD = { l: 52, r: 10, t: 12, b: 34 };

    function token(name, fallback) {
      var v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      return v || fallback;
    }

    function fit() {
      var dpr = window.devicePixelRatio || 1;
      var w = cv.clientWidth || 640;
      var h = cv.clientHeight || 270;
      cv.width = Math.round(w * dpr);
      cv.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      return { w: w, h: h };
    }

    function draw(vExh, frac, dv) {
      var d = fit();
      var W = d.w, H = d.h;
      var x0 = PAD.l, x1 = W - PAD.r, y0 = H - PAD.b, y1 = PAD.t;
      var muted = token("--card-desc", "#847d74");
      var rule = token("--card-border", "#e0d9cf");
      var curve = token("--card-label", "#b8451f");
      var marker = token("--headline-color", "#1c1a17");

      ctx.clearRect(0, 0, W, H);
      ctx.font = "11px ui-monospace, SFMono-Regular, Menlo, Consolas, monospace";
      ctx.lineWidth = 1;

      var X = function (p) { return x0 + (p / 100) * (x1 - x0); };
      var Y = function (v) { return y0 - Math.min(v, Y_MAX) / Y_MAX * (y0 - y1); };

      ctx.strokeStyle = rule;
      ctx.fillStyle = muted;
      ctx.textAlign = "right";
      ctx.textBaseline = "middle";
      for (var g = 0; g <= 20000; g += 5000) {
        var gy = Y(g);
        ctx.beginPath();
        ctx.moveTo(x0, gy);
        ctx.lineTo(x1, gy);
        ctx.stroke();
        ctx.fillText((g / 1000) + "k", x0 - 8, gy);
      }
      ctx.textAlign = "center";
      ctx.textBaseline = "top";
      for (var p = 0; p <= 100; p += 25) ctx.fillText(p + "%", X(p), y0 + 9);

      ctx.strokeStyle = curve;
      ctx.lineWidth = 2;
      ctx.beginPath();
      for (var i = 1; i <= 98; i++) {
        var f = i / 100;
        var val = vExh * Math.log(1 / (1 - f));
        var px = X(i), py = Y(val);
        if (i === 1) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        if (val >= Y_MAX) break;
      }
      ctx.stroke();

      ctx.fillStyle = marker;
      ctx.beginPath();
      ctx.arc(X(frac * 100), Y(dv), 5, 0, Math.PI * 2);
      ctx.fill();
    }

    function update() {
      var p = parseInt(pf.value, 10);
      var v = parseInt(ve.value, 10);
      var f = p / 100;
      var mr = 1 / (1 - f);
      var dv = v * Math.log(mr);

      document.getElementById("tsiPfOut").textContent = p + "%";
      document.getElementById("tsiVeOut").textContent = v.toLocaleString() + " m/s";
      document.getElementById("tsiMr").textContent = mr.toFixed(2);
      document.getElementById("tsiDv").textContent = Math.round(dv).toLocaleString() + " m/s";
      document.getElementById("tsiSp").textContent = (100 - p) + "%";

      var cleared = null, next = null;
      for (var i = 0; i < BODIES.length; i++) {
        if (dv >= BODIES[i].v) cleared = BODIES[i];
        else { next = BODIES[i]; break; }
      }
      document.getElementById("tsiEsc").textContent = cleared
        ? "escapes " + cleared.n + " (" + cleared.v.toLocaleString() + " m/s)"
        : "escapes nothing listed";
      document.getElementById("tsiNext").textContent = next
        ? "short of " + next.n + " by " + Math.round(next.v - dv).toLocaleString() + " m/s"
        : "escapes every body listed";

      draw(v, f, dv);
    }

    pf.addEventListener("input", update);
    ve.addEventListener("input", update);
    window.addEventListener("resize", update);
    // Canvas paints token colours, so it must repaint on a theme change.
    if (window.matchMedia) {
      var mq = window.matchMedia("(prefers-color-scheme: dark)");
      if (mq.addEventListener) mq.addEventListener("change", update);
    }
    new MutationObserver(update).observe(document.documentElement, {
      attributes: true, attributeFilter: ["data-theme", "class"]
    });
    update();
  }
</script>
