---
import { getCollection } from 'astro:content';
import LabCard from './LabCard.astro';
import RepoListItem from './RepoListItem.astro';
import { skillsTicker } from '../data/skillsTicker';
import { domainLabel } from '../data/domains';

const entries = await getCollection('lab');
const sorted = entries.map((e) => e.data).sort((a, b) => a.order - b.order);

// The Lab is organized two levels deep: a top-level `domain` (Systems Design,
// Robotics, whatever comes next), and within it the existing `featured` cards
// plus `group`-labeled repo lists. A domain's position is the lowest `order`
// among its own entries, so new domains slot in wherever their entries do
// without a second ordering field to keep in sync.
type Entry = (typeof sorted)[number];
const domains: { domain: string; order: number; featured: Entry[]; groups: { label: string; items: Entry[] }[] }[] = [];
for (const entry of sorted) {
  let dom = domains.find((d) => d.domain === entry.domain);
  if (!dom) {
    dom = { domain: entry.domain, order: entry.order, featured: [], groups: [] };
    domains.push(dom);
  } else {
    dom.order = Math.min(dom.order, entry.order);
  }
  if (entry.featured) {
    dom.featured.push(entry);
  } else {
    const label = entry.group ?? '';
    let group = dom.groups.find((g) => g.label === label);
    if (!group) {
      group = { label, items: [] };
      dom.groups.push(group);
    }
    group.items.push(entry);
  }
}
domains.sort((a, b) => a.order - b.order);

// A domain earns the full page width once it has something to fill it:
// more than one card, or any repo list. A domain holding a single card
// shares a row with its neighbour instead of stretching across.
const isWide = (d: (typeof domains)[number]) => d.featured.length > 1 || d.groups.length > 0;

// Long archives collapse behind a disclosure, the same affordance the
// credentials list uses. Threshold rather than a named special case, so
// a short group stays open and any future long one folds automatically.
const COLLAPSE_OVER = 4;

const tickerSeparator = ' &nbsp;·&nbsp; ';
const tickerLine = skillsTicker.join(' · ') + tickerSeparator;
const tickerDoubled = tickerLine + tickerLine;
---
<section id="lab" aria-labelledby="lab-label" style="margin-top:44px;">
  <div class="section-label-row">
    <span class="section-label" id="lab-label">The Lab</span>
    <span class="section-meta">PUBLIC REPOSITORIES &middot; AI-ASSISTED</span>
    <span class="line"></span>
  </div>

  <div class="domain-grid">
  {domains.map((dom) => (
    <div class:list={['domain-block', { wide: isWide(dom) }]}>
      <div class="domain-header">
        <span class="domain-label">{domainLabel(dom.domain)}</span>
      </div>

      {dom.featured.length > 0 && (
        <div class="lab-grid lab-grid-2">
          {dom.featured.map((entry) => (
            <LabCard
              title={entry.title}
              href={entry.href}
              category={entry.category}
              year={entry.year}
              description={entry.description}
              preview={entry.preview}
            />
          ))}
        </div>
      )}

      {dom.groups.map((group) =>
        group.items.length > COLLAPSE_OVER ? (
          <details class="repo-more">
            <summary>
              <span class="chevron">&#9656;</span>
              {group.label ? `${group.label} · ` : ''}{group.items.length} repositories
            </summary>
            <div class="repo-list">
              {group.items.map((entry) => (
                <RepoListItem title={entry.title} href={entry.href} description={entry.description} />
              ))}
            </div>
          </details>
        ) : (
          <>
            {group.label && (
              <div class="repo-list-header">
                <span class="section-meta">{group.label}</span>
              </div>
            )}
            <div class="repo-list">
              {group.items.map((entry) => (
                <RepoListItem title={entry.title} href={entry.href} description={entry.description} />
              ))}
            </div>
          </>
        )
      )}
    </div>
  ))}
  </div>

  <div class="ticker-wrap">
    <div class="ticker-track">
      <span set:html={tickerDoubled} />
      <span set:html={tickerDoubled} />
    </div>
  </div>
</section>
