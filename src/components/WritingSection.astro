---
import { interactiveWriting } from '../data/writing';

const entries = interactiveWriting
  .filter((a) => !a.draft)
  .sort((a, b) => b.publishDate.getTime() - a.publishDate.getTime());

// An article's own `topics` should come from one of these groups, or its chip
// won't match.
const topicGroups = [
  {
    label: 'Robotics & autonomy',
    topics: ['Robotics', 'Perception', 'State Estimation', 'Motion Planning', 'Control Systems', 'Simulation'],
  },
  {
    label: 'Physics & spaceflight',
    topics: ['Physics', 'Orbital Mechanics', 'Propulsion'],
  },
  {
    label: 'Machine learning',
    topics: ['Machine Learning', 'AI Systems Engineering'],
  },
  {
    label: 'Systems & infrastructure',
    topics: ['Distributed Systems', 'Architecture', 'Data & Storage', 'Networking', 'Concurrency'],
  },
  {
    label: 'Running things in production',
    topics: ['Reliability', 'Observability', 'Delivery & Deployment', 'Testing'],
  },
  {
    label: 'Security & trust',
    topics: ['Identity & Trust', 'Application Security', 'Risk & Compliance'],
  },
];

const written = new Set(entries.flatMap((a) => a.topics));
---
<section id="writing" class="section" aria-labelledby="writing-label">
  <h2 class="section-heading" id="writing-label">Writing</h2>
  <div class="writing-block">
    <p>I'm working on a series of articles on the working knowledge I actually use. Some are up, and more topics are listed below.</p>
  </div>

  {entries.length > 0 && (
    <>
      <div class="writing-group-label"><span class="section-meta">Published</span></div>
      <ul class="writing-list">
        {entries.map((entry) => (
          <li class="writing-item">
            <a href={entry.href ?? `/writing/${entry.slug}`}>
              <span class="writing-item-title">
                {entry.title}
                {entry.where && <span class="writing-item-where">{entry.where}</span>}
              </span>
              <span class="writing-item-desc">{entry.description}</span>
            </a>
            {entry.publishDate && (
              <span class="writing-item-date">
                {entry.publishDate.toLocaleDateString('en-GB', { year: 'numeric', month: 'short' })}
              </span>
            )}
          </li>
        ))}
      </ul>
    </>
  )}

  <div class="writing-group-label" style="margin-top:30px;"><span class="section-meta">Topics ahead</span></div>
  <div class="topic-groups">
    {topicGroups.map((group) => (
      <div class="topic-group">
        <span class="topic-group-label">{group.label}</span>
        <div class="tag-row">
          {group.topics.map((topic) => (
            <span
              class:list={['tag', { 'tag-written': written.has(topic) }]}
              title={written.has(topic) ? 'Something written on this' : undefined}
            >{topic}</span>
          ))}
        </div>
      </div>
    ))}
  </div>

</section>

<style>
  .writing-group-label { margin-top: 26px; }
  .topic-groups {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: 20px 30px; margin-top: 16px;
  }
  .topic-group-label {
    display: block; font-family: var(--font-body); font-weight: 300; font-size: 13px;
    color: var(--card-desc); margin-bottom: 9px;
  }
  .topic-group .tag-row { gap: 6px; }

  .writing-list { list-style: none; margin: 22px 0 0; padding: 0; }
  .writing-item {
    display: flex; align-items: baseline; gap: 16px;
    padding: 13px 0; border-top: 1px solid var(--card-border);
  }
  .writing-item:last-child { border-bottom: 1px solid var(--card-border); }
  .writing-item a { flex: 1 1 auto; min-width: 0; text-decoration: none; }
  .writing-item-title {
    display: block; font-family: var(--font-head); font-weight: 400; font-size: 19px;
    color: var(--headline-color); transition: color .3s ease;
  }
  .writing-item a:hover .writing-item-title,
  .writing-item a:focus-visible .writing-item-title { color: var(--card-label); }
  /* Says where the piece actually opens, so a link that leaves the writing
     section for a lab tool is not a surprise. */
  .writing-item-where {
    display: inline-block; margin-left: 9px; vertical-align: 2px;
    font-family: var(--font-mono); font-size: 8.5px; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--card-desc);
    border: 1px solid var(--card-border); border-radius: 999px; padding: 2px 8px;
  }
  .writing-item-desc {
    display: block; margin-top: 5px; max-width: 70ch;
    font-family: var(--font-body); font-weight: 300; font-size: 14.5px; line-height: 1.6;
    color: var(--card-desc);
  }
  .writing-item-date {
    flex: 0 0 auto; font-family: var(--font-mono); font-size: 10px;
    letter-spacing: 0.08em; text-transform: uppercase; color: var(--section-meta);
  }

  /* Needs the fill, not just the colour: --card-label and --tag-text are
     nearly identical in the light theme. */
  .tag-written {
    color: var(--card-label);
    border-color: color-mix(in srgb, var(--card-label) 50%, transparent);
    background: color-mix(in srgb, var(--card-label) 13%, transparent);
  }
</style>
