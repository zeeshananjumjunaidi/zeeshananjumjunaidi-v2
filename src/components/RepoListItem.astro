---
interface Props {
  title: string;
  href: string;
  description?: string;
}

const { title, href, description } = Astro.props;
---
<a class="repo-item" href={href} target="_blank" rel="noopener">
  <span class="repo-name">{title} <span class="arrow">↗</span></span>
  {description && <p class="repo-desc">{description}</p>}
</a>
