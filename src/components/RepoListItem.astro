---
interface Props {
  title: string;
  href: string;
  description?: string;
}

const { title, href, description } = Astro.props;
const isExternal = /^https?:\/\//.test(href);
---
<a class="repo-item" href={href} target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener' : undefined}>
  <span class="repo-name">{title} {isExternal && <span class="arrow">↗</span>}</span>
  {description && <p class="repo-desc">{description}</p>}
</a>
